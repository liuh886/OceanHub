---
import Layout from '../layouts/Layout.astro';
import SubsurfaceVisualizer from '../components/SubsurfaceVisualizer.astro';
import DecisionScoper from '../components/DecisionScoper.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import bgpLogo from '../assets/bgp-logo.png';
import penesonLogo from '../assets/peneson-logo.png';

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;

const focusAreas = await getCollection('focus-areas');
const sortedFocusAreas = focusAreas.sort((a, b) => a.data.order - b.data.order);
const insights = await getCollection('insights');
const sortedInsights = insights
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const focusAreaMetadata: Record<string, {
  icon: string;
  badge: string;
  depthHorizon: string;
  techTags: string[];
  metrics: string;
}> = {
  ccus: {
    icon: 'fa-cloud-arrow-up',
    badge: 'CARBON STORAGE & MRV',
    depthHorizon: '800m – 3,200m Sub-seabed',
    techTags: ['4D DAS Seismic', 'Plume Imaging', 'Wellbore Integrity'],
    metrics: 'Continuous Acoustic Strain Telemetry'
  },
  'marine-ecology': {
    icon: 'fa-leaf',
    badge: 'ENVIRONMENTAL INTELLIGENCE',
    depthHorizon: 'Full Water Column & Benthos',
    techTags: ['PAM Acoustics', 'eDNA Sequencing', 'Habitat Mapping'],
    metrics: 'Real-time Marine Mammal Detection'
  },
  'offshore-energy': {
    icon: 'fa-wind',
    badge: 'SITE CHARACTERISATION',
    depthHorizon: '0m – 120m Seabed Penetration',
    techTags: ['Deep CPTu In-Situ', 'UHR 3D Seismic', 'FLS/ULS Ground Model'],
    metrics: 'Integrated Soil-Structure Interaction'
  },
  'offshore-infrastructure': {
    icon: 'fa-anchor',
    badge: 'ASSET & ROUTE INTEGRITY',
    depthHorizon: 'Seabed Surface & Trench Horizon',
    techTags: ['Autonomous USV', 'Sub-bottom Profiler', 'Free-span & Scour'],
    metrics: 'Millimeter-scale Pipeline Deformation'
  }
};
---

<Layout
  title="OceanHub | Marine Intelligence for Offshore Decisions"
  description="OceanHub connects offshore operators, marine geophysics, geotechnical specialists and environmental teams around decision-ready ground evidence."
>
  <!-- Hero Section -->
  <section class="relative min-h-[92vh] flex items-center overflow-hidden pt-12 pb-24 md:py-32">
    <div class="max-w-[1760px] mx-auto px-6 sm:px-8 md:px-12 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Hero Left: Mission Statement & Actions -->
        <div class="lg:col-span-7 reveal">
          <div class="flex flex-wrap items-center gap-3 mb-8">
            <div class="hud-badge">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
              </span>
              <span>LIVE OFFSHORE EVIDENCE NETWORK</span>
            </div>
            <span class="depth-badge">
              <i class="fa-solid fa-water text-[9px]" aria-hidden="true"></i> SEABED TO CLOUD
            </span>
          </div>

          <h1 class="heading-hero mb-8">
            Marine intelligence<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-500 glow-text-cyan">
              for offshore decisions.
            </span>
          </h1>

          <p class="text-lg md:text-2xl text-slate-300 mb-10 leading-relaxed font-light max-w-3xl">
            OceanHub bridges operators, marine geophysical fleets, geotechnical specialists, and environmental observers to assemble the evidence needed to plan, license, build, and de-risk complex offshore assets.
          </p>

          <div class="flex flex-wrap gap-4 items-center mb-12">
            <a href={url('#focus-areas')} class="px-8 py-4 rounded-2xl bg-gradient-to-r from-cyan-400 via-sky-400 to-blue-600 hover:from-cyan-300 hover:to-blue-500 text-slate-950 font-black uppercase tracking-[0.14em] text-xs transition-all shadow-[0_0_30px_rgba(0,240,255,0.3)] hover:shadow-[0_0_45px_rgba(0,240,255,0.5)] flex items-center gap-3 group active:scale-95">
              <span>Explore Focus Areas</span>
              <i class="fa-solid fa-arrow-down text-xs transition-transform group-hover:translate-y-1" aria-hidden="true"></i>
            </a>

            <a href="mailto:info@oceanhub.com" class="px-8 py-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/15 hover:border-cyan-400/50 text-white font-bold uppercase tracking-[0.14em] text-xs transition-all flex items-center gap-2.5 backdrop-blur-md active:scale-95">
              <span>Propose Collaboration</span>
              <i class="fa-solid fa-arrow-right text-[10px] text-cyan-400" aria-hidden="true"></i>
            </a>

            <a href={url('insights/')} class="px-5 py-4 rounded-2xl text-slate-400 hover:text-cyan-300 font-mono text-xs uppercase tracking-wider flex items-center gap-2 transition-colors">
              <i class="fa-solid fa-book-open text-xs text-cyan-400" aria-hidden="true"></i>
              <span>Latest Intelligence</span>
            </a>
          </div>

          <!-- Quick Telemetry Stats Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-8 border-t border-white/10">
            <div>
              <div class="text-2xl lg:text-3xl font-black text-white font-display">4</div>
              <div class="text-[11px] font-mono text-cyan-300/80 uppercase tracking-wider mt-1">Core Disciplines</div>
            </div>
            <div>
              <div class="text-2xl lg:text-3xl font-black text-white font-display">100%</div>
              <div class="text-[11px] font-mono text-cyan-300/80 uppercase tracking-wider mt-1">Ground Rigour</div>
            </div>
            <div>
              <div class="text-2xl lg:text-3xl font-black text-white font-display">3D/4D</div>
              <div class="text-[11px] font-mono text-cyan-300/80 uppercase tracking-wider mt-1">DAS & Seismic MRV</div>
            </div>
            <div>
              <div class="text-2xl lg:text-3xl font-black text-emerald-400 font-display">Active</div>
              <div class="text-[11px] font-mono text-emerald-300/80 uppercase tracking-wider mt-1">Ecosystem Grid</div>
            </div>
          </div>
        </div>

        <!-- Hero Right: Interactive Marine Telemetry Console HUD -->
        <div class="lg:col-span-5 reveal" style="transition-delay: 150ms;">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-cyan-500/25 relative overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.6)]">
            <!-- HUD Header -->
            <div class="flex items-center justify-between pb-5 border-b border-white/10">
              <div class="flex items-center gap-2.5">
                <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
                <span class="text-xs font-mono font-bold text-cyan-300 uppercase tracking-[0.2em]">Ocean Telemetry Matrix</span>
              </div>
              <span class="text-[10px] font-mono px-2.5 py-1 rounded bg-cyan-950/80 border border-cyan-500/30 text-cyan-300">
                LIVE DEMO
              </span>
            </div>

            <!-- Interactive Channel Selector Tabs -->
            <div class="flex gap-2 py-4 border-b border-white/10 overflow-x-auto" id="hud-channel-tabs">
              <button class="hud-tab active px-3 py-1.5 rounded-lg text-[11px] font-mono font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 transition-all" data-channel="0">
                CH 01: SEISMIC
              </button>
              <button class="hud-tab px-3 py-1.5 rounded-lg text-[11px] font-mono font-medium text-slate-400 hover:text-white border border-transparent hover:border-white/10 transition-all" data-channel="1">
                CH 02: GEOTECH
              </button>
              <button class="hud-tab px-3 py-1.5 rounded-lg text-[11px] font-mono font-medium text-slate-400 hover:text-white border border-transparent hover:border-white/10 transition-all" data-channel="2">
                CH 03: CCUS 4D
              </button>
              <button class="hud-tab px-3 py-1.5 rounded-lg text-[11px] font-mono font-medium text-slate-400 hover:text-white border border-transparent hover:border-white/10 transition-all" data-channel="3">
                CH 04: ECOLOGY
              </button>
            </div>

            <!-- Dynamic Telemetry Screen -->
            <div class="py-6 min-h-[220px]" id="hud-channel-content">
              <!-- Channel 0 Content (Default: Seismic) -->
              <div class="hud-pane" id="pane-0">
                <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-3">
                  <span class="text-cyan-300 font-bold">Ultra-High-Resolution 3D Seismic</span>
                  <span>Horizon: 0 - 800m</span>
                </div>
                <div class="h-20 w-full bg-slate-950/80 rounded-xl border border-cyan-500/20 p-3 mb-4 flex items-center justify-center relative overflow-hidden">
                  <!-- Simulated Seismic Waveform SVG -->
                  <svg class="w-full h-12 text-cyan-400 opacity-80" viewBox="0 0 300 40" preserveAspectRatio="none">
                    <path d="M0 20 Q 25 5, 50 20 T 100 20 T 150 5 T 200 35 T 250 20 T 300 20" fill="none" stroke="currentColor" stroke-width="2" />
                    <path d="M0 20 Q 30 35, 60 20 T 120 10 T 180 30 T 240 15 T 300 20" fill="none" stroke="#0EA5E9" stroke-width="1.5" stroke-dasharray="2,2" />
                  </svg>
                  <div class="absolute right-3 top-2 text-[10px] font-mono text-emerald-400">GEOHAZARD: CLEAR</div>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed font-light">
                  Detects shallow gas pockets, paleo-channels, boulder fields, and fault displacements prior to foundation piling.
                </p>
              </div>

              <!-- Channel 1 Content (Geotech) -->
              <div class="hud-pane hidden" id="pane-1">
                <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-3">
                  <span class="text-sky-300 font-bold">Deepwater In-Situ CPTu Telemetry</span>
                  <span>Penetration: 0 - 120m</span>
                </div>
                <div class="h-20 w-full bg-slate-950/80 rounded-xl border border-sky-500/20 p-3 mb-4 flex items-center justify-around relative">
                  <div class="text-center">
                    <div class="text-xs font-mono text-slate-500">Tip Res (qc)</div>
                    <div class="text-base font-mono font-bold text-sky-400">42.8 MPa</div>
                  </div>
                  <div class="w-px h-10 bg-white/10"></div>
                  <div class="text-center">
                    <div class="text-xs font-mono text-slate-500">Sleeve Fric (fs)</div>
                    <div class="text-base font-mono font-bold text-sky-400">185 kPa</div>
                  </div>
                  <div class="w-px h-10 bg-white/10"></div>
                  <div class="text-center">
                    <div class="text-xs font-mono text-slate-500">Pore Press (u2)</div>
                    <div class="text-base font-mono font-bold text-emerald-400">3.4 MPa</div>
                  </div>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed font-light">
                  High-precision seabed soil strength characterisation directly informing wind monopile and jacket foundation fatigue limits.
                </p>
              </div>

              <!-- Channel 2 Content (CCUS) -->
              <div class="hud-pane hidden" id="pane-2">
                <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-3">
                  <span class="text-cyan-300 font-bold">4D DAS Fiber Plume Monitoring</span>
                  <span>Depth: 1,800m Reservoir</span>
                </div>
                <div class="h-20 w-full bg-slate-950/80 rounded-xl border border-cyan-500/20 p-3 mb-4 flex items-center justify-between relative px-4">
                  <div>
                    <div class="text-[10px] font-mono text-slate-400">CO₂ PLUME INTEGRITY</div>
                    <div class="text-sm font-mono font-bold text-emerald-400 flex items-center gap-1.5 mt-0.5">
                      <i class="fa-solid fa-circle-check text-xs"></i> 100% CONTAINED
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="text-[10px] font-mono text-slate-400">STRAIN VARIATION</div>
                    <div class="text-sm font-mono font-bold text-cyan-300 mt-0.5">±0.02 με</div>
                  </div>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed font-light">
                  Continuous acoustic strain telemetry along optic fibers verifying zero caprock leakage and stable plume migration.
                </p>
              </div>

              <!-- Channel 3 Content (Ecology) -->
              <div class="hud-pane hidden" id="pane-3">
                <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-3">
                  <span class="text-emerald-300 font-bold">Passive Acoustic Monitoring (PAM)</span>
                  <span>Bandwidth: 10Hz - 160kHz</span>
                </div>
                <div class="h-20 w-full bg-slate-950/80 rounded-xl border border-emerald-500/20 p-3 mb-4 flex items-center justify-between px-4 relative">
                  <div>
                    <div class="text-[10px] font-mono text-slate-400">CETACEAN VOCALISATION</div>
                    <div class="text-sm font-mono font-bold text-cyan-400 mt-0.5">Odontocete Clicks (85kHz)</div>
                  </div>
                  <div class="text-right">
                    <div class="text-[10px] font-mono text-slate-400">EXCLUSION ZONE</div>
                    <div class="text-sm font-mono font-bold text-emerald-400 mt-0.5">CLEAR (5.2 km)</div>
                  </div>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed font-light">
                  Continuous marine mammal acoustic protection and environmental baseline tracking to support regulatory licensing.
                </p>
              </div>
            </div>

            <!-- HUD Bottom Disciplines Badges -->
            <div class="pt-5 border-t border-white/10 flex flex-wrap gap-2">
              <span class="evidence-chip">GEOPHYSICS</span>
              <span class="evidence-chip">GEOTECHNICS</span>
              <span class="evidence-chip">ENVIRONMENT</span>
              <span class="evidence-chip">MONITORING</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Decision-to-Evidence Pipeline Flow Section -->
  <section class="py-24 md:py-32 bg-[#030712]/90 border-y border-cyan-500/15 relative overflow-hidden">
    <div class="max-w-[1760px] mx-auto px-6 sm:px-8 md:px-12 relative z-10">
      <div class="max-w-3xl mb-16 reveal">
        <div class="hud-badge mb-4">
          <i class="fa-solid fa-diagram-project" aria-hidden="true"></i> THE COLLABORATION ARCHITECTURE
        </div>
        <h2 class="heading-section">From field observation to engineering decision</h2>
        <p class="text-lg md:text-xl text-slate-300 font-light leading-relaxed">
          OceanHub is not a generic service directory. It is an engineering collaboration protocol that synthesizes fragmented observations into high-integrity decisions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="glass-card-interactive p-8 md:p-10 rounded-3xl reveal">
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest">PHASE 01</span>
            <span class="w-8 h-8 rounded-xl bg-cyan-500/10 flex items-center justify-center text-cyan-300 font-mono text-xs font-bold">01</span>
          </div>
          <h3 class="text-2xl font-bold text-white font-display mb-4">Frame the Decision</h3>
          <p class="text-sm md:text-base text-slate-300 font-light leading-relaxed mb-6">
            Define the engineering, environmental, or regulatory hurdle before selecting sensors. Clarify the risk tolerance, required depth horizons, and regulatory milestones.
          </p>
          <div class="pt-4 border-t border-white/10 flex flex-wrap gap-2 text-[11px] font-mono text-cyan-300/80">
            <span>• Site Feasibility</span>
            <span>• Geohazard Scoping</span>
            <span>• Regulatory Bounds</span>
          </div>
        </div>

        <div class="glass-card-interactive p-8 md:p-10 rounded-3xl reveal" style="transition-delay: 100ms;">
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest">PHASE 02</span>
            <span class="w-8 h-8 rounded-xl bg-sky-500/10 flex items-center justify-center text-sky-300 font-mono text-xs font-bold">02</span>
          </div>
          <h3 class="text-2xl font-bold text-white font-display mb-4">Connect Evidence Chain</h3>
          <p class="text-sm md:text-base text-slate-300 font-light leading-relaxed mb-6">
            Fuse multi-beam bathymetry, ultra-high-resolution 3D seismic, deep CPTu in-situ tests, and acoustic hydrophone data into a unified, cross-validated ground model.
          </p>
          <div class="pt-4 border-t border-white/10 flex flex-wrap gap-2 text-[11px] font-mono text-sky-300/80">
            <span>• Seismic-to-Well Tie</span>
            <span>• Soil Stratigraphy</span>
            <span>• Noise Attenuation</span>
          </div>
        </div>

        <div class="glass-card-interactive p-8 md:p-10 rounded-3xl reveal" style="transition-delay: 200ms;">
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-mono font-bold text-emerald-400 uppercase tracking-widest">PHASE 03</span>
            <span class="w-8 h-8 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-300 font-mono text-xs font-bold">03</span>
          </div>
          <h3 class="text-2xl font-bold text-white font-display mb-4">Deliver Verified Outputs</h3>
          <p class="text-sm md:text-base text-slate-300 font-light leading-relaxed mb-6">
            Generate decision-ready evidence packets with full provenance, quantified uncertainty bounds, and audit-ready telemetry for project teams and regulators.
          </p>
          <div class="pt-4 border-t border-white/10 flex flex-wrap gap-2 text-[11px] font-mono text-emerald-300/80">
            <span>• Foundation Design Base</span>
            <span>• Plume MRV Report</span>
            <span>• EIA Compliance</span>
          </div>
        </div>
      </div>

      <!-- Interactive Subsurface & Full-Depth Cross-Section Component -->
      <div class="mt-16 reveal">
        <SubsurfaceVisualizer />
      </div>
    </div>
  </section>

  <!-- Strategic Focus Areas Section -->
  <section id="focus-areas" class="section-padding relative scroll-mt-20">
    <div class="max-w-[1760px] mx-auto px-6 sm:px-8 md:px-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8 reveal">
        <div class="max-w-3xl">
          <div class="hud-badge mb-4">
            <i class="fa-solid fa-cubes" aria-hidden="true"></i> STRATEGIC DOMAINS
          </div>
          <h2 class="heading-section">Four connected offshore problem spaces</h2>
          <p class="text-lg md:text-xl text-slate-300 font-light leading-relaxed">
            Each focus area starts with a high-stakes offshore decision, specifies the necessary multidisciplinary observations, and mobilizes specialized capability.
          </p>
        </div>
        <a href={url('focus-areas/')} class="inline-flex items-center gap-3 px-6 py-3.5 rounded-xl bg-white/5 hover:bg-cyan-500/15 border border-white/10 hover:border-cyan-400/40 text-xs font-mono font-bold uppercase tracking-wider text-slate-200 hover:text-cyan-300 transition-all shrink-0">
          <span>Browse All Domains</span>
          <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8">
        {sortedFocusAreas.map((area, index) => {
          const meta = focusAreaMetadata[area.id] || {
            icon: 'fa-anchor',
            badge: 'OFFSHORE',
            depthHorizon: 'Sub-surface & Seabed',
            techTags: ['Marine Survey', 'Data Fusion'],
            metrics: 'Decision-ready Evidence'
          };
          return (
            <article class="glass-card p-8 h-full flex flex-col justify-between group relative overflow-hidden reveal" style={`transition-delay: ${index * 80}ms`}>
              <div>
                <!-- Card Header -->
                <div class="flex items-center justify-between mb-6">
                  <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-500/20 to-blue-600/30 border border-cyan-400/30 flex items-center justify-center text-cyan-300 group-hover:bg-cyan-400 group-hover:text-slate-950 transition-all duration-300 shadow-md">
                    <i class={`fa-solid ${meta.icon} text-xl`} aria-hidden="true"></i>
                  </div>
                  <span class="hud-badge text-[10px]">{meta.badge}</span>
                </div>

                <!-- Depth Indicator -->
                <div class="flex items-center gap-2 mb-4 text-[11px] font-mono text-sky-400">
                  <i class="fa-solid fa-arrows-up-down text-[10px]" aria-hidden="true"></i>
                  <span>{meta.depthHorizon}</span>
                </div>

                <h3 class="text-2xl font-black text-white mb-4 tracking-tight group-hover:text-cyan-300 transition-colors font-display">
                  {area.data.title}
                </h3>
                
                <p class="text-sm text-slate-300 mb-6 font-light leading-relaxed">
                  {area.data.description}
                </p>

                <!-- Technical Capabilities Tags -->
                <div class="flex flex-wrap gap-1.5 mb-8">
                  {meta.techTags.map((tag) => (
                    <span class="sensor-chip">{tag}</span>
                  ))}
                </div>
              </div>

              <!-- Card Footer Action -->
              <div class="pt-5 border-t border-white/10 flex items-center justify-between">
                <a href={url(`focus-areas/${area.id}/`)} class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-cyan-400 hover:text-cyan-300 group-hover:translate-x-1 transition-all">
                  <span>View Problem & Approach</span>
                  <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Interactive Project Navigator & Capability Matrix -->
  <section class="py-20 md:py-28 bg-[#03060E]/80 border-y border-cyan-500/15 relative">
    <div class="max-w-[1760px] mx-auto px-6 sm:px-8 md:px-12">
      <div class="text-center max-w-3xl mx-auto mb-14 reveal">
        <div class="hud-badge mb-4">
          <i class="fa-solid fa-compass-drafting" aria-hidden="true"></i> CAPABILITY MATRIX
        </div>
        <h2 class="heading-section">Tailored to your project lifecycle stage</h2>
        <p class="text-lg text-slate-300 font-light leading-relaxed">
          Filter by operational phase to see how OceanHub disciplines assemble around your specific milestone.
        </p>
      </div>

      <!-- Lifecycle Stage Filter Pills -->
      <div class="flex flex-wrap justify-center gap-3 mb-12 reveal" id="stage-filter-pills">
        <button class="stage-pill active px-5 py-2.5 rounded-xl font-mono text-xs font-bold uppercase tracking-wider bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 transition-all" data-stage="all">
          All Stages
        </button>
        <button class="stage-pill px-5 py-2.5 rounded-xl font-mono text-xs font-bold uppercase tracking-wider bg-white/5 text-slate-400 hover:text-white border border-white/10 hover:border-cyan-500/30 transition-all" data-stage="feasibility">
          01. Feasibility & Scoping
        </button>
        <button class="stage-pill px-5 py-2.5 rounded-xl font-mono text-xs font-bold uppercase tracking-wider bg-white/5 text-slate-400 hover:text-white border border-white/10 hover:border-cyan-500/30 transition-all" data-stage="prefeed">
          02. Pre-FEED & Characterisation
        </button>
        <button class="stage-pill px-5 py-2.5 rounded-xl font-mono text-xs font-bold uppercase tracking-wider bg-white/5 text-slate-400 hover:text-white border border-white/10 hover:border-cyan-500/30 transition-all" data-stage="installation">
          03. Installation & Construction
        </button>
        <button class="stage-pill px-5 py-2.5 rounded-xl font-mono text-xs font-bold uppercase tracking-wider bg-white/5 text-slate-400 hover:text-white border border-white/10 hover:border-cyan-500/30 transition-all" data-stage="monitoring">
          04. Operations & 4D Monitoring
        </button>
      </div>

      <!-- Matrix Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" id="stage-cards-grid">
        <div class="glass-card p-6 stage-card" data-stages="all feasibility prefeed">
          <div class="text-[11px] font-mono text-cyan-400 font-bold mb-2">GEOPHYSICAL RECON</div>
          <h4 class="text-lg font-bold text-white font-display mb-2">Multi-beam Bathymetry & 2D/3D Seismic</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            Identifies seabed morphological constraints, fault escarpments, shallow gas hazards, and optimal corridor routing.
          </p>
        </div>

        <div class="glass-card p-6 stage-card" data-stages="all prefeed installation">
          <div class="text-[11px] font-mono text-sky-400 font-bold mb-2">GEOTECHNICAL GROUND TRUTH</div>
          <h4 class="text-lg font-bold text-white font-display mb-2">Deep In-Situ CPTu & Soil Sampling</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            Direct measurements of soil strength parameters, friction angles, and cyclic degradation for foundation design.
          </p>
        </div>

        <div class="glass-card p-6 stage-card" data-stages="all feasibility monitoring">
          <div class="text-[11px] font-mono text-emerald-400 font-bold mb-2">ENVIRONMENTAL BASELINE</div>
          <h4 class="text-lg font-bold text-white font-display mb-2">Acoustic & Ecological Baseline (PAM)</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            Continuous passive listening and water sampling to establish noise criteria and satisfy consenting authorities.
          </p>
        </div>

        <div class="glass-card p-6 stage-card" data-stages="all monitoring">
          <div class="text-[11px] font-mono text-indigo-400 font-bold mb-2">LONG-TERM MRV</div>
          <h4 class="text-lg font-bold text-white font-display mb-2">4D Fiber DAS & Autonomous USVs</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            Real-time subsurface deformation tracking and autonomous surface vessel patrols for permanent asset integrity.
          </p>
        </div>
      </div>

      <!-- Interactive Decision Scoping Engine Component -->
      <div class="mt-16 reveal">
        <DecisionScoper />
      </div>
    </div>
  </section>

  <!-- Marine Intelligence (Insights) Section -->
  {sortedInsights.length > 0 && (
    <section id="insights" class="section-padding relative scroll-mt-20">
      <div class="max-w-[1760px] mx-auto px-6 sm:px-8 md:px-12">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8 reveal">
          <div class="max-w-3xl">
            <div class="hud-badge mb-4">
              <i class="fa-solid fa-book-open" aria-hidden="true"></i> MARINE INTELLIGENCE
            </div>
            <h2 class="heading-section">Technical context for better offshore choices</h2>
            <p class="text-lg md:text-xl text-slate-300 font-light leading-relaxed">
              In-depth research notes on monitoring regimes, site characterisation breakthroughs, and multidisciplinary evidence assembly.
            </p>
          </div>
          <a href={url('insights/')} class="inline-flex items-center gap-3 px-6 py-3.5 rounded-xl bg-white/5 hover:bg-cyan-500/15 border border-white/10 hover:border-cyan-400/40 text-xs font-mono font-bold uppercase tracking-wider text-slate-200 hover:text-cyan-300 transition-all shrink-0">
            <span>Browse All Intelligence</span>
            <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
          {sortedInsights.map((insight, index) => (
            <article class="glass-card p-8 h-full flex flex-col justify-between group reveal" style={`transition-delay: ${index * 100}ms`}>
              <div>
                <div class="flex flex-wrap items-center gap-3 mb-5">
                  <time datetime={insight.data.publishDate.toISOString()} class="text-xs font-mono text-cyan-400">
                    {insight.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                  {insight.data.tags.slice(0, 2).map((tag) => <span class="evidence-chip">{tag}</span>)}
                </div>
                
                <h3 class="text-2xl font-black leading-tight text-white group-hover:text-cyan-300 transition-colors mb-4 font-display">
                  <a href={url(`insights/${insight.id}/`)}>{insight.data.title}</a>
                </h3>
                
                <p class="text-slate-300 text-sm leading-relaxed mb-8 font-light">
                  {insight.data.description}
                </p>
              </div>

              <div class="flex items-center justify-between pt-5 border-t border-white/10">
                <span class="text-xs font-mono text-slate-400">{insight.data.author}</span>
                <a href={url(`insights/${insight.id}/`)} class="text-xs font-mono font-bold text-cyan-400 hover:text-cyan-300 flex items-center gap-2 group-hover:translate-x-1 transition-transform">
                  <span>Read Brief</span>
                  <i class="fa-solid fa-chevron-right text-[10px]" aria-hidden="true"></i>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Founding Network & Ecosystem Collaboration Center -->
  <section class="section-padding bg-[#03060E]/90 border-y border-cyan-500/15 relative">
    <div class="max-w-[1560px] mx-auto px-6 sm:px-8 md:px-12">
      <div class="text-center max-w-3xl mx-auto mb-16 reveal">
        <div class="hud-badge mb-4">
          <i class="fa-solid fa-handshake" aria-hidden="true"></i> FOUNDING NETWORK
        </div>
        <h2 class="heading-section">Complementary capability, open ecosystem</h2>
        <p class="text-lg text-slate-300 font-light leading-relaxed">
          The founding network brings together large-scale marine geophysical delivery with specialist offshore geotechnical capability, remaining open to operators, researchers, and technology providers worldwide.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 reveal">
        <!-- BGP Card -->
        <div class="glass-card p-8 md:p-10 text-center flex flex-col items-center justify-between group">
          <div class="w-full flex justify-center py-6">
            <Image src={bgpLogo} alt="BGP Offshore" width={240} class="brightness-0 invert opacity-80 group-hover:opacity-100 transition-opacity w-52" />
          </div>
          <div class="w-full pt-5 border-t border-white/10 space-y-2">
            <div class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest">Marine Geophysics</div>
            <p class="text-xs text-slate-400">Global fleet with high-end 3D/4D seismic and high-resolution imaging capability.</p>
          </div>
        </div>

        <!-- Peneson Card -->
        <div class="glass-card p-8 md:p-10 text-center flex flex-col items-center justify-between group">
          <div class="w-full flex justify-center py-6">
            <Image src={penesonLogo} alt="Guangzhou Peneson" width={240} class="brightness-0 invert opacity-80 group-hover:opacity-100 transition-opacity w-52" />
          </div>
          <div class="w-full pt-5 border-t border-white/10 space-y-2">
            <div class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest">Marine Geotechnics</div>
            <p class="text-xs text-slate-400">Specialist deepwater seabed CPTu in-situ testing, seabed sampling, and laboratory analysis.</p>
          </div>
        </div>

        <!-- Join Network Card -->
        <div class="glass-card p-8 md:p-10 text-center flex flex-col items-center justify-center border-dashed border-cyan-500/40 bg-gradient-to-b from-cyan-950/20 to-transparent">
          <div class="w-14 h-14 rounded-2xl bg-cyan-500/10 border border-cyan-400/30 flex items-center justify-center text-cyan-300 mb-5">
            <i class="fa-solid fa-plus text-xl" aria-hidden="true"></i>
          </div>
          <h3 class="text-2xl font-bold text-white font-display mb-2">Join the Network</h3>
          <p class="text-xs sm:text-sm text-slate-300 mb-6 font-light leading-relaxed">
            Bring a novel sensor technology, field dataset, or offshore use case to the collaborative platform.
          </p>
          <a href="mailto:info@oceanhub.com" class="px-6 py-3 rounded-xl bg-cyan-500/15 hover:bg-cyan-500/25 border border-cyan-400/40 text-xs font-mono font-bold text-cyan-200 hover:text-white uppercase tracking-wider transition-all">
            Propose a Collaboration →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final Call to Action Hero -->
  <section class="section-padding relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-to-r from-cyan-500/15 via-blue-600/10 to-transparent rounded-full blur-[160px] pointer-events-none"></div>
    
    <div class="max-w-4xl mx-auto px-6 text-center relative z-10 reveal">
      <div class="hud-badge mb-6">
        <i class="fa-solid fa-compass" aria-hidden="true"></i> START WITH THE DECISION
      </div>
      <h2 class="text-4xl sm:text-6xl md:text-7xl font-black text-white tracking-tight mb-8 font-display">
        Bring us the offshore question.
      </h2>
      <p class="text-lg md:text-2xl text-slate-300 mb-10 font-light leading-relaxed max-w-2xl mx-auto">
        OceanHub will help frame the evidence need, assemble specialized multidisciplinary capability, and de-risk your offshore decision.
      </p>
      
      <div class="flex flex-wrap justify-center gap-4">
        <a href="mailto:info@oceanhub.com" class="px-9 py-4 rounded-2xl bg-gradient-to-r from-cyan-400 via-sky-400 to-blue-600 hover:from-cyan-300 hover:to-blue-500 text-slate-950 font-black uppercase tracking-wider text-xs transition-all shadow-[0_0_35px_rgba(0,240,255,0.35)] hover:scale-105 active:scale-95">
          Propose a Collaboration
        </a>
        <a href={url('about/')} class="px-9 py-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/15 hover:border-cyan-400/40 text-white font-bold uppercase tracking-wider text-xs transition-all backdrop-blur-md">
          How OceanHub Works
        </a>
      </div>
    </div>
  </section>

  <!-- Client-side Interactive HUD & Matrix Controller -->
  <script>
    // 1. Interactive HUD Channel Switcher
    const tabs = document.querySelectorAll('.hud-tab');
    const panes = document.querySelectorAll('.hud-pane');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const channel = tab.getAttribute('data-channel');
        tabs.forEach((t) => {
          t.classList.remove('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-400/40');
          t.classList.add('text-slate-400', 'border-transparent');
        });
        tab.classList.add('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-400/40');
        tab.classList.remove('text-slate-400', 'border-transparent');

        panes.forEach((pane) => {
          pane.classList.add('hidden');
        });
        const activePane = document.getElementById(`pane-${channel}`);
        activePane?.classList.remove('hidden');
      });
    });

    // 2. Interactive Stage Filter Pills
    const stagePills = document.querySelectorAll('.stage-pill');
    const stageCards = document.querySelectorAll('.stage-card');

    stagePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const stage = pill.getAttribute('data-stage');
        stagePills.forEach((p) => {
          p.classList.remove('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-400/40');
          p.classList.add('text-slate-400', 'border-white/10', 'bg-white/5');
        });
        pill.classList.add('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-400/40');
        pill.classList.remove('text-slate-400', 'border-white/10', 'bg-white/5');

        stageCards.forEach((card) => {
          const cardStages = card.getAttribute('data-stages') || '';
          if (stage === 'all' || cardStages.includes(stage || '')) {
            card.classList.remove('hidden', 'opacity-30');
            card.classList.add('opacity-100');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  </script>
</Layout>
