---
import Layout from '../layouts/Layout.astro';
import { resolveCapabilities } from '../data/capabilities';
import { proposedJips } from '../data/proposedJips';
import { getEvidencePlan } from '../lib/matchEvidencePlan';

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
const example = getEvidencePlan({ projectArchetype: 'offshore-ccs', lifecycleStage: 'pre-feed' })[0];
const jipViews = proposedJips.map((jip) => ({ ...jip, capabilities: resolveCapabilities(jip.capabilityIds) }));
---

<Layout title="OceanHub | Offshore Decision Intelligence" description="OceanHub turns offshore project decisions into traceable evidence plans, capability needs and collaboration paths grounded in real engineering precedents.">
  <section class="flex min-h-[78vh] items-center border-b border-white/10 py-20 md:py-28">
    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-14 px-6 sm:px-8 lg:grid-cols-12 lg:gap-16">
      <div class="reveal lg:col-span-7">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-cyan-300">Offshore decision intelligence</p>
        <h1 class="mt-5 max-w-5xl font-display text-5xl font-black leading-[1.03] tracking-tight text-white sm:text-6xl lg:text-7xl">Turn offshore uncertainty into an evidence plan.</h1>
        <p class="mt-7 max-w-3xl text-lg leading-relaxed text-slate-300 sm:text-xl">OceanHub translates a project decision into the uncertainties to resolve, evidence to collect, capabilities to assemble, engineering references to apply and precedents that support the plan.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={url('scope/')} class="rounded-xl bg-cyan-400 px-6 py-3.5 text-sm font-black text-slate-950 hover:bg-cyan-300">Scope a Project</a>
          <button type="button" data-open-collaboration="partner" class="rounded-xl border border-white/15 bg-white/5 px-6 py-3.5 text-sm font-bold text-white hover:bg-white/10">Join as a Partner</button>
        </div>
        <p class="mt-5 max-w-3xl text-xs leading-relaxed text-slate-500">Supports offshore CCS, wind, marine site investigation, subsea infrastructure, integrity and decommissioning. Start with the Offshore CCS Scoper to turn a project decision into a traceable evidence plan.</p>
      </div>

      <div class="reveal lg:col-span-5" style="transition-delay: 100ms;">
        <div class="border-l border-cyan-400/30 pl-6 sm:pl-8">
          <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-cyan-300">Example · Offshore CCS · Pre-FEED</p>
          <p class="mt-4 text-xl font-bold leading-snug text-white">{example?.decision}</p>
          <dl class="mt-7 space-y-5">
            <div><dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-500">Uncertainty</dt><dd class="mt-1.5 text-sm leading-relaxed text-slate-300">{example?.requirement.uncertainty}</dd></div>
            <div><dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-500">Evidence</dt><dd class="mt-1.5 text-sm leading-relaxed text-slate-300">{example?.requirement.evidenceNeeded}</dd></div>
            <div><dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-500">Capability</dt><dd class="mt-1.5 text-sm leading-relaxed text-slate-300">{example?.capabilities.slice(0, 3).map((capability) => capability.label).join(' · ')}</dd></div>
          </dl>
          <a href={url('scope/')} class="mt-7 inline-flex text-sm font-bold text-cyan-300 hover:text-cyan-200">Open the evidence plan →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-white/10 py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 sm:px-8">
      <div class="reveal max-w-3xl">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-cyan-300">How it works</p>
        <h2 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-5xl">Start from the decision. Trace the evidence chain.</h2>
      </div>
      <ol class="reveal mt-12 divide-y divide-white/10 border-y border-white/10">
        {[
          ['01', 'Decision', example?.decision],
          ['02', 'Uncertainty', example?.requirement.uncertainty],
          ['03', 'Evidence', example?.requirement.evidenceNeeded],
          ['04', 'Capability', example?.capabilities.map((capability) => capability.label).join(' · ')],
          ['05', 'References', example?.references.map((reference) => reference.code).join(' · ')],
          ['06', 'Precedent', example?.sources.map((source) => source.publisher).join(' · ')]
        ].map(([number, label, detail]) => (
          <li class="grid grid-cols-[3rem_1fr] gap-4 py-5 sm:grid-cols-[4rem_10rem_1fr] sm:gap-6 sm:py-6"><span class="font-mono text-xs text-cyan-400">{number}</span><strong class="text-sm text-white">{label}</strong><span class="col-start-2 text-sm leading-relaxed text-slate-400 sm:col-start-3">{detail}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-b border-white/10 py-20 md:py-28">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-6 sm:px-8 lg:grid-cols-12 lg:gap-16">
      <div class="reveal lg:col-span-5">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-cyan-300">Traceable by design</p>
        <h2 class="mt-4 font-display text-3xl font-black text-white sm:text-5xl">No confidence theatre.</h2>
        <p class="mt-5 text-base leading-relaxed text-slate-400">Every recommendation links delivery capabilities, engineering rationale, references and project or regulator provenance. When evidence is insufficient, the gap is shown explicitly.</p>
        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2"><a href={url('capabilities/')} class="text-sm font-bold text-cyan-300 hover:text-cyan-200">Browse capabilities →</a><a href={url('references/')} class="text-sm font-bold text-cyan-300 hover:text-cyan-200">Engineering references →</a></div>
      </div>
      <div class="reveal lg:col-span-7">
        <div class="divide-y divide-white/10 border-y border-white/10">
          {example?.sources.map((source) => (
            <a href={source.url} target="_blank" rel="noopener noreferrer" class="grid gap-2 py-5 sm:grid-cols-[9rem_1fr_auto] sm:items-center sm:gap-5">
              <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-500">{source.sourceType} · {source.publishedYear}</span><span class="text-sm font-bold text-slate-200">{source.title}</span><span class="text-xs text-slate-500">{source.publisher} ↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="alliance" class="scroll-mt-24 py-20 md:py-28">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-6 sm:px-8 lg:grid-cols-12 lg:gap-16">
      <div class="reveal lg:col-span-5">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-emerald-300">Green Offshore Technology Alliance</p>
        <h2 class="mt-4 font-display text-3xl font-black text-white sm:text-5xl">Build the capability network around real offshore problems.</h2>
        <p class="mt-5 text-base leading-relaxed text-slate-400">Proposed JIPs turn shared evidence and capability gaps into concrete workstreams and partner calls.</p>
        <div class="mt-8 flex flex-wrap gap-3"><a href={url('jips/')} class="rounded-xl bg-emerald-400 px-5 py-3 text-sm font-black text-slate-950 hover:bg-emerald-300">Explore proposed JIPs</a><button type="button" data-open-collaboration="partner" class="rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-sm font-bold text-white">Join the network</button></div>
        <p class="mt-4 text-xs leading-relaxed text-slate-500">Alliance and JIP scopes are forming initiatives unless a partner commitment is explicitly stated.</p>
      </div>
      <div class="lg:col-span-7">
        <div class="divide-y divide-white/10 border-y border-white/10">
          {jipViews.map((jip) => (
            <a href={url(`jips/#${jip.id}`)} class="block py-5"><span class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-emerald-300">{jip.number} · {jip.status}</span><h3 class="mt-2 text-base font-bold text-white">{jip.title}</h3><p class="mt-2 text-xs leading-relaxed text-slate-500">Capabilities: {jip.capabilities.slice(0, 4).map((capability) => capability.label).join(' · ')}</p></a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>