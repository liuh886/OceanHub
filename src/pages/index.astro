---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import bgpLogo from '../assets/bgp-logo.png';
import penesonLogo from '../assets/peneson-logo.png';

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;

const focusAreas = await getCollection('focus-areas');
const sortedFocusAreas = focusAreas.sort((a, b) => a.data.order - b.data.order);
const insights = await getCollection('insights');
const sortedInsights = insights
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const iconMap: Record<string, { icon: string; badge: string }> = {
  ccus: { icon: 'fa-cloud-arrow-up', badge: 'CARBON STORAGE' },
  'marine-ecology': { icon: 'fa-leaf', badge: 'ENVIRONMENT' },
  'offshore-energy': { icon: 'fa-wind', badge: 'SITE DEVELOPMENT' },
  'offshore-infrastructure': { icon: 'fa-anchor', badge: 'ASSET INTEGRITY' }
};
---

<Layout
  title="OceanHub | Marine Intelligence for Offshore Decisions"
  description="OceanHub connects offshore operators and specialist partners around decision-ready geophysical, geotechnical and environmental evidence."
>
  <section class="relative min-h-[86vh] flex items-center overflow-hidden py-24 md:py-32">
    <div class="max-w-[1560px] mx-auto px-6 md:px-12 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-7 reveal">
          <div class="hud-badge mb-8">
            <i class="fa-solid fa-water" aria-hidden="true"></i>
            <span>OFFSHORE ENERGY · MONITORING · MARINE DATA</span>
          </div>

          <h1 class="heading-hero mb-8">
            Marine intelligence<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-500">for offshore decisions.</span>
          </h1>

          <p class="text-lg md:text-2xl text-slate-300 mb-10 leading-relaxed font-light max-w-3xl">
            OceanHub connects operators, geoscience teams and specialist technology partners around the evidence needed to plan, build, monitor and maintain complex offshore projects.
          </p>

          <div class="flex flex-wrap gap-4 items-center">
            <a href={url('#focus-areas')} class="px-7 py-4 rounded-xl bg-gradient-to-r from-cyan-500 via-sky-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-black uppercase tracking-[0.14em] text-xs transition-all flex items-center gap-3 group">
              <span>Explore Focus Areas</span>
              <i class="fa-solid fa-arrow-down text-xs transition-transform group-hover:translate-y-1" aria-hidden="true"></i>
            </a>
            <a href="mailto:info@oceanhub.com" class="px-7 py-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/15 hover:border-cyan-500/40 text-white font-bold uppercase tracking-[0.14em] text-xs transition-all flex items-center gap-2">
              <span>Propose a Collaboration</span>
              <i class="fa-solid fa-arrow-right text-[10px] text-cyan-400" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 reveal" style="transition-delay: 160ms;">
          <div class="glass-panel p-6 md:p-8 rounded-3xl border border-cyan-500/20 relative overflow-hidden">
            <div class="flex items-center justify-between pb-5 border-b border-white/10">
              <span class="text-xs font-mono text-cyan-300 uppercase tracking-[0.18em]">How the platform works</span>
              <span class="text-xs text-slate-500 font-mono">01—03</span>
            </div>

            <ol class="divide-y divide-white/10">
              <li class="py-6 flex gap-4">
                <span class="text-cyan-400 font-mono font-bold">01</span>
                <div>
                  <h2 class="text-lg font-bold text-white font-display">Frame the offshore decision</h2>
                  <p class="text-sm text-slate-400 mt-2 leading-relaxed">Define the development, monitoring or integrity question before selecting technology.</p>
                </div>
              </li>
              <li class="py-6 flex gap-4">
                <span class="text-cyan-400 font-mono font-bold">02</span>
                <div>
                  <h2 class="text-lg font-bold text-white font-display">Connect the evidence chain</h2>
                  <p class="text-sm text-slate-400 mt-2 leading-relaxed">Combine geophysical, geotechnical and environmental observations into a coherent ground and risk picture.</p>
                </div>
              </li>
              <li class="py-6 flex gap-4">
                <span class="text-cyan-400 font-mono font-bold">03</span>
                <div>
                  <h2 class="text-lg font-bold text-white font-display">Build the right delivery team</h2>
                  <p class="text-sm text-slate-400 mt-2 leading-relaxed">Match operator needs with specialist partners, field capability and decision-ready outputs.</p>
                </div>
              </li>
            </ol>

            <div class="pt-5 border-t border-white/10 flex flex-wrap gap-2">
              <span class="evidence-chip">GEOPHYSICS</span>
              <span class="evidence-chip">GEOTECHNICS</span>
              <span class="evidence-chip">ENVIRONMENT</span>
              <span class="evidence-chip">MONITORING</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="focus-areas" class="section-padding relative scroll-mt-20">
    <div class="max-w-[1560px] mx-auto px-6 md:px-12">
      <div class="max-w-3xl mb-16 reveal">
        <div class="hud-badge mb-4"><i class="fa-solid fa-cubes" aria-hidden="true"></i> FOCUS AREAS</div>
        <h2 class="heading-section">Four connected offshore problem spaces</h2>
        <p class="text-lg md:text-xl text-slate-400 font-light leading-relaxed">Each focus area starts with a decision, identifies the evidence required, and brings together the capabilities needed to deliver it.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-7">
        {sortedFocusAreas.map((area, index) => (
          <article class="glass-card p-7 h-full flex flex-col justify-between group relative overflow-hidden reveal" style={`transition-delay: ${index * 90}ms`}>
            <div>
              <div class="flex items-center justify-between mb-7">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-500/15 to-blue-600/20 border border-cyan-400/30 flex items-center justify-center text-cyan-400 group-hover:bg-cyan-500 group-hover:text-slate-950 transition-all">
                  <i class={`fa-solid ${iconMap[area.slug]?.icon || 'fa-anchor'} text-xl`} aria-hidden="true"></i>
                </div>
                <span class="hud-badge text-[10px]">{iconMap[area.slug]?.badge || 'OFFSHORE'}</span>
              </div>
              <h3 class="text-2xl font-black text-white mb-4 tracking-tight group-hover:text-cyan-300 transition-colors font-display">{area.data.title}</h3>
              <p class="text-sm md:text-base text-slate-400 mb-8 font-light leading-relaxed">{area.data.description}</p>
            </div>
            <div class="pt-5 border-t border-white/10">
              <a href={url(`focus-areas/${area.slug}/`)} class="inline-flex items-center gap-3 text-xs font-mono font-bold uppercase tracking-wider text-cyan-400 hover:text-cyan-300">
                <span>View problem and approach</span>
                <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 bg-[#040810]/70 border-y border-cyan-500/10 relative">
    <div class="max-w-[1560px] mx-auto px-6 md:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-4 reveal">
          <div class="hud-badge mb-4"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i> SHARED EVIDENCE</div>
          <h2 class="heading-section">From field observation to engineering decision</h2>
          <p class="text-lg text-slate-400 leading-relaxed font-light">OceanHub is not a single-company service catalogue. It is a collaboration layer for assembling coherent offshore evidence across disciplines and organisations.</p>
        </div>

        <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-3 gap-6 reveal" style="transition-delay: 120ms;">
          <div class="glass-card p-7">
            <div class="text-xs text-cyan-400 font-mono font-bold mb-3">FOUNDATION</div>
            <h3 class="text-xl text-white font-bold font-display mb-3">Observed conditions</h3>
            <p class="text-sm text-slate-400 leading-relaxed">Bathymetry, seismic, soil, oceanographic and ecological observations with clear provenance and uncertainty.</p>
          </div>
          <div class="glass-card p-7">
            <div class="text-xs text-cyan-400 font-mono font-bold mb-3">INTEGRATION</div>
            <h3 class="text-xl text-white font-bold font-display mb-3">Connected interpretation</h3>
            <p class="text-sm text-slate-400 leading-relaxed">A consistent view of ground conditions, hazards, environmental constraints and monitoring requirements.</p>
          </div>
          <div class="glass-card p-7">
            <div class="text-xs text-cyan-400 font-mono font-bold mb-3">USE</div>
            <h3 class="text-xl text-white font-bold font-display mb-3">Decision-ready outputs</h3>
            <p class="text-sm text-slate-400 leading-relaxed">Evidence designed for site selection, engineering, consenting, operations, monitoring and asset integrity.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {sortedInsights.length > 0 && (
    <section id="insights" class="section-padding relative scroll-mt-20">
      <div class="max-w-[1560px] mx-auto px-6 md:px-12">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-8 reveal">
          <div class="max-w-3xl">
            <div class="hud-badge mb-4"><i class="fa-solid fa-book-open" aria-hidden="true"></i> MARINE INTELLIGENCE</div>
            <h2 class="heading-section">Technical context for better offshore choices</h2>
            <p class="text-lg text-slate-400 font-light leading-relaxed">Focused notes on monitoring, site characterisation, offshore development and the evidence needed to reduce uncertainty.</p>
          </div>
          <a href={url('insights/')} class="inline-flex items-center gap-3 px-6 py-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-cyan-500/30 text-xs font-mono font-bold uppercase tracking-wider text-slate-300 hover:text-cyan-300 transition-all shrink-0">Browse all insights <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-7">
          {sortedInsights.map((insight, index) => (
            <article class="glass-card p-7 h-full flex flex-col justify-between group reveal" style={`transition-delay: ${index * 100}ms`}>
              <div>
                <div class="flex flex-wrap items-center gap-3 mb-5">
                  <time datetime={insight.data.publishDate.toISOString()} class="text-xs font-mono text-cyan-400">{insight.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
                  {insight.data.tags.slice(0, 2).map((tag) => <span class="evidence-chip">{tag}</span>)}
                </div>
                <h3 class="text-2xl font-black leading-tight text-white group-hover:text-cyan-300 transition-colors mb-4 font-display"><a href={url(`insights/${insight.slug}/`)}>{insight.data.title}</a></h3>
                <p class="text-slate-400 text-sm leading-relaxed mb-8">{insight.data.description}</p>
              </div>
              <a href={url(`insights/${insight.slug}/`)} class="text-xs font-mono font-bold text-cyan-400 hover:text-cyan-300 flex items-center gap-2">Read insight <i class="fa-solid fa-chevron-right text-[10px]" aria-hidden="true"></i></a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-padding bg-[#040810]/80 border-y border-cyan-500/10 relative">
    <div class="max-w-[1200px] mx-auto px-6 md:px-12">
      <div class="text-center max-w-3xl mx-auto mb-14 reveal">
        <div class="hud-badge mb-4"><i class="fa-solid fa-handshake" aria-hidden="true"></i> FOUNDING NETWORK</div>
        <h2 class="heading-section">A platform built through complementary capability</h2>
        <p class="text-lg text-slate-400 font-light">The initial network connects large-scale marine geophysical delivery with specialist offshore geotechnical capability, while remaining open to additional partners.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-7 reveal">
        <div class="glass-card p-8 text-center flex flex-col items-center justify-between group">
          <div class="w-full flex justify-center py-6"><Image src={bgpLogo} alt="BGP Offshore" width={220} class="brightness-0 invert opacity-75 group-hover:opacity-100 transition-opacity w-48" /></div>
          <div class="w-full pt-4 border-t border-white/10"><div class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest">Marine Geophysics</div></div>
        </div>
        <div class="glass-card p-8 text-center flex flex-col items-center justify-between group">
          <div class="w-full flex justify-center py-6"><Image src={penesonLogo} alt="Guangzhou Peneson" width={220} class="brightness-0 invert opacity-75 group-hover:opacity-100 transition-opacity w-48" /></div>
          <div class="w-full pt-4 border-t border-white/10"><div class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest">Marine Geotechnics</div></div>
        </div>
        <div class="glass-card p-8 text-center flex flex-col items-center justify-center border-dashed border-cyan-500/30">
          <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-cyan-400 mb-4"><i class="fa-solid fa-plus" aria-hidden="true"></i></div>
          <h3 class="text-xl font-bold text-white font-display">Add your capability</h3>
          <p class="text-sm text-slate-400 mt-3 mb-6">Bring a technology, dataset, field capability or offshore use case to the platform.</p>
          <a href="mailto:info@oceanhub.com" class="text-xs font-mono font-bold text-cyan-400 hover:text-cyan-300 uppercase tracking-widest">Start a conversation →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="max-w-4xl mx-auto px-6 text-center relative z-10 reveal">
      <div class="hud-badge mb-6"><i class="fa-solid fa-compass" aria-hidden="true"></i> START WITH THE DECISION</div>
      <h2 class="text-4xl sm:text-6xl md:text-7xl font-black text-white tracking-tight mb-8 font-display">Bring us the offshore question.</h2>
      <p class="text-base md:text-xl text-slate-300 mb-10 font-light leading-relaxed max-w-2xl mx-auto">OceanHub will help frame the evidence need, identify relevant capabilities and shape a practical collaboration path.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="mailto:info@oceanhub.com" class="px-8 py-4 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-black uppercase tracking-wider text-xs transition-all">Propose a Collaboration</a>
        <a href={url('about/')} class="px-8 py-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/15 hover:border-cyan-500/40 text-white font-bold uppercase tracking-wider text-xs transition-all">How OceanHub Works</a>
      </div>
    </div>
  </section>
</Layout>
