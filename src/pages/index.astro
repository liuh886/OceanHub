---
import Layout from '../layouts/Layout.astro';
import SubsurfaceVisualizer from '../components/SubsurfaceVisualizer.astro';
import DecisionScoper from '../components/DecisionScoper.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import bgpLogo from '../assets/bgp-logo.png';
import penesonLogo from '../assets/peneson-logo.png';

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;

const focusAreas = await getCollection('focus-areas');
const sortedFocusAreas = focusAreas.sort((a, b) => a.data.order - b.data.order);
const insights = await getCollection('insights');
const sortedInsights = insights
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const focusAreaMetadata: Record<string, {
  icon: string;
  badge: string;
  depthHorizon: string;
  techTags: string[];
  metrics: string;
}> = {
  ccus: {
    icon: 'fa-cloud-arrow-up',
    badge: 'CARBON STORAGE & MRV',
    depthHorizon: '800m – 3,200m Sub-seabed',
    techTags: ['4D DAS Seismic', 'Plume Imaging', 'Wellbore Integrity'],
    metrics: 'Continuous Acoustic Strain Telemetry'
  },
  'marine-ecology': {
    icon: 'fa-leaf',
    badge: 'ENVIRONMENTAL INTELLIGENCE',
    depthHorizon: 'Full Water Column & Benthos',
    techTags: ['PAM Acoustics', 'eDNA Sequencing', 'Habitat Mapping'],
    metrics: 'Real-time Marine Mammal Detection'
  },
  'offshore-energy': {
    icon: 'fa-wind',
    badge: 'SITE CHARACTERISATION',
    depthHorizon: '0m – 120m Seabed Penetration',
    techTags: ['Deep CPTu In-Situ', 'UHR 3D Seismic', 'FLS/ULS Ground Model'],
    metrics: 'Integrated Soil-Structure Interaction'
  },
  'offshore-infrastructure': {
    icon: 'fa-anchor',
    badge: 'ASSET & ROUTE INTEGRITY',
    depthHorizon: 'Seabed Surface & Trench Horizon',
    techTags: ['Autonomous USV', 'Sub-bottom Profiler', 'Free-span & Scour'],
    metrics: 'Millimeter-scale Pipeline Deformation'
  }
};
---

<Layout
  title="OceanHub | Marine Intelligence for Offshore Decisions"
  description="OceanHub connects offshore operators, marine geophysics, geotechnical specialists and environmental teams around decision-ready ground evidence."
>
  <!-- Hero Section -->
  <section class="relative min-h-[92vh] flex items-center overflow-hidden pt-12 pb-24 md:py-32">
    <div class="max-w-[1760px] mx-auto px-6 sm:px-8 md:px-12 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Hero Left: Mission Statement & Actions -->
        <div class="lg:col-span-7 reveal">
          <div class="flex flex-wrap items-center gap-3 mb-8">
            <div class="hud-badge">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
              </span>
              <span>GREEN OFFSHORE TECHNOLOGY ALLIANCE</span>
            </div>
            <span class="depth-badge">
              <i class="fa-solid fa-handshake text-[9px]" aria-hidden="true"></i> COLLABORATIVE INNOVATION NETWORK
            </span>
          </div>

          <h1 class="heading-hero mb-8">
            Next-generation green engineering<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-emerald-400 glow-text-cyan">
              for sustainable ocean development.
            </span>
          </h1>

          <p class="text-lg md:text-2xl text-slate-300 mb-10 leading-relaxed font-light max-w-3xl">
            OceanHub unites offshore developers, geophysical survey fleets, geotechnical specialists, and research institutions to explore next-generation green engineering technologies and launch collaborative Joint Industry Projects (JIPs).
          </p>

          <div class="flex flex-wrap gap-4 items-center mb-12">
            <a href={url('jips/')} class="px-8 py-4 rounded-2xl bg-gradient-to-r from-emerald-400 via-cyan-400 to-blue-600 hover:from-emerald-300 hover:to-blue-500 text-slate-950 font-black uppercase tracking-[0.14em] text-xs transition-all shadow-[0_0_30px_rgba(16,185,129,0.3)] hover:shadow-[0_0_45px_rgba(0,240,255,0.5)] flex items-center gap-3 group active:scale-95">
              <span class="w-2 h-2 rounded-full bg-slate-950 animate-ping"></span>
              <span>Explore 4 JIP Initiatives</span>
              <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
            </a>

            <button
              type="button"
              data-open-alliance-modal
              class="px-8 py-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/15 hover:border-cyan-400/50 text-white font-bold uppercase tracking-[0.14em] text-xs transition-all flex items-center gap-2.5 backdrop-blur-md active:scale-95"
            >
              <i class="fa-solid fa-user-plus text-xs text-cyan-400" aria-hidden="true"></i>
              <span>Join Tech Alliance</span>
            </button>

            <a href={url('#focus-areas')} class="px-5 py-4 rounded-2xl text-slate-400 hover:text-cyan-300 font-mono text-xs uppercase tracking-wider flex items-center gap-2 transition-colors">
              <i class="fa-solid fa-layer-group text-xs text-cyan-400" aria-hidden="true"></i>
              <span>Focus Areas</span>
            </a>
          </div>

          <!-- Quick Telemetry Stats Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-8 border-t border-white/10">
            <div>
              <div class="text-2xl lg:text-3xl font-black text-emerald-400 font-display">4 JIPs</div>
              <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mt-1">Active Proposals</div>
            </div>
            <div>
              <div class="text-2xl lg:text-3xl font-black text-white font-display">100%</div>
              <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mt-1">Shared Evidence</div>
            </div>
            <div>
              <div class="text-2xl lg:text-3xl font-black text-white font-display">3D/4D</div>
              <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mt-1">DAS & Soil Models</div>
            </div>
            <div>
              <div class="text-2xl lg:text-3xl font-black text-cyan-400 font-display">Open</div>
              <div class="text-[11px] font-mono text-cyan-300/80 uppercase tracking-wider mt-1">Alliance Network</div>
            </div>
          </div>
        </div>

        <!-- Hero Right: Interactive Marine Telemetry Console HUD -->
        <div class="lg:col-span-5 reveal" style="transition-delay: 150ms;">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-cyan-500/25 relative overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.6)]">
            <!-- HUD Header -->
            <div class="flex items-center justify-between pb-5 border-b border-white/10">
              <div class="flex items-center gap-2.5">
                <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
                <span class="text-xs font-mono font-bold text-cyan-300 uppercase tracking-[0.2em]">Ocean Telemetry Matrix</span>
              </div>
              <span class="text-[10px] font-mono px-2.5 py-1 rounded bg-cyan-950/80 border border-cyan-500/30 text-cyan-300">
                LIVE DEMO
              </span>
            </div>

            <!-- Interactive Channel Selector Tabs -->
            <div class="flex gap-2 py-4 border-b border-white/10 overflow-x-auto" id="hud-channel-tabs">
              <button class="hud-tab active px-3 py-1.5 rounded-lg text-[11px] font-mono font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 transition-all" data-channel="0">
                CH 01: SEISMIC
              </button>
              <button class="hud-tab px-3 py-1.5 rounded-lg text-[11px] font-mono font-medium text-slate-400 hover:text-white border border-transparent hover:border-white/10 transition-all" data-channel="1">
                CH 02: GEOTECH
              </button>
              <button class="hud-tab px-3 py-1.5 rounded-lg text-[11px] font-mono font-medium text-slate-400 hover:text-white border border-transparent hover:border-white/10 transition-all" data-channel="2">
                CH 03: CCUS 4D
              </button>
              <button class="hud-tab px-3 py-1.5 rounded-lg text-[11px] font-mono font-medium text-slate-400 hover:text-white border border-transparent hover:border-white/10 transition-all" data-channel="3">
                CH 04: ECOLOGY
              </button>
            </div>

            <!-- Dynamic Telemetry Screen & Live Canvas Oscilloscope -->
            <div class="py-6 min-h-[250px]" id="hud-channel-content">
              <!-- Shared Live Procedural Oscilloscope Canvas -->
              <div class="relative mb-5">
                <canvas id="hud-telemetry-canvas" class="w-full h-24 rounded-xl bg-[#02050E] border border-cyan-500/30 shadow-[inset_0_0_20px_rgba(0,0,0,0.8)]"></canvas>
                <div class="absolute top-2 left-3 flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                  <span class="text-[10px] font-mono font-bold tracking-widest text-cyan-300 uppercase" id="canvas-mode-tag">SEISMIC STREAM 3D</span>
                </div>
                <div class="absolute top-2 right-3 text-[10px] font-mono text-emerald-400 font-bold" id="canvas-status-tag">
                  GEOHAZARD: CLEAR
                </div>
                <div class="absolute bottom-1.5 right-3 text-[9px] font-mono text-slate-500" id="canvas-freq-tag">
                  SAMPLING: 2.0 kHz · TIME-SERIES
                </div>
              </div>

              <!-- Channel 0 Content (Default: Seismic) -->
              <div class="hud-pane" id="pane-0">
                <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-3">
                  <span class="text-cyan-300 font-bold">Ultra-High-Resolution 3D Seismic Stream</span>
                  <span>Horizon: 0 – 800m Sub-seabed</span>
                </div>
                <div class="grid grid-cols-3 gap-2 text-center p-3 rounded-xl bg-slate-950/60 border border-white/5 mb-3">
                  <div>
                    <div class="text-[10px] font-mono text-slate-500">Reflector Z</div>
                    <div class="text-xs font-mono font-bold text-cyan-300" id="seismic-depth-val">248.5 m</div>
                  </div>
                  <div>
                    <div class="text-[10px] font-mono text-slate-500">Impedance</div>
                    <div class="text-xs font-mono font-bold text-sky-400">2.85×10⁶</div>
                  </div>
                  <div>
                    <div class="text-[10px] font-mono text-slate-500">Gas Pockets</div>
                    <div class="text-xs font-mono font-bold text-emerald-400">0.0% (None)</div>
                  </div>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed font-light">
                  Detects shallow gas hazards, paleo-channels, boulder anomalies, and fault displacements prior to foundation installation.
                </p>
              </div>

              <!-- Channel 1 Content (Geotech) -->
              <div class="hud-pane hidden" id="pane-1">
                <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-3">
                  <span class="text-sky-300 font-bold">Deepwater In-Situ CPTu Telemetry</span>
                  <span>Penetration: 0 – 120m Seabed</span>
                </div>
                <div class="grid grid-cols-3 gap-2 text-center p-3 rounded-xl bg-slate-950/60 border border-white/5 mb-3">
                  <div>
                    <div class="text-[10px] font-mono text-slate-500">Tip Res (qc)</div>
                    <div class="text-xs font-mono font-bold text-sky-400" id="cptu-qc-val">42.8 MPa</div>
                  </div>
                  <div>
                    <div class="text-[10px] font-mono text-slate-500">Sleeve (fs)</div>
                    <div class="text-xs font-mono font-bold text-cyan-300">185 kPa</div>
                  </div>
                  <div>
                    <div class="text-[10px] font-mono text-slate-500">Pore (u2)</div>
                    <div class="text-xs font-mono font-bold text-emerald-400">3.42 MPa</div>
                  </div>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed font-light">
                  High-precision seabed soil strength characterisation directly informing wind monopile and suction anchor cyclic fatigue limits.
                </p>
              </div>

              <!-- Channel 2 Content (CCUS) -->
              <div class="hud-pane hidden" id="pane-2">
                <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-3">
                  <span class="text-cyan-300 font-bold">4D DAS Fiber Optic Plume Monitoring</span>
                  <span>Depth: 1,800m Saline Reservoir</span>
                </div>
                <div class="grid grid-cols-3 gap-2 text-center p-3 rounded-xl bg-slate-950/60 border border-white/5 mb-3">
                  <div>
                    <div class="text-[10px] font-mono text-slate-500">DAS Strain</div>
                    <div class="text-xs font-mono font-bold text-cyan-300" id="ccus-strain-val">±0.012 με</div>
                  </div>
                  <div>
                    <div class="text-[10px] font-mono text-slate-500">Caprock Margin</div>
                    <div class="text-xs font-mono font-bold text-emerald-400">+5.1 MPa</div>
                  </div>
                  <div>
                    <div class="text-[10px] font-mono text-slate-500">Plume Status</div>
                    <div class="text-xs font-mono font-bold text-emerald-400">100% Contained</div>
                  </div>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed font-light">
                  Continuous acoustic strain telemetry along subsea fibers verifying zero caprock leakage and stable CO₂ storage migration.
                </p>
              </div>

              <!-- Channel 3 Content (Ecology) -->
              <div class="hud-pane hidden" id="pane-3">
                <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-3">
                  <span class="text-emerald-300 font-bold">Passive Acoustic Monitoring (PAM)</span>
                  <span>Bandwidth: 10Hz – 160kHz</span>
                </div>
                <div class="grid grid-cols-3 gap-2 text-center p-3 rounded-xl bg-slate-950/60 border border-white/5 mb-3">
                  <div>
                    <div class="text-[10px] font-mono text-slate-500">Peak Signal</div>
                    <div class="text-xs font-mono font-bold text-cyan-400" id="pam-peak-val">85.2 kHz</div>
                  </div>
                  <div>
                    <div class="text-[10px] font-mono text-slate-500">Buffer Zone</div>
                    <div class="text-xs font-mono font-bold text-emerald-400">5.0 km Clear</div>
                  </div>
                  <div>
                    <div class="text-[10px] font-mono text-slate-500">Ambient SPL</div>
                    <div class="text-xs font-mono font-bold text-sky-300">92.4 dB</div>
                  </div>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed font-light">
                  Continuous marine mammal acoustic protection and environmental baseline tracking ensuring full OSPAR/EIA licensing compliance.
                </p>
              </div>
            </div>

            <!-- HUD Bottom Disciplines Badges -->
            <div class="pt-5 border-t border-white/10 flex flex-wrap gap-2">
              <span class="evidence-chip">GEOPHYSICS</span>
              <span class="evidence-chip">GEOTECHNICS</span>
              <span class="evidence-chip">ENVIRONMENT</span>
              <span class="evidence-chip">4D MONITORING</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Decision-to-Evidence Pipeline Flow Section -->
  <section class="py-24 md:py-32 bg-[#030712]/90 border-y border-cyan-500/15 relative overflow-hidden">
    <div class="max-w-[1760px] mx-auto px-6 sm:px-8 md:px-12 relative z-10">
      <div class="max-w-3xl mb-16 reveal">
        <div class="hud-badge mb-4">
          <i class="fa-solid fa-diagram-project" aria-hidden="true"></i> THE COLLABORATION ARCHITECTURE
        </div>
        <h2 class="heading-section">From field observation to engineering decision</h2>
        <p class="text-lg md:text-xl text-slate-300 font-light leading-relaxed">
          OceanHub is not a generic service directory. It is an engineering collaboration protocol that synthesizes fragmented observations into high-integrity decisions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="glass-card-interactive p-8 md:p-10 rounded-3xl reveal">
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest">PHASE 01</span>
            <span class="w-8 h-8 rounded-xl bg-cyan-500/10 flex items-center justify-center text-cyan-300 font-mono text-xs font-bold">01</span>
          </div>
          <h3 class="text-2xl font-bold text-white font-display mb-4">Frame the Decision</h3>
          <p class="text-sm md:text-base text-slate-300 font-light leading-relaxed mb-6">
            Define the engineering, environmental, or regulatory hurdle before selecting sensors. Clarify the risk tolerance, required depth horizons, and regulatory milestones.
          </p>
          <div class="pt-4 border-t border-white/10 flex flex-wrap gap-2 text-[11px] font-mono text-cyan-300/80">
            <span>• Site Feasibility</span>
            <span>• Geohazard Scoping</span>
            <span>• Regulatory Bounds</span>
          </div>
        </div>

        <div class="glass-card-interactive p-8 md:p-10 rounded-3xl reveal" style="transition-delay: 100ms;">
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest">PHASE 02</span>
            <span class="w-8 h-8 rounded-xl bg-sky-500/10 flex items-center justify-center text-sky-300 font-mono text-xs font-bold">02</span>
          </div>
          <h3 class="text-2xl font-bold text-white font-display mb-4">Connect Evidence Chain</h3>
          <p class="text-sm md:text-base text-slate-300 font-light leading-relaxed mb-6">
            Fuse multi-beam bathymetry, ultra-high-resolution 3D seismic, deep CPTu in-situ tests, and acoustic hydrophone data into a unified, cross-validated ground model.
          </p>
          <div class="pt-4 border-t border-white/10 flex flex-wrap gap-2 text-[11px] font-mono text-sky-300/80">
            <span>• Seismic-to-Well Tie</span>
            <span>• Soil Stratigraphy</span>
            <span>• Noise Attenuation</span>
          </div>
        </div>

        <div class="glass-card-interactive p-8 md:p-10 rounded-3xl reveal" style="transition-delay: 200ms;">
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-mono font-bold text-emerald-400 uppercase tracking-widest">PHASE 03</span>
            <span class="w-8 h-8 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-300 font-mono text-xs font-bold">03</span>
          </div>
          <h3 class="text-2xl font-bold text-white font-display mb-4">Deliver Verified Outputs</h3>
          <p class="text-sm md:text-base text-slate-300 font-light leading-relaxed mb-6">
            Generate decision-ready evidence packets with full provenance, quantified uncertainty bounds, and audit-ready telemetry for project teams and regulators.
          </p>
          <div class="pt-4 border-t border-white/10 flex flex-wrap gap-2 text-[11px] font-mono text-emerald-300/80">
            <span>• Foundation Design Base</span>
            <span>• Plume MRV Report</span>
            <span>• EIA Compliance</span>
          </div>
        </div>
      </div>

      <!-- Interactive Subsurface & Full-Depth Cross-Section Component -->
      <div class="mt-16 reveal">
        <SubsurfaceVisualizer />
      </div>
    </div>
  </section>

  <!-- Strategic Focus Areas Section -->
  <section id="focus-areas" class="section-padding relative scroll-mt-20">
    <div class="max-w-[1760px] mx-auto px-6 sm:px-8 md:px-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8 reveal">
        <div class="max-w-3xl">
          <div class="hud-badge mb-4">
            <i class="fa-solid fa-cubes" aria-hidden="true"></i> STRATEGIC DOMAINS
          </div>
          <h2 class="heading-section">Four connected offshore problem spaces</h2>
          <p class="text-lg md:text-xl text-slate-300 font-light leading-relaxed">
            Each focus area starts with a high-stakes offshore decision, specifies the necessary multidisciplinary observations, and mobilizes specialized capability.
          </p>
        </div>
        <a href={url('focus-areas/')} class="inline-flex items-center gap-3 px-6 py-3.5 rounded-xl bg-white/5 hover:bg-cyan-500/15 border border-white/10 hover:border-cyan-400/40 text-xs font-mono font-bold uppercase tracking-wider text-slate-200 hover:text-cyan-300 transition-all shrink-0">
          <span>Browse All Domains</span>
          <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8">
        {sortedFocusAreas.map((area, index) => {
          const meta = focusAreaMetadata[area.id] || {
            icon: 'fa-anchor',
            badge: 'OFFSHORE',
            depthHorizon: 'Sub-surface & Seabed',
            techTags: ['Marine Survey', 'Data Fusion'],
            metrics: 'Decision-ready Evidence'
          };
          return (
            <article class="glass-card p-8 h-full flex flex-col justify-between group relative overflow-hidden reveal" style={`transition-delay: ${index * 80}ms`}>
              <div>
                <!-- Card Header -->
                <div class="flex items-center justify-between mb-6">
                  <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-500/20 to-blue-600/30 border border-cyan-400/30 flex items-center justify-center text-cyan-300 group-hover:bg-cyan-400 group-hover:text-slate-950 transition-all duration-300 shadow-md">
                    <i class={`fa-solid ${meta.icon} text-xl`} aria-hidden="true"></i>
                  </div>
                  <span class="hud-badge text-[10px]">{meta.badge}</span>
                </div>

                <!-- Depth Indicator -->
                <div class="flex items-center gap-2 mb-4 text-[11px] font-mono text-sky-400">
                  <i class="fa-solid fa-arrows-up-down text-[10px]" aria-hidden="true"></i>
                  <span>{meta.depthHorizon}</span>
                </div>

                <h3 class="text-2xl font-black text-white mb-4 tracking-tight group-hover:text-cyan-300 transition-colors font-display">
                  {area.data.title}
                </h3>
                
                <p class="text-sm text-slate-300 mb-6 font-light leading-relaxed">
                  {area.data.description}
                </p>

                <!-- Technical Capabilities Tags -->
                <div class="flex flex-wrap gap-1.5 mb-8">
                  {meta.techTags.map((tag) => (
                    <span class="sensor-chip">{tag}</span>
                  ))}
                </div>
              </div>

              <!-- Card Footer Action -->
              <div class="pt-5 border-t border-white/10 flex items-center justify-between">
                <a href={url(`focus-areas/${area.id}/`)} class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-cyan-400 hover:text-cyan-300 group-hover:translate-x-1 transition-all">
                  <span>View Problem & Approach</span>
                  <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Joint Industry Projects (JIPs) Alliance Section -->
  <section class="section-padding bg-[#020612] relative border-t border-cyan-500/20">
    <div class="max-w-[1760px] mx-auto px-6 sm:px-8 md:px-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8 reveal">
        <div class="max-w-3xl">
          <div class="hud-badge mb-4">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>JOINT INDUSTRY PROJECTS (JIPs)</span>
          </div>
          <h2 class="heading-section">
