---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import bgpLogo from '../assets/bgp-logo.png';
import penesonLogo from '../assets/peneson-logo.png';

const focusAreas = await getCollection('focus-areas');
const sortedFocusAreas = focusAreas.sort((a, b) => a.data.order - b.data.order);

const insights = await getCollection('insights');
const sortedInsights = insights.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).slice(0, 4);

const iconMap: Record<string, string> = {
  'ccus': 'fa-cloud-arrow-up',
  'marine-ecology': 'fa-leaf',
  'offshore-energy': 'fa-bolt-lightning',
  'offshore-infrastructure': 'fa-anchor'
};
---

<Layout title="OceanHub | Nordic Excellence in Marine Data" description="Orchestrating the global transition to a sustainable blue energy future.">
	<!-- Hero Section -->
	<section class="relative min-h-screen flex items-center overflow-hidden pt-32 pb-48">
		<div class="max-w-[1800px] mx-auto px-8 md:px-16 relative z-10 w-full">
			<div class="max-w-6xl reveal">
				<h1 class="heading-hero mb-12">
					Bridging <br/>
                    <span class="text-brand-blue">Data & Future</span>
				</h1>
				<p class="text-2xl md:text-4xl text-slate-400 mb-20 leading-tight font-light max-w-3xl">
					A world-class platform for offshore energy transition and marine intelligence.
				</p>
				<div class="flex flex-col sm:flex-row gap-8">
					<a href="#focus-areas" class="group bg-brand-blue text-white px-12 py-6 rounded-full font-black uppercase tracking-[0.2em] text-sm hover:shadow-2xl hover:shadow-brand-blue/40 transition-all flex items-center justify-center gap-4">
						Explore Focus Areas
                        <i class="fa-solid fa-arrow-down transition-transform group-hover:translate-y-1"></i>
					</a>
					<a href="#about" class="bg-white border border-slate-200 text-slate-900 px-12 py-6 rounded-full font-black uppercase tracking-[0.2em] text-sm hover:bg-slate-50 transition-all text-center">
						Our Vision
					</a>
				</div>
			</div>
		</div>

		<!-- Abstract Background Elements -->
        <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[1200px] h-[1200px] bg-brand-blue/[0.02] rounded-full blur-[150px] -mr-96 pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent opacity-50"></div>
	</section>

	<!-- Focus Areas Section -->
	<section id="focus-areas" class="section-padding relative scroll-mt-24">
		<div class="max-w-[1800px] mx-auto px-8 md:px-16">
			<div class="max-w-4xl mb-32 reveal">
				<h2 class="heading-section">Strategic <br/>Focus Areas</h2>
				<p class="text-2xl text-slate-400 font-light leading-relaxed">
                    Targeted initiatives providing data certainty for complex offshore developments—delivered with technical rigour.
                </p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
				{sortedFocusAreas.map((area, index) => (
					<div class="reveal" style={`transition-delay: ${index * 150}ms`}>
                        <div class="group bg-white p-12 rounded-5xl border border-slate-100 hover:border-brand-blue/20 hover:shadow-[0_40px_100px_-20px_rgba(27,54,93,0.08)] transition-all duration-700 relative flex flex-col h-full overflow-hidden">
                            <div class="absolute top-0 right-0 w-32 h-32 bg-slate-50/50 rounded-bl-[100px] -mr-16 -mt-16 group-hover:bg-brand-blue/5 transition-colors duration-700"></div>
                            
                            <div class="w-20 h-20 bg-brand-blue/5 text-brand-blue rounded-3xl flex items-center justify-center mb-12 group-hover:bg-brand-blue group-hover:text-white transition-all duration-700 transform group-hover:scale-110 shadow-sm relative z-10">
                                <i class={`fa-solid ${iconMap[area.slug] || 'fa-anchor'} text-4xl`}></i>
                            </div>
                            
                            <h3 class="text-3xl font-black text-slate-900 mb-6 tracking-tight relative z-10">{area.data.title}</h3>
                            <p class="text-xl text-slate-400 mb-12 font-light leading-relaxed flex-grow relative z-10">
                                {area.data.description}
                            </p>
                            
                            <a href={`/focus-areas/${area.slug}`} class="text-brand-blue font-black text-xs uppercase tracking-[0.3em] inline-flex items-center gap-4 group-hover:gap-6 transition-all relative z-10">
                                View initiative <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
				))}
			</div>
		</div>
	</section>

	<!-- Insights Section -->
	<section id="insights" class="section-padding bg-slate-50/30 scroll-mt-24 border-y border-slate-100">
		<div class="max-w-[1800px] mx-auto px-8 md:px-16">
			<div class="max-w-4xl mb-32 reveal">
				<h2 class="heading-section">Deep Blue <br/>Intelligence</h2>
				<p class="text-2xl text-slate-400 font-light leading-relaxed">
                    Strategic foresight and technology trends for the offshore energy transition.
                </p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-16 lg:gap-24">
				{sortedInsights.map((insight, index) => (
					<div class="reveal" style={`transition-delay: ${index * 200}ms`}>
                        <article class="group relative py-12 border-b border-slate-200">
                            <div class="flex items-center gap-x-8 text-xs mb-10">
                                <time datetime={insight.data.publishDate.toISOString()} class="text-slate-400 font-black uppercase tracking-[0.3em]">
                                    {insight.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                                </time>
                                {insight.data.tags.map(tag => (
                                    <span class="rounded-full bg-slate-100 px-6 py-2 font-black text-slate-500 uppercase tracking-widest text-[10px] group-hover:bg-brand-blue group-hover:text-white transition-all duration-500">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                            <h3 class="text-4xl md:text-5xl font-black leading-tight text-slate-900 group-hover:text-brand-blue transition-colors duration-500 tracking-tighter mb-8">
                                <a href={`/insights/${insight.slug}`}>
                                    {insight.data.title}
                                </a>
                            </h3>
                            <p class="text-xl leading-relaxed text-slate-400 font-light mb-12 max-w-2xl">
                                {insight.data.description}
                            </p>
                            <div class="flex items-center gap-x-6">
                                <div class="w-12 h-12 rounded-full bg-brand-blue flex items-center justify-center text-white text-sm font-black shadow-xl shadow-brand-blue/30">
                                    {insight.data.author.charAt(0)}
                                </div>
                                <p class="text-sm font-black text-slate-900 uppercase tracking-[0.2em]">
                                    {insight.data.author}
                                </p>
                            </div>
                        </article>
                    </div>
				))}
			</div>
            <div class="mt-32 text-center reveal">
                <a href="/insights" class="group inline-flex items-center gap-6 text-slate-400 hover:text-brand-blue font-black uppercase tracking-[0.4em] text-xs transition-all">
                    All Insights <i class="fa-solid fa-chevron-right text-[10px] group-hover:translate-x-2 transition-transform"></i>
                </a>
            </div>
		</div>
	</section>

    <!-- About Section (Editorial Layout) -->
    <section id="about" class="section-padding scroll-mt-24 overflow-hidden">
        <div class="max-w-[1800px] mx-auto px-8 md:px-16">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-24 items-start">
                <div class="lg:col-span-7 reveal">
                    <span class="text-xs font-black uppercase tracking-[0.5em] text-brand-blue mb-12 block">Our DNA</span>
                    <h2 class="text-6xl md:text-8xl font-black mb-16 tracking-tighter leading-[1] text-slate-900">
                        Orchestrating <br/>
                        <span class="text-slate-300">the transition.</span>
                    </h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-24">
                        <div class="space-y-10 text-xl text-slate-400 font-light leading-relaxed">
                            <p>
                                The challenge of the energy transition—from offshore wind scale-up to gigaton-scale CCS—is too vast for any single entity to solve alone. It requires a new collaborative model.
                            </p>
                            <p>
                                We integrate global resources, local expertise, and cross-domain innovation. By connecting energy developers with specialized technology partners, we provide the intelligence needed to navigate the unknown.
                            </p>
                        </div>
                        <div class="space-y-12">
                            <div class="border-l-4 border-brand-blue pl-12 py-4">
                                <h3 class="text-2xl font-black text-slate-900 mb-4 tracking-tight">Smart MRV</h3>
                                <p class="text-lg text-slate-400 font-light">Deploying autonomousUSV swarms and fiber-optic well monitoring to increase precision.</p>
                            </div>
                            <div class="border-l-4 border-slate-200 pl-12 py-4">
                                <h3 class="text-2xl font-black text-slate-900 mb-4 tracking-tight">Unified Ground Model</h3>
                                <p class="text-lg text-slate-400 font-light">Fusing geophysics and geotechnics to eliminate complex project uncertainty.</p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-brand-blue/[0.03] p-16 rounded-5xl border border-brand-blue/5">
                        <h3 class="text-3xl font-black text-slate-900 mb-8 tracking-tight">Amplifying the Voice</h3>
                        <p class="text-xl text-slate-500 mb-12 font-light leading-relaxed max-w-2xl">
                            We curate industry-defining events like <strong class="text-brand-blue">Ocean Talks</strong>, bringing together geophysicists, engineers, and policymakers to debate the challenges of the blue economy.
                        </p>
                        <a href="https://rio25.sbgf.org.br/Pages/oceanHub.php" target="_blank" class="group inline-flex items-center text-brand-blue font-black uppercase tracking-[0.3em] text-xs gap-6 hover:gap-8 transition-all">
                            SBGf Rio 25 <i class="fa-solid fa-arrow-up-right-from-square text-sm group-hover:-translate-y-1 transition-transform"></i>
                        </a>
                    </div>
                </div>
                
                <div class="lg:col-span-5 space-y-12 lg:pt-32 reveal" style="transition-delay: 300ms">
                    <div class="bg-white p-12 rounded-4xl border border-slate-100 hover:shadow-2xl transition-all duration-700">
                        <div class="text-slate-300 text-6xl font-black mb-8 opacity-20 italic">01.</div>
                        <h3 class="text-3xl font-black text-slate-900 mb-4 tracking-tight text-brand-blue">Integration</h3>
                        <p class="text-xl text-slate-400 font-light leading-relaxed">Fusing diverse data streams to provide a unified ground model that streamlines complex project timelines.</p>
                    </div>
                    <div class="bg-slate-900 p-12 rounded-4xl text-white shadow-2xl relative overflow-hidden group">
                        <div class="absolute inset-0 bg-brand-blue opacity-50 group-hover:opacity-70 transition-opacity"></div>
                        <div class="relative z-10">
                            <div class="text-white/20 text-6xl font-black mb-8 italic">02.</div>
                            <h3 class="text-3xl font-black mb-4 tracking-tight">Innovation</h3>
                            <p class="text-xl text-white/70 font-light leading-relaxed">Deploying the right technology—from USV swarms to fiber-optics—to lower costs and increase precision.</p>
                        </div>
                    </div>
                    <div class="bg-white p-12 rounded-4xl border border-slate-100 hover:shadow-2xl transition-all duration-700">
                        <div class="text-slate-300 text-6xl font-black mb-8 opacity-20 italic">03.</div>
                        <h3 class="text-3xl font-black text-slate-900 mb-4 tracking-tight">Sustainability</h3>
                        <p class="text-xl text-slate-400 font-light leading-relaxed">Every dataset delivered is aimed at accelerating the global transition to net-zero energy systems.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

	<!-- Our Ecosystem -->
	<section class="section-padding bg-slate-50/50 border-y border-slate-100 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-brand-blue/[0.03] rounded-full blur-[150px] -mr-96 -mt-96"></div>
		<div class="max-w-[1800px] mx-auto px-8 md:px-16 relative z-10">
			<div class="max-w-4xl mb-32 reveal">
				<h2 class="heading-section">Open <br/>Ecosystem</h2>
				<p class="text-2xl text-slate-400 font-light leading-relaxed">
                    A collaborative network spanning the entire marine value chain.
                </p>
			</div>

			<div class="flex flex-wrap justify-center items-center gap-16 md:gap-40 reveal">
				<div class="flex flex-col items-center gap-8 group">
					<a href="https://www.bgp.com.cn" target="_blank" rel="noopener noreferrer" class="block transition-transform duration-700 group-hover:-translate-y-4">
					    <Image src={bgpLogo} alt="BGP Offshore" width={280} class="grayscale group-hover:grayscale-0 transition-all duration-1000 opacity-40 group-hover:opacity-100 w-56 md:w-72" />
                    </a>
					<span class="text-[10px] font-black text-slate-300 uppercase tracking-[0.5em] group-hover:text-brand-blue transition-colors">Geophysical Partner</span>
				</div>
				<div class="flex flex-col items-center gap-8 group">
					<a href="https://www.peneson.com" target="_blank" rel="noopener noreferrer" class="block transition-transform duration-700 group-hover:-translate-y-4">
					    <Image src={penesonLogo} alt="Guangzhou Peneson" width={280} class="grayscale group-hover:grayscale-0 transition-all duration-1000 opacity-40 group-hover:opacity-100 w-56 md:w-72" />
                    </a>
					<span class="text-[10px] font-black text-slate-300 uppercase tracking-[0.5em] group-hover:text-brand-blue transition-colors">Geotechnical Partner</span>
				</div>
				<div class="flex flex-col items-center gap-8 group">
					<div class="w-56 md:w-72 h-20 md:h-24 border border-dashed border-slate-200 rounded-4xl flex items-center justify-center text-slate-300 text-sm font-black uppercase tracking-widest group-hover:border-brand-blue group-hover:text-brand-blue transition-all duration-700 cursor-pointer hover:bg-white shadow-sm group-hover:shadow-2xl group-hover:-translate-y-4">
					    Join Us
					</div>
					<span class="text-[10px] font-black text-slate-300 uppercase tracking-[0.5em] group-hover:text-brand-blue transition-colors">Become a Partner</span>
				</div>
			</div>
		</div>
	</section>

	<!-- Final CTA -->
	<section class="section-padding bg-brand-blue text-white relative overflow-hidden">
		<div class="max-w-[1800px] mx-auto px-8 md:px-16 text-center relative z-20 reveal">
			<h2 class="text-7xl md:text-9xl font-black mb-20 tracking-tighter leading-[1]">Ready for the <br/><span class="text-white/20">Future.</span></h2>
			<p class="text-2xl md:text-3xl text-slate-300 mb-24 max-w-3xl mx-auto font-light leading-relaxed">
				Join the OceanHub ecosystem to accelerate your offshore energy initiatives.
			</p>
			<div class="flex flex-wrap justify-center gap-12">
				<a href="https://rio25.sbgf.org.br/Pages/oceanHub.php" target="_blank" class="bg-white text-brand-blue hover:bg-slate-100 px-16 py-8 rounded-full font-black uppercase tracking-[0.3em] text-sm transition-all shadow-2xl shadow-brand-blue/60 hover:-translate-y-2 active:translate-y-0">
					Ocean Talks @ SBGf
				</a>
				<a href="mailto:info@oceanhub.com" class="bg-transparent border-2 border-white/20 hover:border-white hover:bg-white/10 px-16 py-8 rounded-full font-black uppercase tracking-[0.3em] text-sm transition-all text-center">
					Get In Touch
				</a>
			</div>
		</div>
        <div class="absolute top-0 right-0 -mt-64 -mr-64 w-[1000px] h-[1000px] bg-white/[0.02] rounded-full blur-[150px] z-10"></div>
        <div class="absolute bottom-0 left-0 -mb-64 -ml-64 w-[1000px] h-[1000px] bg-black/20 rounded-full blur-[150px] z-10"></div>
	</section>
</Layout>

<style>
    /* Custom spacing adjustments for hero */
    @media (min-height: 800px) {
        .min-h-screen {
            min-height: 85vh;
        }
    }
</style>
