  <!-- Client-side Interactive HUD & Matrix Controller -->
  <script>
    // 1. Interactive HUD Channel Switcher & Live Canvas Engine
    const tabs = document.querySelectorAll('.hud-tab');
    const panes = document.querySelectorAll('.hud-pane');
    const modeTag = document.getElementById('canvas-mode-tag');
    const statusTag = document.getElementById('canvas-status-tag');
    const freqTag = document.getElementById('canvas-freq-tag');
    const canvas = document.getElementById('hud-telemetry-canvas') as HTMLCanvasElement | null;

    let activeChannel = 0;
    const modeMeta = [
      { mode: 'SEISMIC STREAM 3D', status: 'GEOHAZARD: CLEAR', statusColor: '#10B981', freq: 'SAMPLING: 2.0 kHz · TIME-SERIES' },
      { mode: 'CPTu IN-SITU PROFILE', status: 'THRUST: NORMAL', statusColor: '#38BDF8', freq: 'SAMPLING: 10 Hz · DEPTH-SERIES' },
      { mode: '4D DAS FIBER OPTIC', status: 'CAPROCK: SEALED', statusColor: '#10B981', freq: 'SAMPLING: 5.0 kHz · ACOUSTIC INTERFEROMETRY' },
      { mode: 'PAM HYDROPHONE FFT', status: 'ZONE: MONITORED', statusColor: '#10B981', freq: 'SAMPLING: 192 kHz · FULL-SPECTRUM' }
    ];

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const channel = Number(tab.getAttribute('data-channel') || '0');
        activeChannel = channel;
        tabs.forEach((t) => {
          t.classList.remove('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-400/40');
          t.classList.add('text-slate-400', 'border-transparent');
        });
        tab.classList.add('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-400/40');
        tab.classList.remove('text-slate-400', 'border-transparent');

        panes.forEach((pane) => {
          pane.classList.add('hidden');
        });
        const activePane = document.getElementById(`pane-${channel}`);
        activePane?.classList.remove('hidden');

        if (modeMeta[channel]) {
          if (modeTag) modeTag.textContent = modeMeta[channel].mode;
          if (statusTag) {
            statusTag.textContent = modeMeta[channel].status;
            statusTag.style.color = modeMeta[channel].statusColor;
          }
          if (freqTag) freqTag.textContent = modeMeta[channel].freq;
        }
      });
    });

    // 2. High-Performance Procedural Telemetry Canvas Simulation
    if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const ctx = canvas.getContext('2d');
      let animId = 0;
      let tick = 0;
      let running = true;

      function resize() {
        if (!canvas) return;
        const rect = canvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(rect.width * dpr);
        canvas.height = Math.round(rect.height * dpr);
        ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function draw() {
        if (!ctx || !canvas || !running) return;
        const w = canvas.getBoundingClientRect().width;
        const h = canvas.getBoundingClientRect().height;
        ctx.clearRect(0, 0, w, h);
        tick += 0.03;

        // Draw background grid lines
        ctx.strokeStyle = 'rgba(0, 240, 255, 0.07)';
        ctx.lineWidth = 1;
        for (let x = 0; x < w; x += 30) {
          ctx.beginPath();
          ctx.moveTo(x, 0);
          ctx.lineTo(x, h);
          ctx.stroke();
        }
        for (let y = 0; y < h; y += 20) {
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(w, y);
          ctx.stroke();
        }

        if (activeChannel === 0) {
          // Channel 0: 3D Seismic Wiggle Waveform Stream
          const numTraces = 5;
          for (let t = 0; t < numTraces; t++) {
            const baseY = 20 + t * 14;
            ctx.beginPath();
            for (let x = 0; x < w; x += 2) {
              const freq = 0.045 + t * 0.008;
              const amp = Math.sin(x * freq + tick * 1.8 + t) * Math.cos(x * 0.015 - tick * 0.8) * 8;
              const y = baseY + amp;
              if (x === 0) ctx.moveTo(x, y);
              else ctx.lineTo(x, y);
            }
            ctx.strokeStyle = t === 2 ? 'rgba(0, 240, 255, 0.9)' : 'rgba(14, 165, 233, 0.4)';
            ctx.lineWidth = t === 2 ? 1.8 : 1.0;
            ctx.stroke();
          }

          // Sweeping radar scan line
          const scanX = ((tick * 40) % (w + 40)) - 20;
          const grad = ctx.createLinearGradient(scanX - 25, 0, scanX, 0);
          grad.addColorStop(0, 'rgba(0, 240, 255, 0)');
          grad.addColorStop(1, 'rgba(0, 240, 255, 0.35)');
          ctx.fillStyle = grad;
          ctx.fillRect(scanX - 25, 0, 25, h);

        } else if (activeChannel === 1) {
          // Channel 1: CPTu In-Situ Stratigraphy & Cone Resistance Profile
          ctx.beginPath();
          const midY = h * 0.5;
          for (let x = 0; x < w; x += 3) {
            // Simulated stratified soil layer resistance with localized spikes (boulders/hard layers)
            const noise = Math.sin(x * 0.08 + tick * 0.5) * 4 + Math.sin(x * 0.25) * 8;
            const spike = (x > w * 0.35 && x < w * 0.42) ? 18 : 0;
            const y = midY - (noise + spike);
            if (x === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          ctx.strokeStyle = 'rgba(56, 189, 248, 0.9)';
          ctx.lineWidth = 2;
          ctx.stroke();

          // Bottom fill for soil resistance area
          ctx.lineTo(w, h);
          ctx.lineTo(0, h);
          ctx.fillStyle = 'rgba(56, 189, 248, 0.08)';
          ctx.fill();

          // Pore pressure curve (u2)
          ctx.beginPath();
          for (let x = 0; x < w; x += 4) {
            const u2 = midY + 12 + Math.sin(x * 0.05 + tick) * 6;
            if (x === 0) ctx.moveTo(x, u2);
            else ctx.lineTo(x, u2);
          }
          ctx.strokeStyle = 'rgba(16, 185, 129, 0.7)';
          ctx.lineWidth = 1.2;
          ctx.setLineDash([3, 3]);
          ctx.stroke();
          ctx.setLineDash([]);

        } else if (activeChannel === 2) {
          // Channel 2: 4D DAS Optical Fiber Strain Pulse Packet
          const midY = h * 0.5;
          ctx.beginPath();
          for (let x = 0; x < w; x += 2) {
            // Gaussian modulated packet traveling along fiber
            const packetCenter = ((tick * 50) % (w + 80)) - 40;
            const dist = x - packetCenter;
            const envelope = Math.exp(-(dist * dist) / 450);
            const carrier = Math.sin(x * 0.3);
            const strainAmp = envelope * carrier * 28;
            const y = midY + strainAmp + Math.sin(x * 0.03 + tick) * 2;
            if (x === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          ctx.strokeStyle = 'rgba(0, 240, 255, 0.95)';
          ctx.lineWidth = 2;
          ctx.stroke();

          // Upper and lower caprock seal safety envelope limits
          ctx.strokeStyle = 'rgba(16, 185, 129, 0.4)';
          ctx.lineWidth = 1;
          ctx.setLineDash([4, 4]);
          ctx.beginPath();
          ctx.moveTo(0, midY - 30); ctx.lineTo(w, midY - 30);
          ctx.moveTo(0, midY + 30); ctx.lineTo(w, midY + 30);
          ctx.stroke();
          ctx.setLineDash([]);

        } else if (activeChannel === 3) {
          // Channel 3: PAM Hydrophone 32-band FFT Spectrum Analyzer
          const numBars = 36;
          const barWidth = (w - (numBars * 3)) / numBars;
          for (let i = 0; i < numBars; i++) {
            const freqNorm = i / numBars;
            // Simulated bio-acoustic peaks (low whale whistles on left, click spikes on right)
            let baseH = Math.sin(freqNorm * Math.PI + tick * 2 + i * 0.3) * 16 + 18;
            if (i > 24 && i < 28) {
              // Cetacean 85kHz peak spike
              baseH += Math.abs(Math.sin(tick * 5)) * 32;
            }
            const barH = Math.max(4, Math.min(h - 10, baseH));
            const x = i * (barWidth + 3);
            const y = h - barH - 4;

            const barGrad = ctx.createLinearGradient(x, y, x, h);
            if (i > 24 && i < 28) {
              barGrad.addColorStop(0, 'rgba(0, 240, 255, 0.95)');
              barGrad.addColorStop(1, 'rgba(16, 185, 129, 0.4)');
            } else {
              barGrad.addColorStop(0, 'rgba(16, 185, 129, 0.8)');
              barGrad.addColorStop(1, 'rgba(14, 165, 233, 0.2)');
            }
            ctx.fillStyle = barGrad;
            ctx.fillRect(x, y, barWidth, barH);
          }
        }

        animId = requestAnimationFrame(draw);
      }

      resize();
      window.addEventListener('resize', resize, { passive: true });
      animId = requestAnimationFrame(draw);

      document.addEventListener('visibilitychange', () => {
        running = !document.hidden;
        if (running && !animId) animId = requestAnimationFrame(draw);
      });
    }

    // 3. Subtle Live Telemetry Value Flickers
    setInterval(() => {
      const zEl = document.getElementById('seismic-depth-val');
      if (zEl && activeChannel === 0) {
        const val = (248.5 + (Math.random() - 0.5) * 0.4).toFixed(1);
        zEl.textContent = `${val} m`;
      }
      const qcEl = document.getElementById('cptu-qc-val');
      if (qcEl && activeChannel === 1) {
        const val = (42.8 + (Math.random() - 0.5) * 0.3).toFixed(1);
        qcEl.textContent = `${val} MPa`;
      }
      const strainEl = document.getElementById('ccus-strain-val');
      if (strainEl && activeChannel === 2) {
        const val = (0.012 + (Math.random() - 0.5) * 0.002).toFixed(3);
        strainEl.textContent = `±${val} με`;
      }
      const pamEl = document.getElementById('pam-peak-val');
      if (pamEl && activeChannel === 3) {
        const val = (85.2 + (Math.random() - 0.5) * 0.2).toFixed(1);
        pamEl.textContent = `${val} kHz`;
      }
    }, 1800);

    // 4. Interactive Stage Filter Pills
    const stagePills = document.querySelectorAll('.stage-pill');
    const stageCards = document.querySelectorAll('.stage-card');

    stagePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const stage = pill.getAttribute('data-stage');
        stagePills.forEach((p) => {
          p.classList.remove('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-400/40');
          p.classList.add('text-slate-400', 'border-white/10', 'bg-white/5');
        });
        pill.classList.add('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-400/40');
        pill.classList.remove('text-slate-400', 'border-white/10', 'bg-white/5');

        stageCards.forEach((card) => {
          const cardStages = card.getAttribute('data-stages') || '';
          if (stage === 'all' || cardStages.includes(stage || '')) {
            card.classList.remove('hidden', 'opacity-30');
            card.classList.add('opacity-100');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  </script>
</Layout>
