---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
const focusAreas = await getCollection('focus-areas');
const sortedFocusAreas = focusAreas.sort((a, b) => a.data.order - b.data.order);

const iconMap: Record<string, { icon: string; badge: string }> = {
  ccus: { icon: 'fa-cloud-arrow-up', badge: 'CARBON STORAGE' },
  'marine-ecology': { icon: 'fa-leaf', badge: 'ENVIRONMENT' },
  'offshore-energy': { icon: 'fa-wind', badge: 'SITE DEVELOPMENT' },
  'offshore-infrastructure': { icon: 'fa-anchor', badge: 'ASSET INTEGRITY' }
};
---

<Layout title="Offshore Focus Areas | OceanHub" description="Explore OceanHub focus areas across offshore CCUS, renewable energy, infrastructure and marine ecology.">
  <section class="py-20 md:py-32">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16 reveal">
        <div class="hud-badge mb-4"><i class="fa-solid fa-layer-group" aria-hidden="true"></i> OFFSHORE PROBLEM SPACES</div>
        <h1 class="heading-section">Four connected focus areas</h1>
        <p class="text-lg text-slate-300 font-light leading-relaxed">Each area links a practical offshore decision to the observations, interpretation and specialist capabilities needed to support it.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedFocusAreas.map((area, index) => (
          <a href={url(`focus-areas/${area.slug}/`)} class="glass-card p-8 md:p-10 flex flex-col justify-between group reveal" style={`transition-delay: ${index * 100}ms;`}>
            <div>
              <div class="flex items-center justify-between mb-8">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-500/15 to-blue-600/20 border border-cyan-400/30 flex items-center justify-center text-cyan-400 group-hover:bg-cyan-500 group-hover:text-slate-950 transition-all">
                  <i class={`fa-solid ${iconMap[area.slug]?.icon || 'fa-anchor'} text-2xl`} aria-hidden="true"></i>
                </div>
                <span class="hud-badge text-[10px]">{iconMap[area.slug]?.badge || 'OFFSHORE'}</span>
              </div>
              <h2 class="text-2xl md:text-3xl font-black text-white mb-4 tracking-tight group-hover:text-cyan-300 transition-colors font-display">{area.data.title}</h2>
              <p class="text-slate-400 mb-8 font-light leading-relaxed text-sm md:text-base">{area.data.description}</p>
            </div>
            <div class="pt-6 border-t border-white/10 flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider">View problem and approach</span>
              <i class="fa-solid fa-arrow-right text-cyan-400" aria-hidden="true"></i>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
