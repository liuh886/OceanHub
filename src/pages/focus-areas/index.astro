---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const focusAreas = await getCollection('focus-areas');
const sortedFocusAreas = focusAreas.sort((a, b) => a.data.order - b.data.order);

const iconMap: Record<string, { icon: string; badge: string }> = {
  'ccus': { icon: 'fa-cloud-arrow-up', badge: 'DEEP STORAGE' },
  'marine-ecology': { icon: 'fa-leaf', badge: 'BIO-SURVEY' },
  'offshore-energy': { icon: 'fa-bolt-lightning', badge: 'WIND & SOLAR' },
  'offshore-infrastructure': { icon: 'fa-anchor', badge: 'GEO-RIGOUR' }
};
---

<Layout title="Strategic Focus Areas | OceanHub" description="Explore our strategic initiatives for Offshore Wind, CCS, and Marine Engineering.">
	<section class="py-20 md:py-32">
		<div class="max-w-7xl mx-auto px-6">
			<div class="text-center max-w-3xl mx-auto mb-20 reveal">
				<div class="hud-badge mb-4">
					<i class="fa-solid fa-layer-group"></i> STRATEGIC PORTFOLIO
				</div>
				<h1 class="heading-section">
					Core Strategic <br/>
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-sky-300 glow-text-cyan">
						Focus Areas
					</span>
				</h1>
				<p class="text-lg text-slate-300 font-light leading-relaxed">
					From geophysical subsurface imaging to geotechnical seabed sampling, we provide certified data certainty for complex offshore projects.
				</p>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				{sortedFocusAreas.map((area, index) => (
					<a href={`/focus-areas/${area.slug}`} class="glass-card p-8 md:p-10 flex flex-col justify-between group reveal" style={`transition-delay: ${index * 100}ms;`}>
						<div>
							<div class="flex items-center justify-between mb-8">
								<div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-500/15 to-blue-600/20 border border-cyan-400/30 flex items-center justify-center text-cyan-400 group-hover:scale-110 group-hover:bg-cyan-500 group-hover:text-slate-950 transition-all duration-500 shadow-[0_0_20px_rgba(0,240,255,0.15)]">
									<i class={`fa-solid ${iconMap[area.slug]?.icon || 'fa-anchor'} text-2xl`}></i>
								</div>
								<span class="hud-badge text-[10px]">
									{iconMap[area.slug]?.badge || 'INITIATIVE'}
								</span>
							</div>

							<h2 class="text-2xl md:text-3xl font-black text-white mb-4 tracking-tight group-hover:text-cyan-300 transition-colors font-display">
								{area.data.title}
							</h2>
							<p class="text-slate-400 mb-8 font-light leading-relaxed text-sm md:text-base">
								{area.data.description}
							</p>
						</div>

						<div class="pt-6 border-t border-white/10 flex items-center justify-between">
							<span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider group-hover:text-cyan-300">
								Inspect Initiative
							</span>
							<i class="fa-solid fa-arrow-right text-cyan-400 group-hover:translate-x-2 transition-transform"></i>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>
</Layout>
