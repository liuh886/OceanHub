---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const focusAreaEntries = await getCollection('focus-areas');
  return focusAreaEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | OceanHub Initiatives`} description={entry.data.description}>
  <article class="max-w-4xl mx-auto px-6 py-16 md:py-24">
    <!-- Header -->
    <header class="mb-14 reveal">
      <a href="/focus-areas" class="inline-flex items-center gap-2 text-xs font-mono font-bold text-cyan-400 hover:text-cyan-300 uppercase tracking-widest mb-6 transition-colors">
        <i class="fa-solid fa-arrow-left text-xs"></i>
        <span>Back to Focus Areas</span>
      </a>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6 font-display">
        {entry.data.title}
      </h1>
      <p class="text-lg md:text-xl text-slate-300 font-light leading-relaxed">
        {entry.data.description}
      </p>
    </header>

    <!-- Key Pain Points & Strategic Benefits Dual HUD Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16 reveal">
      <!-- Pain Points -->
      <div class="glass-card p-8 border-rose-500/30 shadow-[0_0_25px_rgba(244,63,94,0.05)]">
        <h3 class="text-rose-400 font-mono font-bold text-sm uppercase tracking-wider mb-6 flex items-center gap-2.5">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <span>Critical Pain Points</span>
        </h3>
        <ul class="space-y-4">
          {entry.data.painPoints.map((item) => (
            <li class="text-slate-300 text-sm font-light flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 bg-rose-400 rounded-full shrink-0"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Strategic Benefits -->
      <div class="glass-card p-8 border-emerald-500/30 shadow-[0_0_25px_rgba(16,185,129,0.05)]">
        <h3 class="text-emerald-400 font-mono font-bold text-sm uppercase tracking-wider mb-6 flex items-center gap-2.5">
          <i class="fa-solid fa-circle-check"></i>
          <span>Strategic Benefits</span>
        </h3>
        <ul class="space-y-4">
          {entry.data.benefits.map((item) => (
            <li class="text-slate-300 text-sm font-light flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 bg-emerald-400 rounded-full shrink-0"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Main Markdown Content -->
    <div class="prose prose-invert prose-cyan max-w-none reveal">
      <Content />
    </div>

    <!-- Bottom Action Portal -->
    <div class="mt-20 p-10 rounded-3xl glass-card text-center border-cyan-500/30 reveal">
      <div class="hud-badge mb-4">
        <i class="fa-solid fa-handshake-angle"></i> ALLIANCE ENGAGEMENT
      </div>
      <h3 class="text-2xl md:text-3xl font-black text-white mb-4 font-display">Deploy this Initiative</h3>
      <p class="text-slate-400 text-sm md:text-base max-w-xl mx-auto mb-8 font-light">
        Collaborate with OceanHub to integrate certified data models and autonomous sensor arrays for your offshore project.
      </p>
      <a href="mailto:info@oceanhub.com" class="inline-flex items-center gap-3 px-8 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-black text-xs uppercase tracking-widest shadow-[0_0_25px_rgba(0,240,255,0.3)] transition-all">
        <span>Partner with Us</span>
        <i class="fa-solid fa-arrow-right text-xs"></i>
      </a>
    </div>
  </article>
</Layout>

<style is:global>
  @reference "../../styles/global.css";
  /* Enhanced Prose Styling for Tech Dark Mode */
  .prose h2 { @apply text-2xl md:text-3xl font-black text-white mt-12 mb-6 font-display border-b border-white/10 pb-3; }
  .prose h3 { @apply text-xl md:text-2xl font-bold text-cyan-300 mt-8 mb-4 font-display; }
  .prose p { @apply text-slate-300 font-light leading-relaxed mb-6 text-base; }
  .prose ul { @apply list-disc list-inside text-slate-300 space-y-2.5 mb-6 text-sm md:text-base; }
  .prose li { @apply marker:text-cyan-400; }
  .prose strong { @apply text-white font-semibold; }
  .prose blockquote { @apply border-l-2 border-cyan-400 pl-4 py-2 italic text-slate-300 bg-cyan-950/20 rounded-r-xl; }
</style>
