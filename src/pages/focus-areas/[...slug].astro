---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const focusAreaEntries = await getCollection('focus-areas');
  return focusAreaEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | OceanHub Initiatives`} description={entry.data.description}>
  <article class="max-w-4xl mx-auto px-4 py-20">
    <header class="mb-12">
      <a href="/focus-areas" class="text-blue-600 text-sm font-semibold mb-4 inline-block hover:underline">← Back to Focus Areas</a>
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6">{entry.data.title}</h1>
      <p class="text-xl text-slate-600 leading-relaxed">{entry.data.description}</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <div class="bg-red-50 p-8 rounded-2xl border border-red-100">
        <h3 class="text-red-900 font-bold mb-4 flex items-center gap-2">
          <span>⚠️</span> Key Pain Points
        </h3>
        <ul class="space-y-3">
          {entry.data.painPoints.map((item) => (
            <li class="text-red-700 flex items-start gap-2">
              <span class="mt-1.5 w-1.5 h-1.5 bg-red-400 rounded-full shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-emerald-50 p-8 rounded-2xl border border-emerald-100">
        <h3 class="text-emerald-900 font-bold mb-4 flex items-center gap-2">
          <span>鉁</span> Strategic Benefits
        </h3>
        <ul class="space-y-3">
          {entry.data.benefits.map((item) => (
            <li class="text-emerald-700 flex items-start gap-2">
              <span class="mt-1.5 w-1.5 h-1.5 bg-emerald-400 rounded-full shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="prose prose-slate prose-lg max-w-none">
      <Content />
    </div>

    <div class="mt-20 pt-10 border-t border-slate-200 text-center">
      <h3 class="text-2xl font-bold mb-6">Interested in this initiative?</h3>
      <button class="bg-blue-600 text-white px-10 py-4 rounded-full font-bold text-lg hover:bg-blue-700 transition-all shadow-lg">
        Partner with Us
      </button>
    </div>
  </article>
</Layout>

<style is:global>
  @reference "../../styles/global.css";
  /* Basic prose styling for Markdown content */
  .prose h2 { @apply text-3xl font-bold text-slate-900 mt-12 mb-6; }
  .prose h3 { @apply text-2xl font-bold text-slate-800 mt-8 mb-4; }
  .prose p { @apply text-slate-600 leading-relaxed mb-6; }
  .prose ul { @apply list-disc list-inside text-slate-600 space-y-2 mb-6; }
  .prose li { @apply marker:text-blue-500; }
</style>
