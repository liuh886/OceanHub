---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const focusAreaEntries = await getCollection('focus-areas');
  return focusAreaEntries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | OceanHub`} description={entry.data.description}>
  <article class="max-w-4xl mx-auto px-6 py-16 md:py-24">
    <header class="mb-14 reveal">
      <a href={url('focus-areas/')} class="inline-flex items-center gap-2 text-xs font-mono font-bold text-cyan-400 hover:text-cyan-300 uppercase tracking-widest mb-6 transition-colors">
        <i class="fa-solid fa-arrow-left text-xs" aria-hidden="true"></i>
        <span>Back to Focus Areas</span>
      </a>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6 font-display">{entry.data.title}</h1>
      <p class="text-lg md:text-xl text-slate-300 font-light leading-relaxed">{entry.data.description}</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16 reveal">
      <section class="glass-card p-8 border-amber-500/25" aria-labelledby="decision-risks-title">
        <h2 id="decision-risks-title" class="text-amber-300 font-mono font-bold text-sm uppercase tracking-wider mb-6 flex items-center gap-2.5">
          <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
          <span>Decision risks</span>
        </h2>
        <ul class="space-y-4">
          {entry.data.painPoints.map((item) => (
            <li class="text-slate-300 text-sm font-light flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 bg-amber-300 rounded-full shrink-0"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="glass-card p-8 border-cyan-500/25" aria-labelledby="evidence-outcomes-title">
        <h2 id="evidence-outcomes-title" class="text-cyan-300 font-mono font-bold text-sm uppercase tracking-wider mb-6 flex items-center gap-2.5">
          <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
          <span>Evidence outcomes</span>
        </h2>
        <ul class="space-y-4">
          {entry.data.benefits.map((item) => (
            <li class="text-slate-300 text-sm font-light flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 bg-cyan-300 rounded-full shrink-0"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div class="prose prose-invert prose-cyan max-w-none reveal">
      <Content />
    </div>

    <section class="mt-20 p-8 md:p-10 rounded-3xl glass-card text-center border-cyan-500/30 reveal" aria-labelledby="collaboration-title">
      <div class="hud-badge mb-4"><i class="fa-solid fa-handshake-angle" aria-hidden="true"></i> COLLABORATION</div>
      <h2 id="collaboration-title" class="text-2xl md:text-3xl font-black text-white mb-4 font-display">Start with your project decision</h2>
      <p class="text-slate-400 text-sm md:text-base max-w-xl mx-auto mb-8 font-light">Share the offshore question, existing evidence and unresolved uncertainty. OceanHub can help frame a practical capability and data pathway.</p>
      <a href="mailto:info@oceanhub.com" class="inline-flex items-center gap-3 px-8 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-black text-xs uppercase tracking-widest transition-all">
        <span>Propose a Collaboration</span>
        <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
      </a>
    </section>
  </article>
</Layout>

<style is:global>
  @reference "../../styles/global.css";
  .prose h2 { @apply text-2xl md:text-3xl font-black text-white mt-12 mb-6 font-display border-b border-white/10 pb-3; }
  .prose h3 { @apply text-xl md:text-2xl font-bold text-cyan-300 mt-8 mb-4 font-display; }
  .prose p { @apply text-slate-300 font-light leading-relaxed mb-6 text-base; }
  .prose ul { @apply list-disc list-outside ml-6 text-slate-300 space-y-2.5 mb-6 text-sm md:text-base; }
  .prose li { @apply marker:text-cyan-400 pl-1; }
  .prose strong { @apply text-white font-semibold; }
  .prose blockquote { @apply border-l-2 border-cyan-400 pl-4 py-2 italic text-slate-300 bg-cyan-950/20 rounded-r-xl; }
</style>
