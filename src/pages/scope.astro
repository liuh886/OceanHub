---
import Layout from '../layouts/Layout.astro';
import DecisionScoper from '../components/DecisionScoper.astro';
import ProjectEOI from '../components/ProjectEOI.astro';
---

<Layout
  title="Scope an Offshore Project | OceanHub"
  description="Turn an offshore project decision into a traceable evidence plan, supplier EOI and transparent capability-based provider shortlist."
>
  <section class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:px-8 md:pb-12 md:pt-24">
    <div class="max-w-4xl">
      <p class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.18em] text-cyan-300">Scope a Project</p>
      <h1 class="font-display text-4xl font-black leading-tight tracking-tight text-white sm:text-6xl">
        Start with the decision, then turn evidence into an EOI.
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-300">
        Define the lifecycle stage and decision focus. OceanHub traces the evidence and canonical capability needs, then converts them into a supplier EOI and an explainable market shortlist without hidden supplier scores.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-20 sm:px-8 md:pb-28">
    <DecisionScoper />
    <ProjectEOI />
  </section>
</Layout>
