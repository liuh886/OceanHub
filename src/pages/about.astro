---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import bgpLogo from '../assets/bgp-logo.png';
import penesonLogo from '../assets/peneson-logo.png';

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
---

<Layout
  title="Platform Mission | OceanHub"
  description="OceanHub connects offshore operators, geophysics, geotechnics and marine environmental partners around decision-ready evidence."
>
  <!-- Mission Hero -->
  <section class="relative py-24 md:py-36 overflow-hidden">
    <div class="max-w-5xl mx-auto px-6 sm:px-8 text-center relative z-10">
      <div class="hud-badge mb-6 reveal">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse mr-1"></span>
        <i class="fa-solid fa-handshake" aria-hidden="true"></i> GREEN OFFSHORE TECHNOLOGY ALLIANCE
      </div>
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-black text-white tracking-tight mb-8 font-display reveal" style="transition-delay: 80ms;">
        Exploring next-generation<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-400 to-sky-300 glow-text-cyan">
          green offshore engineering.
        </span>
      </h1>
      <p class="text-xl md:text-2xl text-slate-300 max-w-3xl mx-auto leading-relaxed font-light mb-10 reveal" style="transition-delay: 140ms;">
        OceanHub is a collaborative marine innovation alliance dedicated to exploring next-generation green engineering technologies and launching Joint Industry Projects (JIPs) that power sustainable ocean development.
      </p>
      <div class="flex flex-wrap justify-center gap-4 reveal" style="transition-delay: 200ms;">
        <a href={url('jips/')} class="px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-400 to-cyan-500 hover:from-emerald-300 hover:to-cyan-400 text-slate-950 font-black uppercase tracking-wider text-xs transition-all shadow-[0_0_25px_rgba(16,185,129,0.3)]">
          Explore Joint Projects (JIPs)
        </a>
        <button
          type="button"
          data-open-alliance-modal
          class="px-8 py-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/15 text-white font-bold uppercase tracking-wider text-xs transition-all flex items-center gap-2"
        >
          <i class="fa-solid fa-user-plus text-xs text-cyan-400" aria-hidden="true"></i>
          <span>Join Alliance Network</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Why OceanHub Deep Breakdown -->
  <section class="py-16 relative">
    <div class="max-w-6xl mx-auto px-6 sm:px-8">
      <div class="glass-card p-8 md:p-16 reveal border-cyan-500/25">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <div class="lg:col-span-5">
            <div class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-widest mb-4">THE CORE CHALLENGE</div>
            <h2 class="text-3xl sm:text-4xl font-black text-white font-display leading-tight">
              Offshore evidence crosses organisational silos.
            </h2>
          </div>
          <div class="lg:col-span-7 space-y-6 text-base md:text-lg text-slate-300 leading-relaxed font-light">
            <p>
              Offshore wind foundations, sub-seabed carbon storage, deepwater pipeline corridors, and ecological baselines depend on the same fundamental observations: high-resolution bathymetry, shallow stratigraphy, in-situ soil mechanics, ocean dynamics, and acoustic fields.
            </p>
            <p>
              Historically, these data streams are acquired by disconnected survey contractors, analyzed in disciplinary isolation, and delivered as static PDF deliverables for isolated milestones. OceanHub breaks these silos by establishing a continuous, decision-focused collaboration layer.
            </p>
            <p>
              We do not seek to replace operators, engineering consultancies, or sensor manufacturers. Instead, OceanHub aligns these specialized capabilities around unambiguous project questions and decision interfaces.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Operating Principles Grid -->
  <section class="py-24">
    <div class="max-w-[1760px] mx-auto px-6 sm:px-8 md:px-12">
      <div class="text-center max-w-3xl mx-auto mb-16 reveal">
        <div class="hud-badge mb-4">
          <i class="fa-solid fa-diagram-project" aria-hidden="true"></i> OPERATING PROTOCOL
        </div>
        <h2 class="heading-section">A simple, transparent collaboration model</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <article class="glass-card-interactive p-8 md:p-10 rounded-3xl reveal">
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-mono font-bold text-cyan-400">01 / FRAME</span>
            <span class="w-8 h-8 rounded-xl bg-cyan-500/10 flex items-center justify-center text-cyan-300 font-mono text-xs font-bold">01</span>
          </div>
          <h3 class="text-2xl font-black text-white mb-4 font-display">Start with the decision</h3>
          <p class="text-slate-300 text-sm md:text-base leading-relaxed font-light">
            Clarify exactly what must be decided, synthesize known baseline data, isolate consequential uncertainties, and identify what empirical evidence would change the engineering or consenting choice.
          </p>
        </article>

        <article class="glass-card-interactive p-8 md:p-10 rounded-3xl reveal" style="transition-delay: 100ms;">
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-mono font-bold text-sky-400">02 / CONNECT</span>
            <span class="w-8 h-8 rounded-xl bg-sky-500/10 flex items-center justify-center text-sky-300 font-mono text-xs font-bold">02</span>
          </div>
          <h3 class="text-2xl font-black text-white mb-4 font-display">Assemble capability</h3>
          <p class="text-slate-300 text-sm md:text-base leading-relaxed font-light">
            Connect marine geophysical imaging fleets, deep in-situ geotechnics, ecological observation sensors, and geotechnical engineering models in a collaborative workflow.
          </p>
        </article>

        <article class="glass-card-interactive p-8 md:p-10 rounded-3xl reveal" style="transition-delay: 200ms;">
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-mono font-bold text-emerald-400">03 / DELIVER</span>
            <span class="w-8 h-8 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-300 font-mono text-xs font-bold">03</span>
          </div>
          <h3 class="text-2xl font-black text-white mb-4 font-display">Design outputs for use</h3>
          <p class="text-slate-300 text-sm md:text-base leading-relaxed font-light">
            Package provenance records, quantified uncertainty bounds, and unified risk models so decision-makers can audit, review, and leverage evidence across the entire asset lifecycle.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Ocean Talks @ SBGf Rio 25 Dialog Spotlight -->
  <section class="py-24 border-y border-cyan-500/15 bg-[#03060E]/85">
    <div class="max-w-[1760px] mx-auto px-6 sm:px-8 md:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 reveal">
          <div class="hud-badge mb-4">
            <i class="fa-solid fa-comments" aria-hidden="true"></i> INDUSTRY DIALOGUE
          </div>
          <h2 class="heading-section mb-6">Ocean Talks @ SBGf Rio 25</h2>
          <p class="text-slate-300 text-base md:text-xl leading-relaxed mb-8 font-light">
            OceanHub fosters public technical dialogues across geophysics, offshore renewable development, marine monitoring, and ocean policy. Ocean Talks convenes operators, academic institutions, and technology innovators.
          </p>
          <a href="https://rio25.sbgf.org.br/Pages/oceanHub.php" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-cyan-500/15 hover:bg-cyan-500/25 border border-cyan-400/40 text-cyan-200 font-mono text-xs font-bold uppercase tracking-wider transition-all shadow-[0_0_20px_rgba(0,240,255,0.2)]">
            <span>View SBGf Rio 25 Programme</span>
            <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
          </a>
        </div>

        <div class="lg:col-span-6 reveal" style="transition-delay: 120ms;">
          <div class="glass-card p-8 md:p-12 border-cyan-500/25">
            <h3 class="text-xl md:text-2xl text-white font-display font-bold leading-relaxed mb-6">
              "Effective technical dialogue connects geophysical and geotechnical methods directly to the engineering decisions and consenting constraints they resolve."
            </h3>
            <ul class="space-y-4 text-sm md:text-base text-slate-300">
              <li class="flex items-start gap-3">
                <span class="mt-2 w-2 h-2 rounded-full bg-cyan-400 shrink-0 shadow-[0_0_8px_rgba(0,240,255,0.8)]"></span>
                <span>Focus on practical offshore engineering problems rather than vendor hype.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-2 w-2 h-2 rounded-full bg-cyan-400 shrink-0 shadow-[0_0_8px_rgba(0,240,255,0.8)]"></span>
                <span>Make uncertainty bounds, resolution limits, and soil-structure mechanics explicit.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-2 w-2 h-2 rounded-full bg-cyan-400 shrink-0 shadow-[0_0_8px_rgba(0,240,255,0.8)]"></span>
                <span>Establish direct pathways for joint field trials, data sharing, and cross-discipline learning.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Founding Network Showcase -->
  <section class="py-28">
    <div class="max-w-6xl mx-auto px-6 sm:px-8 text-center">
      <div class="hud-badge mb-4 reveal">
        <i class="fa-solid fa-network-wired" aria-hidden="true"></i> FOUNDING NETWORK
      </div>
      <h2 class="text-3xl md:text-5xl font-black text-white mb-6 font-display reveal">
        Complementary capability, open architecture
      </h2>
      <p class="text-slate-300 max-w-2xl mx-auto mb-16 text-base md:text-lg font-light reveal">
        The founding network brings together global marine geophysical fleets with deepwater in-situ geotechnical capability. OceanHub remains open to all operators and technology partners.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 max-w-4xl mx-auto reveal">
        <div class="glass-card p-8 flex flex-col items-center justify-center group">
          <Image src={bgpLogo} alt="BGP Offshore" width={220} class="brightness-0 invert opacity-80 group-hover:opacity-100 transition-opacity mb-4 w-48" />
          <span class="text-[11px] font-mono font-bold text-cyan-400 uppercase tracking-widest">Marine Geophysics</span>
        </div>
        
        <div class="glass-card p-8 flex flex-col items-center justify-center group">
          <Image src={penesonLogo} alt="Guangzhou Peneson" width={220} class="brightness-0 invert opacity-80 group-hover:opacity-100 transition-opacity mb-4 w-48" />
          <span class="text-[11px] font-mono font-bold text-cyan-400 uppercase tracking-widest">Marine Geotechnics</span>
        </div>

        <div class="glass-card p-8 flex flex-col items-center justify-center border-dashed border-cyan-500/40 bg-gradient-to-b from-cyan-950/20 to-transparent">
          <div class="text-white font-bold text-lg mb-2 font-display">Join the Alliance</div>
          <p class="text-xs text-slate-300 mb-4 font-light">Operators, researchers & sensor providers</p>
          <button
            type="button"
            data-open-alliance-modal
            class="text-xs font-mono font-bold text-cyan-300 hover:text-cyan-200 uppercase tracking-wider flex items-center gap-1.5"
          >
            <span>Propose Collaboration →</span>
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>
