---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import bgpLogo from '../assets/bgp-logo.png';
import penesonLogo from '../assets/peneson-logo.png';
---

<Layout title="About Us | OceanHub Marine Intelligence Ecosystem" description="OceanHub is the ecosystem platform for marine data services, orchestrating the transition to a blue energy future.">
	<!-- Hero Section -->
	<section class="relative py-24 md:py-32 overflow-hidden">
		<div class="max-w-5xl mx-auto px-6 text-center relative z-10">
			<div class="hud-badge mb-6 reveal">
				<i class="fa-solid fa-compass"></i> PLATFORM MISSION & DNA
			</div>
			<h1 class="text-4xl sm:text-6xl md:text-7xl font-black text-white tracking-tight mb-8 font-display reveal" style="transition-delay: 100ms;">
				Orchestrating the <br/>
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-500 glow-text-cyan">
					Blue Energy Transition
				</span>
			</h1>
			<p class="text-lg md:text-2xl text-slate-300 max-w-3xl mx-auto leading-relaxed font-light reveal" style="transition-delay: 200ms;">
				The ocean is the ultimate frontier for global clean energy. OceanHub bridges the gap with certified data certainty and cross-domain engineering synergy.
			</p>
		</div>
	</section>

	<!-- Main Narrative & Vision -->
	<section class="py-16 relative">
		<div class="max-w-4xl mx-auto px-6">
			<div class="glass-card p-8 md:p-14 reveal">
				<div class="text-xl md:text-2xl text-slate-200 font-light leading-relaxed space-y-6">
					<p class="border-l-2 border-cyan-400 pl-6 text-white font-normal">
						OceanHub is building an open green technology ecosystem dedicated to the vision of <strong class="text-cyan-400">"Bridging Data, Energy & Future"</strong>.
					</p>
					<p class="text-base md:text-lg text-slate-400 leading-relaxed">
						The scale of offshore wind expansion, CCUS geological verification, and environmental monitoring exceeds the scope of any single company. Solving this requires breaking domain silos and establishing an integrated data framework.
					</p>
					<p class="text-base md:text-lg text-slate-400 leading-relaxed">
						By connecting offshore operators with specialized technology providers (such as BGP Offshore and Guangzhou Peneson), OceanHub delivers the Deep Blue Intelligence required to de-risk complex offshore capital investments.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Core Values (High-Tech 3-Pillar Matrix) -->
	<section class="py-20">
		<div class="max-w-7xl mx-auto px-6">
			<div class="text-center max-w-3xl mx-auto mb-16 reveal">
				<div class="hud-badge mb-4">
					<i class="fa-solid fa-microchip"></i> FOUNDATIONAL PRINCIPLES
				</div>
				<h2 class="heading-section">
					Our Core <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-sky-300">Pillars</span>
				</h2>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<!-- Pillar 1 -->
				<div class="glass-card p-8 group reveal">
					<div class="w-14 h-14 rounded-2xl bg-cyan-500/15 border border-cyan-400/30 text-cyan-400 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
						<i class="fa-solid fa-link"></i>
					</div>
					<div class="text-xs font-mono font-bold text-cyan-400 mb-2 uppercase tracking-widest">01 / CERTAINTY</div>
					<h3 class="text-2xl font-black text-white mb-4 font-display">Integration</h3>
					<p class="text-slate-400 text-sm md:text-base font-light leading-relaxed">
						Breaking down data silos. By fusing geophysics, geotechnics, and oceanography, we establish unified ground models that eliminate offshore project uncertainty.
					</p>
				</div>

				<!-- Pillar 2 -->
				<div class="glass-card p-8 group reveal" style="transition-delay: 150ms;">
					<div class="w-14 h-14 rounded-2xl bg-blue-500/15 border border-blue-400/30 text-blue-400 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
						<i class="fa-solid fa-satellite-dish"></i>
					</div>
					<div class="text-xs font-mono font-bold text-blue-400 mb-2 uppercase tracking-widest">02 / RIGOUR</div>
					<h3 class="text-2xl font-black text-white mb-4 font-display">Innovation</h3>
					<p class="text-slate-400 text-sm md:text-base font-light leading-relaxed">
						Championing "Smart MRV". From autonomous USV swarms to fiber-optic distributed acoustic sensing (DAS), we deploy agile tech to compress costs and elevate accuracy.
					</p>
				</div>

				<!-- Pillar 3 -->
				<div class="glass-card p-8 group reveal" style="transition-delay: 300ms;">
					<div class="w-14 h-14 rounded-2xl bg-emerald-500/15 border border-emerald-400/30 text-emerald-400 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
						<i class="fa-solid fa-seedling"></i>
					</div>
					<div class="text-xs font-mono font-bold text-emerald-400 mb-2 uppercase tracking-widest">03 / VELOCITY</div>
					<h3 class="text-2xl font-black text-white mb-4 font-display">Sustainability</h3>
					<p class="text-slate-400 text-sm md:text-base font-light leading-relaxed">
						Accelerating the transition. Every survey delivered and dataset unified is engineered to expedite gigatonne-scale net-zero infrastructure deployment.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Industry Leadership & Ocean Talks -->
	<section class="py-20 border-t border-cyan-500/10 bg-[#040810]/70">
		<div class="max-w-7xl mx-auto px-6">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
				<div class="lg:col-span-6 reveal">
					<div class="hud-badge mb-4">
						<i class="fa-solid fa-bullhorn"></i> DIALOGUE & ADVOCACY
					</div>
					<h2 class="heading-section mb-6">
						Amplifying the <br/>
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-sky-300">Industry Voice</span>
					</h2>
					<p class="text-slate-300 text-base md:text-lg leading-relaxed mb-6 font-light">
						OceanHub is more than a platform—we are an industry catalyst. Solving offshore clean energy challenges demands transparent debate, standardized marine data protocols, and global cross-border synergy.
					</p>
					<p class="text-slate-400 text-sm md:text-base leading-relaxed mb-8 font-light">
						Through the <strong>Ocean Talks</strong> dialogue series, we convene leading geophysicists, offshore wind developers, and regulators at events like SBGf Rio 25.
					</p>
					<a href="https://rio25.sbgf.org.br/Pages/oceanHub.php" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-6 py-3 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 border border-cyan-500/30 text-cyan-300 font-mono text-xs font-bold uppercase tracking-wider transition-all">
						<span>SBGf Rio 25 Program Details</span>
						<i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
					</a>
				</div>

				<div class="lg:col-span-6 reveal" style="transition-delay: 200ms;">
					<div class="glass-card p-8 md:p-10 border border-cyan-500/30 relative">
						<div class="flex items-center gap-3 text-cyan-400 text-xs font-mono font-bold uppercase tracking-widest mb-4">
							<i class="fa-solid fa-podcast"></i> Ocean Talks Initiative
						</div>
						<blockquote class="text-xl md:text-2xl text-white font-display font-medium leading-relaxed italic mb-8">
							"Where the technical rigour of geophysics meets the strategic urgency of the blue energy transition."
						</blockquote>
						<ul class="space-y-4 text-sm text-slate-300 font-light">
							<li class="flex items-center gap-3">
								<span class="w-2 h-2 rounded-full bg-cyan-400"></span>
								Curating high-level technical sessions and workshops
							</li>
							<li class="flex items-center gap-3">
								<span class="w-2 h-2 rounded-full bg-cyan-400"></span>
								Bridging academic discoveries with industrial deployments
							</li>
							<li class="flex items-center gap-3">
								<span class="w-2 h-2 rounded-full bg-cyan-400"></span>
								Advocating for standardized, open marine data frameworks
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Partner Alliance Grid -->
	<section class="py-20 border-t border-cyan-500/10">
		<div class="max-w-7xl mx-auto px-6 text-center">
			<div class="hud-badge mb-4 reveal">
				<i class="fa-solid fa-network-wired"></i> OPEN NETWORK
			</div>
			<h2 class="text-3xl md:text-4xl font-black text-white mb-6 font-display reveal">The Open Alliance</h2>
			<p class="text-slate-400 max-w-2xl mx-auto mb-16 text-sm md:text-base font-light reveal">
				From geophysical fleet owners to agile instrumentation startups, OceanHub unites best-in-class capability.
			</p>
			
			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 max-w-4xl mx-auto reveal">
				<div class="glass-card p-8 flex flex-col items-center justify-center">
					<Image src={bgpLogo} alt="BGP Offshore" width={200} class="brightness-0 invert opacity-80 hover:opacity-100 transition-opacity mb-4 w-44" />
					<span class="text-[11px] font-mono font-bold text-cyan-400 uppercase tracking-widest">Geophysical Leader</span>
				</div>
				<div class="glass-card p-8 flex flex-col items-center justify-center">
					<Image src={penesonLogo} alt="Guangzhou Peneson" width={200} class="brightness-0 invert opacity-80 hover:opacity-100 transition-opacity mb-4 w-44" />
					<span class="text-[11px] font-mono font-bold text-cyan-400 uppercase tracking-widest">Geotechnical Specialist</span>
				</div>
				<div class="glass-card p-8 flex flex-col items-center justify-center border-dashed border-cyan-500/30">
					<div class="text-white font-bold mb-2 font-display">Join the Alliance</div>
					<a href="mailto:info@oceanhub.com" class="text-xs font-mono text-cyan-400 hover:text-cyan-300 uppercase tracking-wider">
						Connect with Us →
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
