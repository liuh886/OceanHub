---
import Layout from '../../layouts/Layout.astro';
import { engineeringReferences } from '../../data/engineeringReferences';
---

<Layout title="Engineering Reference Library | OceanHub" description="Standards, recommended practices and guidance used by OceanHub evidence plans.">
  <section class="border-b border-white/10 py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 sm:px-8">
      <div class="max-w-4xl">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-cyan-300">Engineering Reference Library</p>
        <h1 class="mt-5 font-display text-4xl font-black leading-tight text-white sm:text-6xl">The references behind the evidence plan.</h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-300">Canonical standards, recommended practices, guidance and international reference documents used by OceanHub cases and JIP scopes.</p>
        <p class="mt-8 max-w-3xl border-l-2 border-cyan-400/40 pl-5 text-sm leading-relaxed text-slate-400">Metadata and applicability only. OceanHub does not reproduce copyrighted standards. Verify the required controlled edition before project use.</p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-6 sm:px-8">
      <div class="divide-y divide-white/10 border-y border-white/10">
        {engineeringReferences.map((reference) => (
          <article data-engineering-reference={reference.id} class="grid gap-4 py-6 lg:grid-cols-[12rem_1fr_12rem]">
            <div>
              <a href={reference.officialUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-sm font-bold text-cyan-300">{reference.code} ↗</a>
              <p class="mt-2 text-[10px] uppercase tracking-[0.14em] text-slate-600">{reference.issuer} · {reference.kind}</p>
            </div>
            <div>
              <h2 class="text-sm font-bold leading-relaxed text-slate-100">{reference.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-400">{reference.scopeSummary}</p>
              {reference.applicabilityNotes?.map((note) => <p class="mt-3 border-l-2 border-amber-400/30 pl-3 text-xs leading-relaxed text-slate-500">{note}</p>)}
            </div>
            <div class="lg:text-right">
              <p class="text-xs font-semibold text-slate-300">{reference.edition}</p>
              <p class={reference.status === 'current-revision-pending' ? 'mt-2 text-[10px] uppercase text-amber-300' : 'mt-2 text-[10px] uppercase text-emerald-300'}>{reference.status.replaceAll('-', ' ')}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
