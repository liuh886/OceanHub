---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { contentVersion } from '../lib/contentVersion';

const base = import.meta.env.BASE_URL;
const focusAreas = await getCollection('focus-areas');
const insights = await getCollection('insights');

const catalogue = [
  ...focusAreas.map((entry) => ({
    id: `focus-area:${entry.slug}`,
    title: entry.data.title,
    description: entry.data.description,
    type: 'focus-area',
    route: `${base}focus-areas/${entry.slug}/`,
    version: contentVersion(entry)
  })),
  ...insights.map((entry) => ({
    id: `insight:${entry.slug}`,
    title: entry.data.title,
    description: entry.data.description,
    type: 'insight',
    route: `${base}insights/${entry.slug}/`,
    version: contentVersion(entry)
  }))
];
---

<Layout title="Offline Briefcase | OceanHub" description="Manage OceanHub focus areas and marine intelligence saved deliberately for offline access.">
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-24">
    <header class="max-w-3xl mb-12 reveal">
      <div class="hud-badge mb-5"><i class="fa-solid fa-briefcase" aria-hidden="true"></i> OFFLINE BRIEFCASE</div>
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight mb-6 font-display">Your saved marine intelligence</h1>
      <p class="text-lg text-slate-300 font-light leading-relaxed">
        OceanHub only downloads the pages you explicitly save. Use this view to confirm local availability, update changed material, or remove stored copies.
      </p>
    </header>

    <div class="glass-panel rounded-3xl p-6 md:p-8 mb-10 reveal">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5">
        <div>
          <p class="text-xs font-mono uppercase tracking-[0.2em] text-cyan-300 mb-2">Device storage</p>
          <p id="briefcase-summary" class="text-2xl font-black text-white font-display">Checking saved content…</p>
          <p id="briefcase-message" class="text-sm text-slate-400 mt-2" aria-live="polite">Verifying local cache availability.</p>
        </div>
        <button id="briefcase-clear" type="button" class="hidden px-5 py-3 rounded-xl border border-rose-400/30 bg-rose-500/10 text-rose-200 hover:bg-rose-500/20 text-xs font-mono font-bold uppercase tracking-wider">
          Clear all saved content
        </button>
      </div>
    </div>

    <div id="briefcase-empty" class="hidden glass-card p-10 md:p-14 text-center reveal">
      <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-cyan-500/10 border border-cyan-400/20 flex items-center justify-center text-cyan-300">
        <i class="fa-solid fa-bookmark text-2xl" aria-hidden="true"></i>
      </div>
      <h2 class="text-2xl font-black text-white font-display mb-3">Nothing saved yet</h2>
      <p class="text-slate-400 max-w-xl mx-auto mb-7">Open a Focus Area or Marine Intelligence note and choose “Save offline”. Saved pages will appear here with their real cache status.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={`${base}focus-areas/`} class="px-6 py-3 rounded-xl bg-cyan-500 text-slate-950 font-bold text-sm">Browse Focus Areas</a>
        <a href={`${base}insights/`} class="px-6 py-3 rounded-xl border border-white/15 bg-white/5 text-white font-bold text-sm">Browse Intelligence</a>
      </div>
    </div>

    <div id="briefcase-list" class="grid grid-cols-1 lg:grid-cols-2 gap-7" aria-live="polite"></div>
  </section>

  <script is:inline id="briefcase-catalogue" type="application/json" set:html={JSON.stringify(catalogue)}></script>

  <script>
    const STORAGE_KEY = 'oceanhub-briefcase-v1';

    interface CatalogueItem {
      id: string;
      title: string;
      description: string;
      type: 'focus-area' | 'insight';
      route: string;
      version: string;
    }

    interface SavedContent extends CatalogueItem {
      savedAt: string;
    }

    interface WorkerReply {
      ok: boolean;
      available?: boolean;
      error?: string;
    }

    const catalogueNode = document.getElementById('briefcase-catalogue');
    const catalogue = JSON.parse(catalogueNode?.textContent ?? '[]') as CatalogueItem[];
    const currentById = new Map(catalogue.map((item) => [item.id, item]));
    const list = document.getElementById('briefcase-list');
    const empty = document.getElementById('briefcase-empty');
    const summary = document.getElementById('briefcase-summary');
    const message = document.getElementById('briefcase-message');
    const clearButton = document.getElementById('briefcase-clear') as HTMLButtonElement | null;

    function readSavedContent(): SavedContent[] {
      try {
        const value = localStorage.getItem(STORAGE_KEY);
        if (!value) return [];
        const parsed = JSON.parse(value);
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }

    function writeSavedContent(items: SavedContent[]) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
    }

    async function sendWorkerMessage(payload: Record<string, unknown>): Promise<WorkerReply> {
      if (!('serviceWorker' in navigator)) return { ok: false, error: 'Offline caching is not supported by this browser.' };

      try {
        const registration = await navigator.serviceWorker.ready;
        const worker = registration.active ?? navigator.serviceWorker.controller;
        if (!worker) return { ok: false, error: 'OceanHub offline support is not ready.' };

        return await new Promise((resolve) => {
          const channel = new MessageChannel();
          const timeout = window.setTimeout(() => resolve({ ok: false, error: 'The cache request timed out.' }), 15000);
          channel.port1.onmessage = (event: MessageEvent<WorkerReply>) => {
            window.clearTimeout(timeout);
            resolve(event.data);
          };
          worker.postMessage(payload, [channel.port2]);
        });
      } catch {
        return { ok: false, error: 'OceanHub offline support is unavailable.' };
      }
    }

    function createTextElement<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text: string) {
      const element = document.createElement(tag);
      element.className = className;
      element.textContent = text;
      return element;
    }

    async function renderBriefcase() {
      if (!list || !empty || !summary || !message || !clearButton) return;

      const savedItems = readSavedContent().sort((a, b) => b.savedAt.localeCompare(a.savedAt));
      list.replaceChildren();
      summary.textContent = `${savedItems.length} saved item${savedItems.length === 1 ? '' : 's'}`;
      clearButton.classList.toggle('hidden', savedItems.length === 0);
      empty.classList.toggle('hidden', savedItems.length !== 0);

      if (savedItems.length === 0) {
        message.textContent = 'Pages are only stored after you explicitly choose “Save offline”.';
        return;
      }

      message.textContent = 'Checking whether each saved page is fully available on this device.';
      let availableCount = 0;

      for (const saved of savedItems) {
        const current = currentById.get(saved.id);
        const currentRoute = current?.route ?? saved.route;
        const statusReply = await sendWorkerMessage({ type: 'CHECK_CONTENT', url: currentRoute });
        const available = Boolean(statusReply.ok && statusReply.available);
        const updateAvailable = Boolean(current && current.version !== saved.version);
        if (available) availableCount += 1;

        const card = document.createElement('article');
        card.className = 'glass-card p-7 md:p-8 flex flex-col justify-between gap-7';
        card.dataset.contentId = saved.id;

        const top = document.createElement('div');
        const badges = document.createElement('div');
        badges.className = 'flex flex-wrap items-center gap-2 mb-5';
        badges.append(
          createTextElement('span', 'evidence-chip', saved.type === 'focus-area' ? 'Focus Area' : 'Intelligence'),
          createTextElement(
            'span',
            available
              ? 'px-3 py-1 rounded-full text-xs font-mono border border-emerald-400/30 bg-emerald-500/10 text-emerald-300'
              : 'px-3 py-1 rounded-full text-xs font-mono border border-amber-400/30 bg-amber-500/10 text-amber-300',
            available ? 'Available offline' : 'Download incomplete'
          )
        );
        if (updateAvailable) {
          badges.append(createTextElement('span', 'px-3 py-1 rounded-full text-xs font-mono border border-blue-400/30 bg-blue-500/10 text-blue-300', 'Update available'));
        }

        const title = createTextElement('h2', 'text-2xl font-black text-white font-display mb-3', current?.title ?? saved.title);
        const description = createTextElement('p', 'text-sm text-slate-400 leading-relaxed', current?.description ?? saved.description);
        const meta = createTextElement(
          'p',
          'text-xs font-mono text-slate-500 mt-5',
          `Saved ${new Date(saved.savedAt).toLocaleString()} · version ${saved.version}`
        );
        top.append(badges, title, description, meta);

        const actions = document.createElement('div');
        actions.className = 'flex flex-wrap items-center gap-3 pt-5 border-t border-white/10';

        const openLink = document.createElement('a');
        openLink.href = currentRoute;
        openLink.className = 'px-5 py-2.5 rounded-xl bg-cyan-500 text-slate-950 font-bold text-xs uppercase tracking-wider';
        openLink.textContent = available ? 'Open saved page' : 'Open page';
        actions.append(openLink);

        if (current && (updateAvailable || !available)) {
          const updateButton = document.createElement('button');
          updateButton.type = 'button';
          updateButton.className = 'px-5 py-2.5 rounded-xl bg-blue-500/10 border border-blue-400/30 text-blue-200 font-bold text-xs uppercase tracking-wider';
          updateButton.textContent = updateAvailable ? 'Download update' : 'Retry download';
          updateButton.addEventListener('click', async () => {
            updateButton.disabled = true;
            updateButton.textContent = 'Downloading…';
            const reply = await sendWorkerMessage({ type: 'CACHE_CONTENT', url: current.route });
            if (reply.ok) {
              const items = readSavedContent().filter((item) => item.id !== current.id);
              writeSavedContent([...items, { ...current, savedAt: new Date().toISOString() }]);
              message.textContent = `${current.title} is now available offline.`;
              await renderBriefcase();
            } else {
              updateButton.disabled = false;
              updateButton.textContent = 'Try again';
              message.textContent = reply.error ?? 'The page could not be downloaded.';
            }
          });
          actions.append(updateButton);
        }

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className = 'px-5 py-2.5 rounded-xl bg-white/5 border border-white/10 text-slate-300 font-bold text-xs uppercase tracking-wider';
        removeButton.textContent = 'Remove';
        removeButton.addEventListener('click', async () => {
          removeButton.disabled = true;
          const reply = await sendWorkerMessage({ type: 'REMOVE_CONTENT', url: currentRoute });
          if (reply.ok) {
            writeSavedContent(readSavedContent().filter((item) => item.id !== saved.id));
            message.textContent = `${saved.title} was removed from this device.`;
            await renderBriefcase();
          } else {
            removeButton.disabled = false;
            message.textContent = reply.error ?? 'The saved page could not be removed.';
          }
        });
        actions.append(removeButton);

        card.append(top, actions);
        list.append(card);
      }

      message.textContent = `${availableCount} of ${savedItems.length} saved item${savedItems.length === 1 ? ' is' : 's are'} fully available offline.`;
    }

    if (clearButton && message) {
      const clearControl = clearButton;
      const statusMessage = message;
      clearControl.addEventListener('click', async () => {
        clearControl.disabled = true;
        const reply = await sendWorkerMessage({ type: 'CLEAR_CONTENT' });
        if (reply.ok) {
          localStorage.removeItem(STORAGE_KEY);
          statusMessage.textContent = 'All deliberately saved OceanHub content was removed from this device.';
          await renderBriefcase();
        } else {
          clearControl.disabled = false;
          statusMessage.textContent = reply.error ?? 'Saved content could not be cleared.';
        }
      });
    }

    renderBriefcase();
    window.addEventListener('oceanhub:briefcase-updated', renderBriefcase);
  </script>
</Layout>
