---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
---

<Layout title="Offline | OceanHub" description="OceanHub is currently offline. Previously opened pages may still be available from local cache.">
  <section class="relative min-h-[78vh] flex items-center justify-center overflow-hidden px-6 py-24">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-cyan-950/25 via-[#060B14] to-[#040810] -z-10"></div>
    <div class="max-w-2xl w-full mx-auto text-center relative z-10 glass-panel p-9 md:p-14 rounded-3xl border border-cyan-500/20">
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-500/20 to-blue-600/30 border border-cyan-400/40 flex items-center justify-center text-cyan-400 mx-auto mb-7" aria-hidden="true">
        <i class="fa-solid fa-cloud text-2xl"></i>
      </div>

      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-mono font-semibold uppercase tracking-widest mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-300"></span>
        Network unavailable
      </div>

      <h1 class="text-3xl md:text-5xl font-black text-white tracking-tight mb-4 font-display">OceanHub is offline</h1>
      <p class="text-slate-400 text-base md:text-lg leading-relaxed mb-8 font-light">Pages opened previously may remain available on this device. Reconnect to load routes or assets that have not yet been cached.</p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <button id="retry-connection-btn" type="button" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-slate-950 font-bold text-sm tracking-wider uppercase transition-all flex items-center justify-center gap-2">
          <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
          <span>Try again</span>
        </button>
        <a href={url()} class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-cyan-500/40 text-slate-200 font-bold text-sm tracking-wider uppercase hover:bg-white/10 transition-all">Open home</a>
      </div>

      <div id="connection-status-pill" class="mt-8 text-xs font-mono text-slate-500 flex items-center justify-center gap-2" role="status" aria-live="polite">
        <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
        Waiting for a network connection.
      </div>
    </div>
  </section>

  <script define:vars={{ base }}>
    const retryBtn = document.getElementById('retry-connection-btn');
    const statusPill = document.getElementById('connection-status-pill');

    function checkConnection() {
      if (navigator.onLine) {
        if (statusPill) statusPill.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span><span class="text-emerald-300">Connection restored. Returning home…</span>';
        window.setTimeout(() => { window.location.href = base; }, 500);
      } else if (statusPill) {
        statusPill.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-300"></span><span class="text-amber-300">Still offline. Previously opened pages may remain available.</span>';
      }
    }

    retryBtn?.addEventListener('click', checkConnection);
    window.addEventListener('online', checkConnection);
  </script>
</Layout>
