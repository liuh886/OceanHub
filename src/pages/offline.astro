---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Offline Mode | OceanHub Marine Intelligence" description="You are currently viewing OceanHub in offline mode.">
  <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden px-6 py-24">
    <!-- Cyberpunk grid & radar glow -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-cyan-950/30 via-[#060B14] to-[#040810] -z-10"></div>
    <div class="absolute w-[600px] h-[600px] bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-2xl w-full mx-auto text-center relative z-10 glass-panel p-10 md:p-16 rounded-3xl border border-cyan-500/20 shadow-[0_0_50px_rgba(0,240,255,0.08)]">
      <!-- Sci-Fi HUD Radar / Signal Icon -->
      <div class="relative w-24 h-24 mx-auto mb-8 flex items-center justify-center">
        <div class="absolute inset-0 rounded-full border border-cyan-500/40 animate-ping opacity-30"></div>
        <div class="absolute inset-2 rounded-full border border-cyan-400/20 border-dashed animate-spin" style="animation-duration: 12s;"></div>
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-500/20 to-blue-600/30 border border-cyan-400/40 flex items-center justify-center text-cyan-400 shadow-[0_0_20px_rgba(0,240,255,0.3)]">
          <i class="fa-solid fa-satellite-dish text-2xl"></i>
        </div>
      </div>

      <!-- Status Tag -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-mono font-semibold uppercase tracking-widest mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        Telemetry Signal Offline
      </div>

      <h1 class="text-3xl md:text-5xl font-black text-white tracking-tight mb-4 font-display">
        Local Cache <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Engaged</span>
      </h1>

      <p class="text-slate-400 text-base md:text-lg leading-relaxed mb-8 font-light">
        OceanHub is operating in autonomous PWA offline mode. Pre-cached marine data and cached initiatives remain accessible locally.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <button id="retry-connection-btn" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-bold text-sm tracking-wider uppercase hover:shadow-[0_0_25px_rgba(0,240,255,0.4)] transition-all duration-300 flex items-center justify-center gap-2">
          <i class="fa-solid fa-rotate-right"></i>
          <span>Re-establish Uplink</span>
        </button>
        <a href="/" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-cyan-500/40 text-slate-200 font-bold text-sm tracking-wider uppercase hover:bg-white/10 transition-all duration-300">
          Return to Deck
        </a>
      </div>

      <!-- Connection Status indicator -->
      <div id="connection-status-pill" class="mt-8 text-xs font-mono text-slate-500 flex items-center justify-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
        Awaiting network restore event...
      </div>
    </div>
  </section>

  <script>
    const retryBtn = document.getElementById('retry-connection-btn');
    const statusPill = document.getElementById('connection-status-pill');

    function checkConnection() {
      if (navigator.onLine) {
        if (statusPill) {
          statusPill.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> <span class="text-emerald-400">Connection restored! Reloading...</span>';
        }
        setTimeout(() => {
          window.location.href = '/';
        }, 800);
      } else {
        if (statusPill) {
          statusPill.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> <span class="text-amber-400">Still disconnected. Checking again...</span>';
        }
      }
    }

    if (retryBtn) {
      retryBtn.addEventListener('click', () => {
        retryBtn.classList.add('opacity-70');
        checkConnection();
        setTimeout(() => retryBtn.classList.remove('opacity-70'), 1000);
      });
    }

    window.addEventListener('online', checkConnection);
  </script>
</Layout>
