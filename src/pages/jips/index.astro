---
import Layout from '../../layouts/Layout.astro';
import { proposedJips } from '../../data/proposedJips';
import { resolveEngineeringReferences } from '../../data/engineeringReferences';

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
---

<Layout title="Proposed Joint Industry Projects | OceanHub" description="Forming OceanHub JIP concepts built around offshore engineering decisions, capability gaps and traceable references.">
  <section class="border-b border-white/10 py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 sm:px-8">
      <div class="max-w-4xl">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-emerald-300">Green Offshore Technology Alliance</p>
        <h1 class="mt-5 font-display text-4xl font-black leading-tight text-white sm:text-6xl">Proposed JIPs built around real capability gaps.</h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-300">Each scope starts from an engineering problem, identifies the capabilities needed to address it, and links the work to recognized engineering references where they apply.</p>
        <p class="mt-6 max-w-3xl border-l-2 border-emerald-400/40 pl-5 text-sm leading-relaxed text-slate-400">These are forming collaboration proposals, not funded or formally constituted consortia unless that commitment is explicitly stated.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={url('scope/')} class="rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-sm font-bold text-white">Start from a project decision</a>
          <a href={url('references/')} class="rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-sm font-bold text-white">Engineering references</a>
          <button type="button" data-open-collaboration="partner" class="rounded-xl bg-emerald-400 px-5 py-3 text-sm font-black text-slate-950">Express partner interest</button>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-7xl space-y-8 px-6 sm:px-8">
      {proposedJips.map((jip) => (
        <article id={jip.id} class="scroll-mt-28 border border-white/10 bg-[#060D1E]/55">
          <header class="border-b border-white/10 p-6 sm:p-8 lg:p-10">
            <div class="flex flex-wrap items-center gap-3 text-[10px] uppercase tracking-[0.14em] text-slate-500">
              <span class="font-mono font-bold text-emerald-300">{jip.number}</span><span>{jip.category}</span>
              <span class="rounded-full border border-emerald-400/20 bg-emerald-500/5 px-3 py-1 font-bold text-emerald-200">{jip.status}</span>
            </div>
            <h2 class="mt-5 max-w-5xl font-display text-2xl font-black text-white sm:text-4xl">{jip.title}</h2>
            <p class="mt-4 max-w-4xl text-base leading-relaxed text-slate-300">{jip.premise}</p>
          </header>

          <div class="grid grid-cols-1 lg:grid-cols-12">
            <div class="space-y-8 border-b border-white/10 p-6 sm:p-8 lg:col-span-5 lg:border-b-0 lg:border-r lg:p-10">
              <section><h3 class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Industry problem</h3><p class="mt-3 text-sm leading-relaxed text-slate-300">{jip.problem}</p></section>
              <section><h3 class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Why collaborate</h3><p class="mt-3 text-sm leading-relaxed text-slate-300">{jip.whyCollaborate}</p></section>
              <section class="border-l-2 border-cyan-400/40 pl-5"><h3 class="text-xs font-bold uppercase tracking-[0.14em] text-cyan-300">Target outcome</h3><p class="mt-2 text-sm font-semibold leading-relaxed text-slate-100">{jip.targetOutcome}</p></section>
              <section><h3 class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Collaboration model</h3><p class="mt-3 text-sm leading-relaxed text-slate-400">{jip.collaborationModel}</p></section>
            </div>

            <div class="space-y-9 p-6 sm:p-8 lg:col-span-7 lg:p-10">
              <div class="grid grid-cols-1 gap-8 xl:grid-cols-2">
                <section><h3 class="text-sm font-bold text-white">Technical workstreams</h3><ol class="mt-4 space-y-2.5">{jip.workstreams.map((item, index) => <li class="text-sm leading-relaxed text-slate-400"><span class="mr-2 font-mono text-[10px] text-cyan-400">0{index + 1}</span>{item}</li>)}</ol></section>
                <section><h3 class="text-sm font-bold text-white">Capabilities sought</h3><ul class="mt-4 space-y-2.5">{jip.capabilities.map((item) => <li class="text-sm leading-relaxed text-slate-400">• {item}</li>)}</ul></section>
                <section><h3 class="text-sm font-bold text-white">Proposed deliverables</h3><ul class="mt-4 space-y-2.5">{jip.deliverables.map((item) => <li class="text-sm leading-relaxed text-slate-400">• {item}</li>)}</ul></section>
                <section><h3 class="text-sm font-bold text-white">Who should join</h3><ul class="mt-4 space-y-2.5">{jip.partnerProfiles.map((item) => <li class="text-sm leading-relaxed text-slate-400">• {item}</li>)}</ul></section>
              </div>

              <section class="border-t border-white/10 pt-7">
                <h3 class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Engineering references</h3>
                <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
                  {resolveEngineeringReferences(jip.referenceIds).map((reference) => (
                    <a href={reference.officialUrl} target="_blank" rel="noopener noreferrer" data-engineering-reference={reference.id} class="rounded-lg border border-white/10 bg-white/[0.025] px-3 py-2 hover:border-emerald-400/30">
                      <span class="block text-xs font-bold text-emerald-200">{reference.code}</span>
                      <span class="mt-1 block text-[11px] leading-relaxed text-slate-400">{reference.title}</span>
                      <span class="mt-1 block text-[10px] text-slate-600">{reference.issuer} · {reference.edition}</span>
                    </a>
                  ))}
                </div>
                {jip.regulatoryNotes?.map((note) => <p class="mt-3 border-l-2 border-amber-400/30 pl-4 text-xs leading-relaxed text-slate-500">{note}</p>)}
              </section>

              <div class="flex flex-col gap-3 border-t border-white/10 pt-7 sm:flex-row sm:items-center sm:justify-between">
                <p class="max-w-xl text-xs leading-relaxed text-slate-500">If your field asset, method, dataset or engineering expertise addresses one of these workstreams, OceanHub wants to understand the fit before any consortium structure is implied.</p>
                <button type="button" data-open-collaboration="partner" data-jip-id={jip.id} class="shrink-0 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-5 py-3 text-xs font-bold text-emerald-200">Discuss this capability →</button>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
