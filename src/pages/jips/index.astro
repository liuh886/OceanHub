---
import Layout from '../../layouts/Layout.astro';
import { proposedJips } from '../../data/proposedJips';

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
---

<Layout
  title="Proposed Joint Industry Projects | OceanHub"
  description="Explore forming Green Offshore Technology Alliance JIP concepts built around concrete offshore engineering problems, capability needs and collaborative field work."
>
  <section class="border-b border-white/10 py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 sm:px-8">
      <div class="max-w-4xl reveal">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-emerald-300">Green Offshore Technology Alliance</p>
        <h1 class="mt-5 font-display text-4xl font-black leading-tight tracking-tight text-white sm:text-6xl">
          Proposed JIPs built around real capability gaps.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-300">
          OceanHub uses Joint Industry Project concepts to turn shared offshore engineering bottlenecks into explicit workstreams, capability needs and collaboration pathways.
        </p>
        <div class="mt-8 max-w-3xl border-l-2 border-emerald-400/50 pl-5 text-sm leading-relaxed text-slate-400">
          These are forming collaboration proposals. A listed JIP is not presented as funded, formally constituted or backed by a named organization unless that commitment is explicitly stated.
        </div>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={url('scope/')} class="inline-flex rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-sm font-bold text-white hover:bg-white/10">Start from a project decision</a>
          <button type="button" data-open-collaboration="partner" class="inline-flex rounded-xl bg-emerald-400 px-5 py-3 text-sm font-black text-slate-950 hover:bg-emerald-300">Express partner interest</button>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20" aria-labelledby="jip-catalogue-title">
    <div class="mx-auto max-w-7xl px-6 sm:px-8">
      <div class="reveal mb-10 flex flex-col gap-4 border-b border-white/10 pb-8 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-slate-500">Formation catalogue</p>
          <h2 id="jip-catalogue-title" class="mt-2 font-display text-2xl font-black text-white sm:text-3xl">Four starting collaboration scopes</h2>
        </div>
        <p class="max-w-xl text-sm leading-relaxed text-slate-500">Status describes formation maturity only. It is not a completion percentage or technology-performance claim.</p>
      </div>

      <div class="space-y-8">
        {proposedJips.map((jip, index) => (
          <article id={jip.id} class="reveal scroll-mt-28 border border-white/10 bg-[#060D1E]/55" style={`transition-delay: ${Math.min(index * 60, 180)}ms;`}>
            <header class="border-b border-white/10 p-6 sm:p-8 lg:p-10">
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                <span class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-300">{jip.number}</span>
                <span class="text-[10px] uppercase tracking-[0.14em] text-slate-500">{jip.category}</span>
                <span class="rounded-full border border-emerald-400/20 bg-emerald-500/5 px-3 py-1 text-[10px] font-bold text-emerald-200">{jip.status}</span>
              </div>
              <h2 class="mt-5 max-w-5xl font-display text-2xl font-black leading-tight text-white sm:text-4xl">{jip.title}</h2>
              <p class="mt-4 max-w-4xl text-base leading-relaxed text-slate-300">{jip.premise}</p>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-12">
              <div class="border-b border-white/10 p-6 sm:p-8 lg:col-span-5 lg:border-b-0 lg:border-r lg:p-10">
                <div>
                  <p class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Industry problem</p>
                  <p class="mt-3 text-sm leading-relaxed text-slate-300">{jip.problem}</p>
                </div>

                <div class="mt-8">
                  <p class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Why collaboration is needed</p>
                  <p class="mt-3 text-sm leading-relaxed text-slate-300">{jip.whyCollaborate}</p>
                </div>

                <div class="mt-8 border-l-2 border-cyan-400/40 pl-5">
                  <p class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-cyan-300">Target outcome</p>
                  <p class="mt-2 text-sm font-semibold leading-relaxed text-slate-100">{jip.targetOutcome}</p>
                </div>

                <div class="mt-8">
                  <p class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Proposed collaboration model</p>
                  <p class="mt-3 text-sm leading-relaxed text-slate-400">{jip.collaborationModel}</p>
                </div>
              </div>

              <div class="p-6 sm:p-8 lg:col-span-7 lg:p-10">
                <div class="grid grid-cols-1 gap-8 xl:grid-cols-2">
                  <section>
                    <h3 class="text-sm font-bold text-white">Proposed technical workstreams</h3>
                    <ol class="mt-4 space-y-3">
                      {jip.workstreams.map((workstream, workstreamIndex) => (
                        <li class="grid grid-cols-[2rem_1fr] gap-2 text-sm leading-relaxed text-slate-400">
                          <span class="font-mono text-[10px] text-cyan-400">0{workstreamIndex + 1}</span>
                          <span>{workstream}</span>
                        </li>
                      ))}
                    </ol>
                  </section>

                  <section>
                    <h3 class="text-sm font-bold text-white">Capabilities sought</h3>
                    <ul class="mt-4 space-y-2.5">
                      {jip.capabilities.map((capability) => (
                        <li class="flex gap-2 text-sm leading-relaxed text-slate-400"><span class="mt-[0.55rem] h-1 w-1 shrink-0 rounded-full bg-emerald-400"></span><span>{capability}</span></li>
                      ))}
                    </ul>
                  </section>

                  <section>
                    <h3 class="text-sm font-bold text-white">Proposed deliverables</h3>
                    <ul class="mt-4 space-y-2.5">
                      {jip.deliverables.map((deliverable) => (
                        <li class="flex gap-2 text-sm leading-relaxed text-slate-400"><span class="mt-[0.55rem] h-1 w-1 shrink-0 rounded-full bg-cyan-400"></span><span>{deliverable}</span></li>
                      ))}
                    </ul>
                  </section>

                  <section>
                    <h3 class="text-sm font-bold text-white">Who should join</h3>
                    <ul class="mt-4 space-y-2.5">
                      {jip.partnerProfiles.map((partner) => (
                        <li class="flex gap-2 text-sm leading-relaxed text-slate-400"><span class="mt-[0.55rem] h-1 w-1 shrink-0 rounded-full bg-slate-500"></span><span>{partner}</span></li>
                      ))}
                    </ul>
                  </section>
                </div>

                <div class="mt-9 border-t border-white/10 pt-7">
                  <p class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Relevant standards / guidance</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {jip.standards.map((standard) => <span class="rounded-lg border border-white/10 bg-white/[0.025] px-3 py-1.5 text-xs text-slate-300">{standard}</span>)}
                  </div>
                </div>

                <div class="mt-8 flex flex-col gap-3 border-t border-white/10 pt-7 sm:flex-row sm:items-center sm:justify-between">
                  <p class="max-w-xl text-xs leading-relaxed text-slate-500">If your field asset, method, dataset or engineering expertise addresses one of these workstreams, OceanHub wants to understand the fit before any consortium structure is implied.</p>
                  <button type="button" data-open-collaboration="partner" data-jip-id={jip.id} class="shrink-0 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-5 py-3 text-xs font-bold text-emerald-200 hover:bg-emerald-500/15">Discuss this capability →</button>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-white/10 py-20">
    <div class="mx-auto max-w-7xl px-6 sm:px-8">
      <div class="reveal grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-8">
          <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-cyan-300">Bring another problem</p>
          <h2 class="mt-3 font-display text-3xl font-black text-white">A JIP should start from a shared decision gap, not from a technology looking for a project.</h2>
          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-400">Use the Decision Scoper to frame the engineering need first. If the evidence chain exposes a capability gap that several parties share, that is a stronger starting point for a new collaboration scope.</p>
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <a href={url('scope/')} class="inline-flex rounded-xl bg-cyan-400 px-6 py-3.5 text-sm font-black text-slate-950 hover:bg-cyan-300">Scope the decision first</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
