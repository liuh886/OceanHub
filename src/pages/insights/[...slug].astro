---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const insightEntries = await getCollection('insights');
  return insightEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | OceanHub Insights`} description={entry.data.description}>
  <article class="max-w-3xl mx-auto px-4 py-20">
    <header class="mb-12 text-center">
      <div class="flex justify-center gap-2 mb-6">
        {entry.data.tags.map((tag) => (
          <span class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6 leading-tight">{entry.data.title}</h1>
      <div class="flex justify-center items-center text-slate-500 text-sm gap-4">
        <span>By {entry.data.author}</span>
        <span>•</span>
        <time datetime={entry.data.publishDate.toISOString()}>
          {entry.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>
    </header>

    <div class="prose prose-slate prose-lg max-w-none">
      <Content />
    </div>

    <div class="mt-20 pt-10 border-t border-slate-200 text-center">
      <a href="/insights" class="text-blue-600 font-bold hover:underline">← Back to Insights</a>
    </div>
  </article>
</Layout>

<style is:global>
  @reference "../../styles/global.css";
  
  .prose h2 { @apply text-3xl font-bold text-slate-900 mt-12 mb-6; }
  .prose h3 { @apply text-2xl font-bold text-slate-800 mt-8 mb-4; }
  .prose p { @apply text-slate-600 leading-relaxed mb-6; }
  .prose ul { @apply list-disc list-inside text-slate-600 space-y-2 mb-6; }
  .prose li { @apply marker:text-blue-500; }
  .prose strong { @apply text-slate-900 font-bold; }
  .prose blockquote { @apply border-l-4 border-blue-500 pl-4 italic text-slate-700 bg-slate-50 py-4 pr-4 rounded-r-lg; }
</style>
