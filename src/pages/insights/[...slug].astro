---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import OfflineSaveButton from '../../components/OfflineSaveButton.astro';
import { contentVersion } from '../../lib/contentVersion';

export async function getStaticPaths() {
  const entries = await getCollection('insights');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
const { entry } = Astro.props;
const { Content } = await render(entry);
const version = contentVersion(entry);
const wordCount = entry.body ? entry.body.split(/\s+/).length : 600;
const readTimeMinutes = Math.max(3, Math.ceil(wordCount / 200));
const published = entry.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const canonicalInsightUrl = new URL(`${base.replace(/^\/+/, '')}insights/${entry.id}/`, Astro.site).toString();
const citation = `${entry.data.author} (${entry.data.publishDate.getFullYear()}). ${entry.data.title}. OceanHub. ${canonicalInsightUrl}`;
---

<Layout title={`${entry.data.title} | OceanHub Intelligence`} description={entry.data.description}>
  <article class="mx-auto max-w-5xl px-6 py-16 sm:px-8 md:py-24">
    <header class="mb-14 reveal">
      <a href={url('insights/')} class="text-xs font-mono font-bold uppercase tracking-widest text-cyan-400 hover:text-cyan-300">← Engineering Intelligence</a>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <span class="hud-badge text-[11px]">TECHNICAL BRIEF</span>
        {entry.data.tags.map((tag) => <span class="evidence-chip">{tag}</span>)}
        <span class="ml-auto text-xs font-mono text-slate-500">{readTimeMinutes} min read</span>
      </div>
      <h1 class="mt-6 font-display text-4xl font-black leading-tight text-white sm:text-6xl">{entry.data.title}</h1>
      <div class="mt-7 flex flex-wrap gap-4 border-y border-white/10 py-4 text-xs font-mono text-slate-400">
        <strong class="text-slate-200">{entry.data.author}</strong><span>•</span><time datetime={entry.data.publishDate.toISOString()}>{published}</time><span>•</span><span>OceanHub technical note</span>
      </div>
      <div class="mt-7"><OfflineSaveButton contentId={`insight:${entry.id}`} title={entry.data.title} description={entry.data.description} route={`insights/${entry.id}`} contentType="insight" version={version} /></div>
    </header>

    <section class="reveal mb-12 rounded-2xl border border-cyan-500/20 bg-cyan-950/20 p-6 sm:p-8">
      <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-cyan-300">Executive synopsis</p>
      <p class="mt-3 text-base leading-relaxed text-slate-300">{entry.data.description}</p>
    </section>

    <div class="prose prose-invert prose-cyan max-w-none reveal"><Content /></div>

    <section class="reveal mt-16 rounded-2xl border border-white/10 bg-black/30 p-6">
      <p class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Suggested citation</p>
      <p class="mt-2 text-xs leading-relaxed text-slate-300">{citation}</p>
    </section>

    <div class="reveal mt-16 flex flex-col gap-5 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <a href={url('insights/')} class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-400 hover:text-cyan-300">← Return to Engineering Intelligence</a>
      <button type="button" data-open-collaboration="partner" class="rounded-xl border border-cyan-400/30 bg-cyan-500/10 px-5 py-3 text-xs font-bold text-cyan-200 hover:bg-cyan-500/15">Discuss evidence or capability fit</button>
    </div>
  </article>
</Layout>

<style is:global>
  @reference "../../styles/global.css";
  .prose h2 { @apply mt-14 mb-6 border-b border-white/10 pb-4 font-display text-2xl font-black text-white md:text-4xl; }
  .prose h3 { @apply mt-10 mb-4 font-display text-xl font-bold text-cyan-300 md:text-2xl; }
  .prose p { @apply mb-6 text-base font-light leading-relaxed text-slate-300 md:text-lg; }
  .prose ul, .prose ol { @apply mb-8 ml-6 space-y-3 text-base text-slate-300 md:text-lg; }
  .prose strong { @apply font-semibold text-white; }
  .prose blockquote { @apply my-8 rounded-r-2xl border-l-2 border-cyan-400 bg-cyan-950/30 py-4 pl-6 italic text-slate-200; }
  .prose table { @apply my-8 w-full border-collapse border border-white/10 text-left text-sm; }
  .prose th { @apply border border-white/10 bg-cyan-950/50 p-3 font-mono font-bold text-cyan-300; }
  .prose td { @apply border border-white/10 p-3 font-light text-slate-300; }
</style>
