---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const insightEntries = await getCollection('insights');
  return insightEntries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | OceanHub Intelligence`} description={entry.data.description}>
  <article class="max-w-4xl mx-auto px-6 py-16 md:py-24">
    <header class="mb-14 reveal">
      <a href={url('insights/')} class="inline-flex items-center gap-2 text-xs font-mono font-bold text-cyan-400 hover:text-cyan-300 uppercase tracking-widest mb-6 transition-colors">
        <i class="fa-solid fa-arrow-left text-xs" aria-hidden="true"></i>
        <span>Back to Marine Intelligence</span>
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="hud-badge text-[10px]"><i class="fa-solid fa-file-lines" aria-hidden="true"></i> OPEN NOTE</span>
        {entry.data.tags.map((tag) => <span class="evidence-chip">{tag}</span>)}
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-8 font-display leading-tight">{entry.data.title}</h1>

      <div class="flex flex-wrap items-center gap-4 py-4 border-y border-white/10 text-xs font-mono text-slate-400">
        <span class="text-white font-semibold">{entry.data.author}</span>
        <span aria-hidden="true">•</span>
        <time datetime={entry.data.publishDate.toISOString()} class="text-cyan-400">{entry.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <span aria-hidden="true">•</span>
        <span>Open access</span>
      </div>
    </header>

    <div class="prose prose-invert prose-cyan max-w-none reveal">
      <Content />
    </div>

    <div class="mt-20 pt-10 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-6 reveal">
      <a href={url('insights/')} class="inline-flex items-center gap-2 text-xs font-mono font-bold text-cyan-400 hover:text-cyan-300 uppercase tracking-wider">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        <span>Return to Marine Intelligence</span>
      </a>
      <a href="mailto:info@oceanhub.com" class="px-6 py-2.5 rounded-xl bg-cyan-500/10 border border-cyan-500/30 hover:bg-cyan-500/20 text-cyan-300 text-xs font-mono font-bold uppercase tracking-wider transition-all">Discuss this topic</a>
    </div>
  </article>
</Layout>

<style is:global>
  @reference "../../styles/global.css";
  .prose h2 { @apply text-2xl md:text-3xl font-black text-white mt-12 mb-6 font-display border-b border-white/10 pb-3; }
  .prose h3 { @apply text-xl md:text-2xl font-bold text-cyan-300 mt-8 mb-4 font-display; }
  .prose p { @apply text-slate-300 font-light leading-relaxed mb-6 text-base md:text-lg; }
  .prose ul { @apply list-disc list-outside ml-6 text-slate-300 space-y-2.5 mb-6 text-sm md:text-base; }
  .prose ol { @apply list-decimal list-outside ml-6 text-slate-300 space-y-2.5 mb-6 text-sm md:text-base; }
  .prose li { @apply marker:text-cyan-400 pl-1; }
  .prose strong { @apply text-white font-semibold; }
  .prose blockquote { @apply border-l-2 border-cyan-400 pl-6 py-3 italic text-slate-200 bg-cyan-950/20 rounded-r-2xl my-8; }
</style>
