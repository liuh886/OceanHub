---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
---

<Layout title="Page not found | OceanHub" description="The requested OceanHub page could not be found.">
  <section class="min-h-[72vh] flex items-center px-6 py-24">
    <div class="max-w-3xl mx-auto text-center">
      <div class="hud-badge mb-6"><i class="fa-solid fa-compass" aria-hidden="true"></i> 404 · ROUTE NOT FOUND</div>
      <h1 class="text-4xl sm:text-6xl font-black text-white font-display mb-6">This route is outside the current chart.</h1>
      <p class="text-lg text-slate-400 leading-relaxed mb-10">The page may have moved, or the link may point outside the OceanHub GitHub Pages scope.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href={url()} class="px-7 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-slate-950 font-black text-xs uppercase tracking-wider">Return home</a>
        <a href={url('focus-areas/')} class="px-7 py-3.5 rounded-xl bg-white/5 border border-white/15 text-white font-bold text-xs uppercase tracking-wider">Browse focus areas</a>
      </div>
    </div>
  </section>
</Layout>
