---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/oceanhub-logo-v2.png';
import PWAController from '../components/PWAController.astro';
import CollaborationModal from '../components/CollaborationModal.astro';
import CollaborationEmailAction from '../components/CollaborationEmailAction.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'OceanHub turns offshore project decisions into traceable evidence plans, capability needs and collaboration paths.'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="alternate icon" href={url('favicon.ico')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#040812" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="OceanHub" />
    <meta name="application-name" content="OceanHub" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OceanHub" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9gqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" media="print" onload="this.media='all'" />
  </head>
  <body class="min-h-screen bg-[#040812] text-slate-100 selection:bg-cyan-500/20 selection:text-cyan-200">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <nav id="main-nav" class="fixed top-0 z-50 w-full border-b border-white/5 bg-[#040812]/90 py-3.5 backdrop-blur-xl transition-all duration-300" aria-label="Primary navigation">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-5 sm:px-8">
        <a href={url()} class="flex items-center" aria-label="OceanHub home">
          <Image src={logo} alt="OceanHub" width={220} class="w-36 brightness-0 invert opacity-95 sm:w-40" />
        </a>

        <div class="hidden items-center gap-7 lg:flex">
          <a href={url('scope/')} class="text-xs font-bold text-cyan-300 transition-colors hover:text-cyan-200">Scope a Project</a>
          <a href={url('focus-areas/')} class="text-xs font-semibold text-slate-300 transition-colors hover:text-white">Solutions / Capabilities</a>
          <a href={url('jips/')} class="text-xs font-semibold text-slate-300 transition-colors hover:text-white">JIPs</a>
          <a href={url('#alliance')} class="text-xs font-semibold text-slate-300 transition-colors hover:text-white">Partners</a>
          <a href={url('about/')} class="text-xs font-semibold text-slate-300 transition-colors hover:text-white">About</a>
        </div>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="rounded-xl border border-white/10 bg-white/5 p-2.5 text-slate-200 lg:hidden"
          aria-label="Open navigation menu"
          aria-controls="mobile-drawer"
          aria-expanded="false"
        >
          <i id="menu-icon" class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
      </div>

      <div id="mobile-drawer" class="hidden border-t border-white/10 bg-[#040812]/98 px-6 py-6 lg:hidden" aria-hidden="true">
        <div class="mx-auto flex max-w-7xl flex-col">
          <a href={url('scope/')} class="mobile-nav-link border-b border-white/5 py-3 text-sm font-bold text-cyan-300">Scope a Project</a>
          <a href={url('focus-areas/')} class="mobile-nav-link border-b border-white/5 py-3 text-sm font-semibold text-slate-200">Solutions / Capabilities</a>
          <a href={url('jips/')} class="mobile-nav-link border-b border-white/5 py-3 text-sm font-semibold text-slate-200">JIPs</a>
          <a href={url('#alliance')} class="mobile-nav-link border-b border-white/5 py-3 text-sm font-semibold text-slate-200">Partners</a>
          <a href={url('about/')} class="mobile-nav-link py-3 text-sm font-semibold text-slate-200">About</a>
        </div>
      </div>
    </nav>

    <main id="main-content" class="min-h-screen pt-16" tabindex="-1">
      <slot />
    </main>

    <PWAController base={base} />
    <CollaborationModal />
    <CollaborationEmailAction />

    <footer class="border-t border-white/10 bg-[#03060E] py-14 text-slate-400">
      <div class="mx-auto max-w-7xl px-6 sm:px-8">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
          <div class="md:col-span-6">
            <Image src={logo} alt="OceanHub" width={220} class="w-40 brightness-0 invert opacity-90" />
            <p class="mt-5 max-w-xl text-sm leading-relaxed text-slate-400">
              Offshore decision intelligence that connects engineering questions to traceable evidence, delivery capabilities and collaboration pathways.
            </p>
          </div>
          <div class="md:col-span-3">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-slate-500">Product</p>
            <div class="mt-4 flex flex-col gap-3 text-sm">
              <a href={url('scope/')} class="hover:text-white">Scope a Project</a>
              <a href={url('focus-areas/')} class="hover:text-white">Solutions / Capabilities</a>
              <a href={url('insights/')} class="hover:text-white">Engineering Intelligence</a>
            </div>
          </div>
          <div class="md:col-span-3">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-slate-500">Collaboration</p>
            <div class="mt-4 flex flex-col gap-3 text-sm">
              <a href={url('jips/')} class="hover:text-white">Proposed JIPs</a>
              <a href={url('#alliance')} class="hover:text-white">Partner Network</a>
              <a href={url('about/')} class="hover:text-white">About OceanHub</a>
            </div>
          </div>
        </div>
        <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-slate-600 sm:flex-row sm:items-center sm:justify-between">
          <p>&copy; {new Date().getFullYear()} OceanHub.</p>
          <p>Green Offshore Technology Alliance is a forming collaboration initiative.</p>
        </div>
      </div>
    </footer>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll('.reveal');

      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealItems.forEach((item) => item.classList.add('active'));
      } else {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
              revealObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        revealItems.forEach((item) => revealObserver.observe(item));
      }

      const nav = document.getElementById('main-nav');
      window.addEventListener('scroll', () => {
        nav?.classList.toggle('shadow-[0_12px_30px_rgba(0,0,0,0.2)]', window.scrollY > 24);
      }, { passive: true });

      const menuToggle = document.getElementById('mobile-menu-toggle');
      const mobileDrawer = document.getElementById('mobile-drawer');
      const menuIcon = document.getElementById('menu-icon');

      function setMenu(open: boolean) {
        if (!menuToggle || !mobileDrawer || !menuIcon) return;
        mobileDrawer.classList.toggle('hidden', !open);
        mobileDrawer.setAttribute('aria-hidden', String(!open));
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        menuIcon.classList.toggle('fa-bars', !open);
        menuIcon.classList.toggle('fa-xmark', open);
      }

      menuToggle?.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'));
      document.querySelectorAll('.mobile-nav-link').forEach((link) => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenu(false);
      });
    </script>
  </body>
</html>