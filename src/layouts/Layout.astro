---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/oceanhub-logo-v2.png';
import TechBackground from '../components/TechBackground.astro';
import PWAController from '../components/PWAController.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'OceanHub connects offshore energy, marine monitoring, geophysics and geotechnical expertise around decision-ready data.'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="alternate icon" href={url('favicon.ico')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060B14" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="OceanHub" />
    <meta name="application-name" content="OceanHub" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OceanHub" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  </head>
  <body class="bg-[#060B14] text-slate-100 min-h-screen flex flex-col font-sans">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <TechBackground />

    <nav id="main-nav" class="fixed top-0 w-full z-50 transition-all duration-500 glass-nav py-4" aria-label="Primary navigation">
      <div class="max-w-[1720px] mx-auto px-6 md:px-12 flex justify-between items-center">
        <div class="flex items-center gap-6">
          <a href={url()} class="flex items-center gap-3 group" aria-label="OceanHub home">
            <div class="relative">
              <Image src={logo} alt="OceanHub" width={200} class="w-36 md:w-48 brightness-0 invert opacity-95 group-hover:opacity-100 transition-opacity" />
              <div class="absolute -inset-1 bg-cyan-500/20 blur-md opacity-0 group-hover:opacity-100 transition-opacity -z-10"></div>
            </div>
          </a>
          <div class="hidden xl:flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/40 border border-cyan-500/20 text-[11px] font-mono text-cyan-300/80">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <span>OFFSHORE DATA COLLABORATION</span>
          </div>
        </div>

        <div class="hidden lg:flex items-center space-x-8 xl:space-x-10">
          <a href={url('#focus-areas')} class="nav-link text-xs font-bold uppercase tracking-[0.2em] text-slate-300 hover:text-cyan-400 transition-colors py-2 relative group">
            Focus Areas
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyan-400 group-hover:w-full transition-all duration-300"></span>
          </a>
          <a href={url('insights/')} class="nav-link text-xs font-bold uppercase tracking-[0.2em] text-slate-300 hover:text-cyan-400 transition-colors py-2 relative group">
            Intelligence
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyan-400 group-hover:w-full transition-all duration-300"></span>
          </a>
          <a href={url('about/')} class="nav-link text-xs font-bold uppercase tracking-[0.2em] text-slate-300 hover:text-cyan-400 transition-colors py-2 relative group">
            About
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-cyan-400 group-hover:w-full transition-all duration-300"></span>
          </a>

          <button class="nav-pwa-install-btn hidden items-center gap-2 px-4 py-2 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-500/20 text-xs font-mono font-semibold tracking-wider uppercase transition-all" type="button">
            <i class="fa-solid fa-download text-xs" aria-hidden="true"></i>
            <span>Install</span>
          </button>

          <a href="mailto:info@oceanhub.com" class="relative group inline-flex items-center justify-center p-0.5 overflow-hidden rounded-full font-bold text-xs uppercase tracking-[0.2em]">
            <span class="w-full h-full bg-gradient-to-br from-cyan-400 via-blue-500 to-indigo-600 group-hover:from-cyan-300 group-hover:to-blue-400 absolute"></span>
            <span class="relative px-6 py-2.5 transition-all ease-out bg-[#060B14] rounded-full group-hover:bg-opacity-0 text-white font-mono tracking-wider">Propose a Collaboration</span>
          </a>
        </div>

        <div class="flex items-center gap-3 lg:hidden">
          <button class="nav-pwa-install-btn hidden p-2.5 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-sm" type="button" aria-label="Install OceanHub">
            <i class="fa-solid fa-download" aria-hidden="true"></i>
          </button>
          <button id="mobile-menu-toggle" class="p-2.5 rounded-xl bg-white/5 border border-white/10 text-slate-300 hover:text-white" type="button" aria-label="Open navigation menu" aria-controls="mobile-drawer" aria-expanded="false">
            <i id="menu-icon" class="fa-solid fa-bars text-lg" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <div id="mobile-drawer" class="lg:hidden hidden border-t border-cyan-500/10 bg-[#060B14]/95 backdrop-blur-2xl px-6 py-6" aria-hidden="true">
        <div class="flex flex-col space-y-4">
          <a href={url('#focus-areas')} class="mobile-nav-link text-sm font-bold uppercase tracking-widest text-slate-300 hover:text-cyan-400 py-2 border-b border-white/5">Strategic Focus Areas</a>
          <a href={url('insights/')} class="mobile-nav-link text-sm font-bold uppercase tracking-widest text-slate-300 hover:text-cyan-400 py-2 border-b border-white/5">Marine Intelligence</a>
          <a href={url('about/')} class="mobile-nav-link text-sm font-bold uppercase tracking-widest text-slate-300 hover:text-cyan-400 py-2 border-b border-white/5">About OceanHub</a>
          <div class="pt-2 flex flex-col gap-3">
            <button class="nav-pwa-install-btn hidden w-full py-3 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono font-bold uppercase tracking-wider items-center justify-center gap-2" type="button">
              <i class="fa-solid fa-download" aria-hidden="true"></i> Install OceanHub
            </button>
            <a href="mailto:info@oceanhub.com" class="w-full py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-slate-950 text-center text-xs font-bold uppercase tracking-widest font-mono">Propose a Collaboration</a>
          </div>
        </div>
      </div>
    </nav>

    <main id="main-content" class="flex-grow pt-20" tabindex="-1">
      <slot />
    </main>

    <PWAController base={base} />

    <footer class="bg-[#04070D] text-slate-400 border-t border-cyan-500/10 py-20 md:py-28 relative overflow-hidden mt-20">
      <div class="absolute -top-32 right-1/4 w-96 h-96 bg-cyan-500/5 rounded-full blur-[140px] pointer-events-none"></div>
      <div class="absolute -bottom-32 left-10 w-96 h-96 bg-blue-600/5 rounded-full blur-[140px] pointer-events-none"></div>
      <div class="max-w-[1720px] mx-auto px-6 md:px-12 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-20">
          <div class="lg:col-span-5 space-y-6">
            <Image src={logo} alt="OceanHub" width={220} class="w-48 brightness-0 invert opacity-95" />
            <p class="text-base text-slate-400 font-light leading-relaxed max-w-lg">A shared platform connecting offshore operators, marine-data specialists and technical partners around decision-ready evidence.</p>
            <p class="text-xs font-mono text-cyan-300/80">STATIC-FIRST DELIVERY · INSTALLABLE · OFFLINE FALLBACK</p>
          </div>

          <div class="lg:col-span-2 space-y-4">
            <h2 class="text-xs font-mono font-bold uppercase tracking-[0.25em] text-cyan-400">Explore</h2>
            <ul class="space-y-3 text-sm">
              <li><a href={url('#focus-areas')} class="text-slate-400 hover:text-cyan-300 transition-colors">Focus Areas</a></li>
              <li><a href={url('insights/')} class="text-slate-400 hover:text-cyan-300 transition-colors">Intelligence</a></li>
              <li><a href={url('about/')} class="text-slate-400 hover:text-cyan-300 transition-colors">Platform Mission</a></li>
              <li><a href={url('offline/')} class="text-slate-400 hover:text-cyan-300 transition-colors">Offline Access</a></li>
            </ul>
          </div>

          <div class="lg:col-span-2 space-y-4">
            <h2 class="text-xs font-mono font-bold uppercase tracking-[0.25em] text-cyan-400">Focus Areas</h2>
            <ul class="space-y-3 text-sm">
              <li><a href={url('focus-areas/ccus/')} class="text-slate-400 hover:text-cyan-300 transition-colors">Offshore CCUS</a></li>
              <li><a href={url('focus-areas/offshore-energy/')} class="text-slate-400 hover:text-cyan-300 transition-colors">Offshore Energy</a></li>
              <li><a href={url('focus-areas/marine-ecology/')} class="text-slate-400 hover:text-cyan-300 transition-colors">Marine Ecology</a></li>
              <li><a href={url('focus-areas/offshore-infrastructure/')} class="text-slate-400 hover:text-cyan-300 transition-colors">Infrastructure</a></li>
            </ul>
          </div>

          <div class="lg:col-span-3 space-y-4">
            <h2 class="text-xs font-mono font-bold uppercase tracking-[0.25em] text-cyan-400">Connect</h2>
            <p class="text-sm text-slate-400">Bring an offshore problem, dataset or capability to the network.</p>
            <div class="flex gap-4 pt-2">
              <a href="mailto:info@oceanhub.com" class="w-11 h-11 rounded-xl bg-white/5 border border-white/10 hover:border-cyan-400/50 hover:bg-cyan-500/10 text-slate-300 hover:text-cyan-300 flex items-center justify-center transition-all" aria-label="Email OceanHub"><i class="fa-solid fa-envelope" aria-hidden="true"></i></a>
              <a href="https://rio25.sbgf.org.br/Pages/oceanHub.php" target="_blank" rel="noopener noreferrer" class="w-11 h-11 rounded-xl bg-white/5 border border-white/10 hover:border-cyan-400/50 hover:bg-cyan-500/10 text-slate-300 hover:text-cyan-300 flex items-center justify-center transition-all" aria-label="OceanHub at SBGf Rio 25"><i class="fa-solid fa-globe" aria-hidden="true"></i></a>
            </div>
          </div>
        </div>

        <div class="mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-mono text-slate-500">
          <p>&copy; {new Date().getFullYear()} OceanHub. Marine data for offshore decisions.</p>
          <span>BUILT WITH ASTRO · DEPLOYED ON GITHUB PAGES</span>
        </div>
      </div>
    </footer>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll('.reveal');

      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealItems.forEach((item) => item.classList.add('active'));
      } else {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
              revealObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        revealItems.forEach((item) => revealObserver.observe(item));
      }

      const nav = document.getElementById('main-nav');
      window.addEventListener('scroll', () => {
        if (!nav) return;
        nav.classList.toggle('nav-scrolled', window.scrollY > 40);
      }, { passive: true });

      const menuToggle = document.getElementById('mobile-menu-toggle');
      const mobileDrawer = document.getElementById('mobile-drawer');
      const menuIcon = document.getElementById('menu-icon');

      function setMenu(open: boolean) {
        if (!menuToggle || !mobileDrawer || !menuIcon) return;
        mobileDrawer.classList.toggle('hidden', !open);
        mobileDrawer.setAttribute('aria-hidden', String(!open));
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        menuIcon.classList.toggle('fa-bars', !open);
        menuIcon.classList.toggle('fa-xmark', open);
      }

      menuToggle?.addEventListener('click', () => {
        setMenu(menuToggle.getAttribute('aria-expanded') !== 'true');
      });
      document.querySelectorAll('.mobile-nav-link').forEach((link) => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setMenu(false);
          menuToggle?.focus();
        }
      });
    </script>
  </body>
</html>
