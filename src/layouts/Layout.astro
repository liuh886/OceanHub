---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/oceanhub-logo-v2.png';
import PWAController from '../components/PWAController.astro';
import CollaborationModal from '../components/CollaborationModal.astro';
import CollaborationEmailAction from '../components/CollaborationEmailAction.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { DARK_THEME_COLOR, LIGHT_THEME_COLOR, THEME_STORAGE_KEY } from '../lib/theme';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'OceanHub turns offshore project decisions into traceable evidence plans, capability needs and collaboration paths.'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark" data-theme-storage-key={THEME_STORAGE_KEY} data-light-theme-color={LIGHT_THEME_COLOR} data-dark-theme-color={DARK_THEME_COLOR}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="alternate icon" href={url('favicon.ico')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#040812" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeStorageKey = root.dataset.themeStorageKey || '';
        const lightThemeColor = root.dataset.lightThemeColor || '';
        const darkThemeColor = root.dataset.darkThemeColor || '';
        if (!themeStorageKey || !lightThemeColor || !darkThemeColor) return;
        let storedTheme = null;
        try {
          storedTheme = localStorage.getItem(themeStorageKey);
        } catch {}
        const theme = storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        root.dataset.theme = theme;
        root.classList.toggle('dark', theme === 'dark');
        root.style.colorScheme = theme;
        const themeColor = document.querySelector('meta[name="theme-color"]');
        themeColor?.setAttribute('content', theme === 'light' ? lightThemeColor : darkThemeColor);
      })();
    </script>
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="OceanHub" />
    <meta name="application-name" content="OceanHub" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OceanHub" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" /></noscript>
  </head>
  <body class="min-h-screen selection:bg-cyan-500/20 selection:text-cyan-200">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <nav id="main-nav" class="site-nav fixed top-0 z-50 w-full border-b py-3.5 backdrop-blur-xl transition-all duration-300" aria-label="Primary navigation">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 sm:px-8">
        <a href={url()} class="flex shrink-0 items-center" aria-label="OceanHub home">
          <Image src={logo} alt="OceanHub" width={220} class="oceanhub-logo w-36 opacity-95 sm:w-40" />
        </a>

        <div class="hidden min-w-0 items-center gap-2 lg:flex">
          <div class="flex items-center gap-6 border-r border-white/10 pr-5">
            <a href={url('capabilities/')} class="text-xs font-semibold text-slate-300 transition-colors hover:text-white">Solutions / Capabilities</a>
            <a href={url('jips/')} class="text-xs font-semibold text-slate-300 transition-colors hover:text-white">JIPs</a>
            <a href={url('partners/')} class="text-xs font-semibold text-slate-300 transition-colors hover:text-white">Partners</a>
            <a href={url('about/')} class="text-xs font-semibold text-slate-300 transition-colors hover:text-white">About</a>
          </div>
          <ThemeToggle />
          <a
            href={url('scope/')}
            class="ml-1 inline-flex min-h-9 items-center justify-center rounded-lg border border-cyan-300/40 bg-cyan-300 px-3.5 text-xs font-bold text-slate-950 shadow-[0_8px_24px_rgba(34,211,238,0.12)] transition hover:bg-cyan-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"
          >
            Scope a Project
          </a>
        </div>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="mobile-menu-toggle grid h-10 w-10 place-items-center rounded-lg border border-white/10 bg-white/[0.04] text-slate-200 transition hover:border-white/20 hover:bg-white/[0.08] lg:hidden"
          aria-label="Open navigation menu"
          aria-controls="mobile-drawer"
          aria-expanded="false"
        >
          <i id="menu-icon" class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
      </div>

      <div id="mobile-drawer" class="mobile-drawer-surface hidden border-t border-white/10 px-5 py-5 lg:hidden" aria-hidden="true">
        <div class="mx-auto flex max-w-7xl flex-col">
          <a href={url('capabilities/')} class="mobile-nav-link border-b border-white/5 py-3 text-sm font-semibold text-slate-200">Solutions / Capabilities</a>
          <a href={url('jips/')} class="mobile-nav-link border-b border-white/5 py-3 text-sm font-semibold text-slate-200">JIPs</a>
          <a href={url('partners/')} class="mobile-nav-link border-b border-white/5 py-3 text-sm font-semibold text-slate-200">Partners</a>
          <a href={url('about/')} class="mobile-nav-link border-b border-white/5 py-3 text-sm font-semibold text-slate-200">About</a>
          <div class="mt-4">
            <ThemeToggle variant="row" />
          </div>
          <a
            href={url('scope/')}
            class="mobile-nav-link mt-3 inline-flex min-h-11 items-center justify-center rounded-lg bg-cyan-300 px-4 text-sm font-bold text-slate-950"
          >
            Scope a Project
          </a>
        </div>
      </div>
    </nav>

    <main id="main-content" class="min-h-screen pt-16" tabindex="-1">
      <slot />
    </main>

    <PWAController base={base} />
    <CollaborationModal />
    <CollaborationEmailAction />

    <footer class="site-footer border-t py-14 text-slate-400">
      <div class="mx-auto max-w-7xl px-6 sm:px-8">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
          <div class="md:col-span-6">
            <Image src={logo} alt="OceanHub" width={220} class="oceanhub-logo w-40 opacity-90" />
            <p class="mt-5 max-w-xl text-sm leading-relaxed text-slate-400">
              Offshore decision intelligence that connects engineering questions to traceable evidence, delivery capabilities and collaboration pathways.
            </p>
          </div>
          <div class="md:col-span-3">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-slate-500">Product</p>
            <div class="mt-4 flex flex-col gap-3 text-sm">
              <a href={url('scope/')} class="hover:text-white">Scope a Project</a>
              <a href={url('capabilities/')} class="hover:text-white">Solutions / Capabilities</a>
              <a href={url('insights/')} class="hover:text-white">Engineering Intelligence</a>
            </div>
          </div>
          <div class="md:col-span-3">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-slate-500">Collaboration</p>
            <div class="mt-4 flex flex-col gap-3 text-sm">
              <a href={url('jips/')} class="hover:text-white">Proposed JIPs</a>
              <a href={url('partners/')} class="hover:text-white">Partner Capability Evidence</a>
              <a href={url('about/')} class="hover:text-white">About OceanHub</a>
            </div>
          </div>
        </div>
        <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-slate-600 sm:flex-row sm:items-center sm:justify-between">
          <p>&copy; {new Date().getFullYear()} OceanHub.</p>
          <p>Green Offshore Technology Alliance is a forming collaboration initiative.</p>
        </div>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const themeStorageKey = root.dataset.themeStorageKey || '';
      const lightThemeColor = root.dataset.lightThemeColor || '';
      const darkThemeColor = root.dataset.darkThemeColor || '';
      if (!themeStorageKey || !lightThemeColor || !darkThemeColor) throw new Error('OceanHub theme configuration is missing.');
      const themeMedia = window.matchMedia('(prefers-color-scheme: light)');
      const themeToggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

      function storedTheme() {
        try {
          const value = localStorage.getItem(themeStorageKey);
          return value === 'light' || value === 'dark' ? value : null;
        } catch {
          return null;
        }
      }

      function updateThemeControls(theme: 'light' | 'dark') {
        const target = theme === 'dark' ? 'light' : 'dark';
        const targetLabel = target === 'light' ? 'Light' : 'Dark';
        themeToggles.forEach((button) => {
          button.setAttribute('aria-label', `Switch to ${target} theme`);
          button.setAttribute('title', `Switch to ${target} theme`);
          const label = button.querySelector<HTMLElement>('[data-theme-toggle-label]');
          if (label) label.textContent = `${targetLabel} theme`;
        });
      }

      function applyTheme(theme: 'light' | 'dark', persist = false) {
        const root = document.documentElement;
        root.dataset.theme = theme;
        root.classList.toggle('dark', theme === 'dark');
        root.style.colorScheme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? lightThemeColor : darkThemeColor);
        if (persist) {
          try {
            localStorage.setItem(themeStorageKey, theme);
          } catch {}
        }
        updateThemeControls(theme);
      }

      const initialTheme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      applyTheme(initialTheme);

      themeToggles.forEach((button) => {
        button.addEventListener('click', () => {
          const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
          applyTheme(current === 'light' ? 'dark' : 'light', true);
        });
      });

      themeMedia.addEventListener('change', (event) => {
        if (!storedTheme()) applyTheme(event.matches ? 'light' : 'dark');
      });

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll('.reveal');

      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealItems.forEach((item) => item.classList.add('active'));
      } else {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
              revealObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        revealItems.forEach((item) => revealObserver.observe(item));
      }

      const nav = document.getElementById('main-nav');
      window.addEventListener('scroll', () => {
        nav?.classList.toggle('nav-elevated', window.scrollY > 24);
      }, { passive: true });

      const menuToggle = document.getElementById('mobile-menu-toggle');
      const mobileDrawer = document.getElementById('mobile-drawer');
      const menuIcon = document.getElementById('menu-icon');

      function setMenu(open: boolean) {
        if (!menuToggle || !mobileDrawer || !menuIcon) return;
        mobileDrawer.classList.toggle('hidden', !open);
        mobileDrawer.setAttribute('aria-hidden', String(!open));
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        menuIcon.classList.toggle('fa-bars', !open);
        menuIcon.classList.toggle('fa-xmark', open);
      }

      menuToggle?.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'));
      document.querySelectorAll('.mobile-nav-link').forEach((link) => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenu(false);
      });
    </script>
  </body>
</html>
