---
const base = import.meta.env.BASE_URL;
const responsePath = `${base}respond/`;
---

<section id="provider-response-builder" class="mt-10 hidden rounded-2xl border border-white/10 bg-white/[0.02] p-6 sm:p-8" data-response-path={responsePath} aria-labelledby="provider-response-title">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-300">EOI response loop</p>
      <h2 id="provider-response-title" class="mt-2 text-2xl font-black text-white">Select 2–5 providers and generate response packets.</h2>
      <p class="mt-2 max-w-3xl text-xs leading-relaxed text-slate-500">OceanHub does not invent supplier email addresses or send outreach automatically. Copy each packet into your procurement channel, or share its structured response link with the supplier.</p>
    </div>
    <button id="generate-provider-packets" type="button" disabled class="shrink-0 rounded-xl bg-emerald-400 px-5 py-3 text-xs font-black text-slate-950 disabled:cursor-not-allowed disabled:opacity-40">Generate response packets</button>
  </div>
  <p id="provider-selection-status" class="mt-4 text-xs text-slate-500" aria-live="polite">Select at least 2 candidate providers from the shortlist above.</p>
  <div id="provider-response-packets" class="mt-6 hidden space-y-5"></div>
</section>

<script>
  interface Capability { id: string; label: string }
  interface PlanItem { capabilities: Capability[] }
  interface Provider { id: string; name: string; capabilityIds: string[] }

  const builder = document.getElementById('provider-response-builder');
  const shortlist = document.getElementById('provider-shortlist');
  const generate = document.getElementById('generate-provider-packets') as HTMLButtonElement | null;
  const status = document.getElementById('provider-selection-status');
  const packets = document.getElementById('provider-response-packets');
  const stage = document.getElementById('scoper-stage') as HTMLSelectElement | null;
  const focus = document.getElementById('scoper-focus') as HTMLSelectElement | null;
  const project = document.getElementById('eoi-project-context') as HTMLInputElement | null;
  const responsePath = builder?.dataset.responsePath || '/respond/';
  const providers = JSON.parse(document.getElementById('market-provider-data')?.textContent ?? '[]') as Provider[];

  const esc = (value: string) => value.replace(/[&<>'\"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '\"': '&quot;' })[character] ?? character);
  const selected = () => Array.from(document.querySelectorAll<HTMLInputElement>('.provider-response-select:checked'));

  function currentPlan() {
    const node = document.getElementById('decision-scoper-data');
    if (!node || !stage || !focus) return [] as PlanItem[];
    const data = JSON.parse(node.textContent ?? '{}') as Record<string, PlanItem[]>;
    return data[`${stage.value}:${focus.value}`] ?? [];
  }

  function requiredCapabilities() {
    return [...new Map(currentPlan().flatMap((item) => item.capabilities).map((capability) => [capability.id, capability])).values()];
  }

  function updateSelectionState() {
    const count = selected().length;
    const all = Array.from(document.querySelectorAll<HTMLInputElement>('.provider-response-select'));
    all.forEach((checkbox) => { checkbox.disabled = count >= 5 && !checkbox.checked; });
    if (generate) generate.disabled = count < 2 || count > 5;
    if (status) status.textContent = count === 0
      ? 'Select at least 2 candidate providers from the shortlist above.'
      : count < 2
        ? `${count} selected · choose at least one more provider.`
        : `${count} selected · ready to generate provider-specific response packets.`;
  }

  function decorateShortlist() {
    const cards = Array.from(shortlist?.querySelectorAll<HTMLElement>('[data-provider-match]') ?? []);
    if (!cards.length) {
      builder?.classList.add('hidden');
      return;
    }
    builder?.classList.remove('hidden');
    cards.forEach((card) => {
      if (card.querySelector('.provider-response-select')) return;
      const providerId = card.dataset.providerMatch || '';
      const provider = providers.find((item) => item.id === providerId);
      if (!provider) return;
      const label = document.createElement('label');
      label.className = 'mt-4 flex cursor-pointer items-center gap-2 rounded-xl border border-white/10 bg-white/[0.025] px-3 py-2.5 text-xs font-bold text-slate-200';
      label.innerHTML = `<input type="checkbox" class="provider-response-select h-4 w-4 rounded border-white/20 bg-slate-950" value="${esc(providerId)}" /> <span>Select ${esc(provider.name)} for response request</span>`;
      card.appendChild(label);
      label.querySelector('input')?.addEventListener('change', updateSelectionState);
    });
    if (packets) { packets.classList.add('hidden'); packets.innerHTML = ''; }
    updateSelectionState();
  }

  const observer = new MutationObserver(decorateShortlist);
  if (shortlist) observer.observe(shortlist, { childList: true });
  decorateShortlist();

  function makeRequestId() {
    return `OH-${Date.now().toString(36).toUpperCase()}-${Math.random().toString(36).slice(2, 6).toUpperCase()}`;
  }

  generate?.addEventListener('click', () => {
    const chosen = selected();
    if (chosen.length < 2 || chosen.length > 5 || !packets) return;
    const required = requiredCapabilities();
    if (!required.length) return;
    const requiredIds = required.map((capability) => capability.id);
    const capabilityById = new Map(required.map((capability) => [capability.id, capability.label]));
    const stageLabel = stage?.selectedOptions[0]?.textContent?.trim() || stage?.value || '';
    const focusLabel = focus?.selectedOptions[0]?.textContent?.trim() || focus?.value || '';
    const projectContext = project?.value.trim() || '[project / region not provided]';
    const requestId = makeRequestId();

    packets.innerHTML = chosen.map((checkbox) => {
      const provider = providers.find((item) => item.id === checkbox.value);
      if (!provider) return '';
      const matched = requiredIds.filter((id) => provider.capabilityIds.includes(id));
      const missing = requiredIds.filter((id) => !provider.capabilityIds.includes(id));
      const url = new URL(responsePath, window.location.origin);
      url.searchParams.set('request', requestId);
      url.searchParams.set('provider', provider.id);
      url.searchParams.set('caps', requiredIds.join(','));
      url.searchParams.set('mapped', matched.join(','));
      url.searchParams.set('project', projectContext);
      url.searchParams.set('stage', stageLabel);
      url.searchParams.set('focus', focusLabel);
      const text = [
        'OceanHub — Supplier EOI Response Request',
        '',
        `Request ID: ${requestId}`,
        `Provider: ${provider.name} (${provider.id})`,
        `Project / region: ${projectContext}`,
        `Lifecycle stage: ${stageLabel}`,
        `Decision focus: ${focusLabel}`,
        '',
        'Capabilities currently evidenced by public mapping:',
        ...(matched.length ? matched.map((id) => `- ${id} — ${capabilityById.get(id) || id}`) : ['- None']),
        '',
        'EOI requirements not covered by the current public mapping:',
        ...(missing.length ? missing.map((id) => `- ${id} — ${capabilityById.get(id) || id}`) : ['- None']),
        '',
        'Supplier action requested:',
        '- Confirm which requested canonical capabilities you can directly deliver.',
        '- Provide one strong evidence item for each capability claimed.',
        '- State operating regions / mobilization basis and response contact.',
        '',
        `Structured response link: ${url.toString()}`,
        '',
        'OceanHub note: public-source mapping is a discovery aid, not an endorsement. Supplier-submitted evidence remains evidence-submitted until reviewed.'
      ].join('\n');
      return `<article class="rounded-2xl border border-white/10 bg-black/20 p-5" data-provider-response-packet="${esc(provider.id)}">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><p class="font-mono text-[10px] uppercase tracking-[0.14em] text-emerald-300">${esc(requestId)}</p><h3 class="mt-1 text-lg font-bold text-white">${esc(provider.name)} response packet</h3><p class="mt-1 text-xs text-slate-500">${matched.length}/${requiredIds.length} requirements currently covered by public-source mapping.</p></div><a href="${esc(url.toString())}" target="_blank" rel="noopener noreferrer" class="shrink-0 rounded-xl border border-emerald-400/25 bg-emerald-500/10 px-4 py-2.5 text-xs font-bold text-emerald-100">Open supplier response ↗</a></div>
        <pre class="provider-response-text mt-4 max-h-72 overflow-auto whitespace-pre-wrap rounded-xl border border-white/10 bg-slate-950/60 p-4 text-[11px] leading-5 text-slate-400">${esc(text)}</pre>
        <button type="button" class="copy-provider-response mt-3 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-[11px] font-bold text-white">Copy response request</button>
      </article>`;
    }).join('');
    packets.classList.remove('hidden');
    packets.querySelectorAll<HTMLButtonElement>('.copy-provider-response').forEach((button) => button.addEventListener('click', async () => {
      const text = button.closest('[data-provider-response-packet]')?.querySelector('.provider-response-text')?.textContent || '';
      await navigator.clipboard.writeText(text);
      const original = button.textContent || 'Copy response request';
      button.textContent = 'Copied';
      window.setTimeout(() => { button.textContent = original; }, 1400);
    }));
  });
</script>
