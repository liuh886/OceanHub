---
// PWA Controller Component for Service Worker registration, install prompts, and status toasts
---

<div id="pwa-root" class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3 pointer-events-none">
  <!-- Offline / Online Notification Toast -->
  <div id="network-toast" class="hidden pointer-events-auto transform translate-y-4 opacity-0 transition-all duration-500 max-w-sm rounded-2xl glass-panel-dark px-5 py-3.5 border border-cyan-500/30 shadow-[0_10px_30px_rgba(0,0,0,0.5)] flex items-center gap-3">
    <div id="network-toast-icon" class="w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center shrink-0 border border-cyan-400/30">
      <i class="fa-solid fa-wifi text-sm"></i>
    </div>
    <div class="text-xs">
      <div id="network-toast-title" class="font-bold text-white font-mono tracking-wide">Network Uplink Active</div>
      <div id="network-toast-desc" class="text-slate-400 text-[11px]">Synchronized with live data stream</div>
    </div>
  </div>

  <!-- App Update Available Toast -->
  <div id="update-toast" class="hidden pointer-events-auto transform translate-y-4 opacity-0 transition-all duration-500 max-w-sm rounded-2xl glass-panel-dark px-5 py-4 border border-blue-500/30 shadow-[0_10px_30px_rgba(0,0,0,0.5)] flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center shrink-0 border border-blue-400/30 animate-pulse">
        <i class="fa-solid fa-cloud-arrow-down text-sm"></i>
      </div>
      <div>
        <div class="font-bold text-white text-xs font-mono">Telemetry Update Ready</div>
        <div class="text-slate-400 text-[11px]">New version cached in background</div>
      </div>
    </div>
    <button id="pwa-reload-btn" class="px-3.5 py-1.5 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-colors">
      Reload
    </button>
  </div>

  <!-- PWA Install Modal / Banner for users -->
  <div id="pwa-install-banner" class="hidden pointer-events-auto transform translate-y-8 opacity-0 transition-all duration-500 max-w-md w-full rounded-2xl glass-panel-dark p-5 border border-cyan-500/40 shadow-[0_15px_40px_rgba(0,0,0,0.6)] backdrop-blur-xl relative overflow-hidden">
    <div class="absolute top-0 right-0 w-32 h-32 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none"></div>
    <div class="flex items-start gap-4 relative z-10">
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-cyan-500/20 to-blue-600/30 border border-cyan-400/40 flex items-center justify-center text-cyan-400 shadow-[0_0_15px_rgba(0,240,255,0.2)] shrink-0">
        <i class="fa-solid fa-download text-lg"></i>
      </div>
      <div class="flex-grow">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono font-semibold text-cyan-400 uppercase tracking-widest">PWA Ready</span>
          <button id="pwa-dismiss-btn" class="text-slate-400 hover:text-white transition-colors text-xs p-1" aria-label="Dismiss">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
        <h4 class="text-sm font-bold text-white mt-0.5 font-display">Install OceanHub App</h4>
        <p class="text-slate-400 text-xs mt-1 leading-relaxed">
          Install as a native desktop / mobile app for instant offline access and seamless intelligence monitoring.
        </p>
        <div class="mt-3.5 flex items-center gap-2">
          <button id="pwa-confirm-install-btn" class="px-4 py-1.5 rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs tracking-wider uppercase shadow-[0_0_15px_rgba(0,240,255,0.3)] transition-all">
            Install App
          </button>
          <button id="pwa-later-btn" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 text-xs transition-colors">
            Maybe Later
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Service Worker & PWA Lifecycle Logic
  let deferredPrompt: any = null;
  let newWorker: ServiceWorker | null = null;

  // 1. Service Worker Registration
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      // Determine service worker path
      const swUrl = './sw.js';
      navigator.serviceWorker.register(swUrl)
        .then((registration) => {
          console.log('[OceanHub PWA] ServiceWorker registered with scope:', registration.scope);

          // Listen for updates
          registration.addEventListener('updatefound', () => {
            newWorker = registration.installing;
            if (newWorker) {
              newWorker.addEventListener('statechange', () => {
                if (newWorker && newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                  showUpdateToast();
                }
              });
            }
          });
        })
        .catch((error) => {
          console.warn('[OceanHub PWA] ServiceWorker registration failed:', error);
        });

      let refreshing = false;
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (!refreshing) {
          refreshing = true;
          window.location.reload();
        }
      });
    });
  }

  // 2. Install Prompt Handlers
  const installBanner = document.getElementById('pwa-install-banner');
  const confirmInstallBtn = document.getElementById('pwa-confirm-install-btn');
  const laterBtn = document.getElementById('pwa-later-btn');
  const dismissBtn = document.getElementById('pwa-dismiss-btn');
  const navInstallButtons = document.querySelectorAll('.nav-pwa-install-btn');

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;

    // Show nav install buttons
    navInstallButtons.forEach((btn) => {
      btn.classList.remove('hidden');
      btn.classList.add('inline-flex');
    });

    // Check if user dismissed banner recently
    const dismissedAt = localStorage.getItem('oceanhub_pwa_dismissed');
    const isRecentlyDismissed = dismissedAt && (Date.now() - parseInt(dismissedAt, 10)) < 86400000 * 3; // 3 days

    if (!isRecentlyDismissed && installBanner) {
      setTimeout(() => {
        showBanner(installBanner);
      }, 3000);
    }
  });

  window.addEventListener('appinstalled', () => {
    deferredPrompt = null;
    hideBanner(installBanner);
    navInstallButtons.forEach(btn => btn.classList.add('hidden'));
    showToast('App Installed Successfully', 'OceanHub is now running as a standalone app.', 'success');
  });

  async function triggerInstallPrompt() {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    const { outcome } = await deferredPrompt.userChoice;
    console.log('[OceanHub PWA] User choice:', outcome);
    deferredPrompt = null;
    hideBanner(installBanner);
  }

  if (confirmInstallBtn) {
    confirmInstallBtn.addEventListener('click', triggerInstallPrompt);
  }

  navInstallButtons.forEach((btn) => {
    btn.addEventListener('click', triggerInstallPrompt);
  });

  function dismissInstall() {
    hideBanner(installBanner);
    localStorage.setItem('oceanhub_pwa_dismissed', Date.now().toString());
  }

  if (laterBtn) laterBtn.addEventListener('click', dismissInstall);
  if (dismissBtn) dismissBtn.addEventListener('click', dismissInstall);

  // 3. Update Notification
  const updateToast = document.getElementById('update-toast');
  const reloadBtn = document.getElementById('pwa-reload-btn');

  function showUpdateToast() {
    if (updateToast) {
      updateToast.classList.remove('hidden');
      setTimeout(() => {
        updateToast.classList.remove('translate-y-4', 'opacity-0');
        updateToast.classList.add('translate-y-0', 'opacity-100');
      }, 50);
    }
  }

  if (reloadBtn) {
    reloadBtn.addEventListener('click', () => {
      if (newWorker) {
        newWorker.postMessage({ type: 'SKIP_WAITING' });
      }
    });
  }

  // 4. Online / Offline Toast
  const networkToast = document.getElementById('network-toast');
  const toastTitle = document.getElementById('network-toast-title');
  const toastDesc = document.getElementById('network-toast-desc');
  const toastIcon = document.getElementById('network-toast-icon');

  function showToast(title: string, desc: string, type: 'online' | 'offline' | 'success') {
    if (!networkToast || !toastTitle || !toastDesc || !toastIcon) return;

    toastTitle.textContent = title;
    toastDesc.textContent = desc;

    if (type === 'offline') {
      toastIcon.className = 'w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 border border-amber-400/30';
      toastIcon.innerHTML = '<i class="fa-solid fa-satellite-dish text-sm animate-pulse"></i>';
      networkToast.className = networkToast.className.replace(/border-cyan-500\/30|border-emerald-500\/30/, 'border-amber-500/40');
    } else if (type === 'online') {
      toastIcon.className = 'w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-400/30';
      toastIcon.innerHTML = '<i class="fa-solid fa-wifi text-sm"></i>';
      networkToast.className = networkToast.className.replace(/border-amber-500\/40|border-cyan-500\/30/, 'border-emerald-500/30');
    } else {
      toastIcon.className = 'w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center shrink-0 border border-cyan-400/30';
      toastIcon.innerHTML = '<i class="fa-solid fa-circle-check text-sm"></i>';
    }

    networkToast.classList.remove('hidden');
    setTimeout(() => {
      networkToast.classList.remove('translate-y-4', 'opacity-0');
      networkToast.classList.add('translate-y-0', 'opacity-100');
    }, 50);

    setTimeout(() => {
      networkToast.classList.add('translate-y-4', 'opacity-0');
      networkToast.classList.remove('translate-y-0', 'opacity-100');
      setTimeout(() => networkToast.classList.add('hidden'), 500);
    }, 4500);
  }

  window.addEventListener('online', () => {
    showToast('Telemetry Uplink Restored', 'Live stream synchronized with server.', 'online');
  });

  window.addEventListener('offline', () => {
    showToast('Autonomous Offline Mode', 'Operating seamlessly on local cache.', 'offline');
  });

  // Helpers
  function showBanner(el: HTMLElement | null) {
    if (!el) return;
    el.classList.remove('hidden');
    setTimeout(() => {
      el.classList.remove('translate-y-8', 'opacity-0');
      el.classList.add('translate-y-0', 'opacity-100');
    }, 50);
  }

  function hideBanner(el: HTMLElement | null) {
    if (!el) return;
    el.classList.add('translate-y-8', 'opacity-0');
    el.classList.remove('translate-y-0', 'opacity-100');
    setTimeout(() => el.classList.add('hidden'), 500);
  }
</script>
