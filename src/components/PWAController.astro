---
interface Props {
  base: string;
}

const { base } = Astro.props;
---

<div id="pwa-root" data-base={base} class="hidden" aria-hidden="true"></div>

<script>
  const pwaRoot = document.getElementById('pwa-root');
  const base = pwaRoot?.dataset.base || '/';

  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker
        .register(`${base}sw.js`, { scope: base })
        .catch((error) => console.warn('[OceanHub] Service worker registration failed:', error));
    });
  }
</script>
