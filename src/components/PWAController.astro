---
interface Props {
  base: string;
}

const { base } = Astro.props;
---

<div id="pwa-root" data-base={base} class="fixed bottom-4 right-4 left-4 sm:left-auto sm:bottom-6 sm:right-6 z-50 flex flex-col items-end gap-3 pointer-events-none">
  <div id="network-toast" class="hidden pointer-events-auto transform translate-y-4 opacity-0 transition-all duration-300 max-w-sm rounded-2xl glass-panel-dark px-5 py-3.5 border border-cyan-500/30 shadow-[0_10px_30px_rgba(0,0,0,0.5)] flex items-center gap-3" role="status" aria-live="polite">
    <div id="network-toast-icon" class="w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center shrink-0 border border-cyan-400/30" aria-hidden="true">
      <i class="fa-solid fa-wifi text-sm"></i>
    </div>
    <div class="text-xs">
      <div id="network-toast-title" class="font-bold text-white font-mono tracking-wide">Connection available</div>
      <div id="network-toast-desc" class="text-slate-400 text-[11px]">Latest content can be loaded from the network.</div>
    </div>
  </div>

  <div id="update-toast" class="hidden pointer-events-auto transform translate-y-4 opacity-0 transition-all duration-300 max-w-sm rounded-2xl glass-panel-dark px-5 py-4 border border-blue-500/30 shadow-[0_10px_30px_rgba(0,0,0,0.5)] flex items-center justify-between gap-4" role="status" aria-live="polite">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center shrink-0 border border-blue-400/30" aria-hidden="true">
        <i class="fa-solid fa-cloud-arrow-down text-sm"></i>
      </div>
      <div>
        <div class="font-bold text-white text-xs font-mono">Update ready</div>
        <div class="text-slate-400 text-[11px]">Reload to use the latest OceanHub version.</div>
      </div>
    </div>
    <button id="pwa-reload-btn" type="button" class="px-3.5 py-1.5 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-colors">Reload</button>
  </div>

  <div id="pwa-install-banner" class="hidden pointer-events-auto transform translate-y-8 opacity-0 transition-all duration-300 max-w-md w-full rounded-2xl glass-panel-dark p-5 border border-cyan-500/40 shadow-[0_15px_40px_rgba(0,0,0,0.6)] backdrop-blur-xl relative overflow-hidden" role="dialog" aria-modal="false" aria-labelledby="pwa-install-title" aria-describedby="pwa-install-description">
    <div class="absolute top-0 right-0 w-32 h-32 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none"></div>
    <div class="flex items-start gap-4 relative z-10">
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-cyan-500/20 to-blue-600/30 border border-cyan-400/40 flex items-center justify-center text-cyan-400 shrink-0" aria-hidden="true">
        <i class="fa-solid fa-download text-lg"></i>
      </div>
      <div class="flex-grow">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono font-semibold text-cyan-400 uppercase tracking-widest">Offline-ready</span>
          <button id="pwa-dismiss-btn" type="button" class="text-slate-400 hover:text-white transition-colors text-xs p-2 -mr-2 -mt-2" aria-label="Dismiss install suggestion">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </div>
        <h2 id="pwa-install-title" class="text-sm font-bold text-white mt-0.5 font-display">Install OceanHub</h2>
        <p id="pwa-install-description" class="text-slate-400 text-xs mt-1 leading-relaxed">Add OceanHub to this device for faster access and an offline fallback when connectivity is limited.</p>
        <div class="mt-3.5 flex items-center gap-2">
          <button id="pwa-confirm-install-btn" type="button" class="px-4 py-2 rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold text-xs tracking-wider uppercase transition-all">Install</button>
          <button id="pwa-later-btn" type="button" class="px-3 py-2 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 text-xs transition-colors">Later</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const pwaRoot = document.getElementById('pwa-root');
  const base = pwaRoot?.dataset.base || '/';
  let deferredPrompt: any = null;
  let newWorker: ServiceWorker | null = null;

  const installBanner = document.getElementById('pwa-install-banner');
  const confirmInstallBtn = document.getElementById('pwa-confirm-install-btn');
  const laterBtn = document.getElementById('pwa-later-btn');
  const dismissBtn = document.getElementById('pwa-dismiss-btn');
  const navInstallButtons = document.querySelectorAll<HTMLButtonElement>('.nav-pwa-install-btn');
  const updateToast = document.getElementById('update-toast');
  const reloadBtn = document.getElementById('pwa-reload-btn');
  const networkToast = document.getElementById('network-toast');
  const toastTitle = document.getElementById('network-toast-title');
  const toastDesc = document.getElementById('network-toast-desc');
  const toastIcon = document.getElementById('network-toast-icon');

  function showElement(element: HTMLElement | null, offsetClass: string) {
    if (!element) return;
    element.classList.remove('hidden');
    requestAnimationFrame(() => {
      element.classList.remove(offsetClass, 'opacity-0');
      element.classList.add('translate-y-0', 'opacity-100');
    });
  }

  function hideElement(element: HTMLElement | null, offsetClass: string) {
    if (!element) return;
    element.classList.add(offsetClass, 'opacity-0');
    element.classList.remove('translate-y-0', 'opacity-100');
    window.setTimeout(() => element.classList.add('hidden'), 300);
  }

  function showUpdateToast() {
    showElement(updateToast, 'translate-y-4');
  }

  function showToast(title: string, description: string, type: 'online' | 'offline' | 'success') {
    if (!networkToast || !toastTitle || !toastDesc || !toastIcon) return;
    toastTitle.textContent = title;
    toastDesc.textContent = description;

    const iconClass = type === 'offline'
      ? 'fa-solid fa-cloud text-sm'
      : type === 'success'
        ? 'fa-solid fa-circle-check text-sm'
        : 'fa-solid fa-wifi text-sm';
    toastIcon.innerHTML = `<i class="${iconClass}" aria-hidden="true"></i>`;

    showElement(networkToast, 'translate-y-4');
    window.setTimeout(() => hideElement(networkToast, 'translate-y-4'), 4200);
  }

  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register(`${base}sw.js`, { scope: base })
        .then((registration) => {
          registration.addEventListener('updatefound', () => {
            newWorker = registration.installing;
            newWorker?.addEventListener('statechange', () => {
              if (newWorker?.state === 'installed' && navigator.serviceWorker.controller) showUpdateToast();
            });
          });
        })
        .catch((error) => console.warn('[OceanHub PWA] Service worker registration failed:', error));

      let refreshing = false;
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (refreshing) return;
        refreshing = true;
        window.location.reload();
      });
    });
  }

  window.addEventListener('beforeinstallprompt', (event: Event) => {
    event.preventDefault();
    deferredPrompt = event;
    navInstallButtons.forEach((button) => {
      button.classList.remove('hidden');
      button.classList.add('inline-flex');
    });

    const dismissedAt = Number(localStorage.getItem('oceanhub_pwa_dismissed') || 0);
    const recentlyDismissed = Date.now() - dismissedAt < 3 * 24 * 60 * 60 * 1000;
    if (!recentlyDismissed) window.setTimeout(() => showElement(installBanner, 'translate-y-8'), 2500);
  });

  async function triggerInstallPrompt() {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    await deferredPrompt.userChoice;
    deferredPrompt = null;
    hideElement(installBanner, 'translate-y-8');
  }

  function dismissInstall() {
    hideElement(installBanner, 'translate-y-8');
    localStorage.setItem('oceanhub_pwa_dismissed', String(Date.now()));
  }

  confirmInstallBtn?.addEventListener('click', triggerInstallPrompt);
  navInstallButtons.forEach((button) => button.addEventListener('click', triggerInstallPrompt));
  laterBtn?.addEventListener('click', dismissInstall);
  dismissBtn?.addEventListener('click', dismissInstall);

  window.addEventListener('appinstalled', () => {
    deferredPrompt = null;
    hideElement(installBanner, 'translate-y-8');
    navInstallButtons.forEach((button) => button.classList.add('hidden'));
    showToast('OceanHub installed', 'The app is now available from this device.', 'success');
  });

  reloadBtn?.addEventListener('click', () => newWorker?.postMessage({ type: 'SKIP_WAITING' }));
  window.addEventListener('online', () => showToast('Connection restored', 'Latest content can be loaded again.', 'online'));
  window.addEventListener('offline', () => showToast('Offline mode', 'Previously opened pages remain available; other routes use the offline fallback.', 'offline'));
</script>
