---
import { getEvidencePlan } from '../lib/matchEvidencePlan';
import type { LifecycleStage, ProjectArchetype } from '../lib/decisionEvidence';

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
const MAX_INLINE_COMBINATIONS = 50;
const MIN_EXPOSED_COMBINATIONS = 2;

interface ArchetypeOption {
  value: ProjectArchetype;
  label: string;
  title: string;
  scopeSummary: string;
  referenceDescription: string;
  stages: Array<{ value: LifecycleStage; label: string; selectedByDefault?: boolean }>;
  focuses: Array<{ value: string; label: string; tags?: string[] }>;
}

const candidateArchetypes: ArchetypeOption[] = [
  {
    value: 'offshore-ccs',
    label: 'Offshore CO₂ geological storage',
    title: 'Build a traceable offshore CCS evidence plan',
    scopeSummary: 'Trace storage-site qualification, characterization and monitoring decisions to source-backed evidence and delivery capabilities.',
    referenceDescription: 'Sleipner, Northern Lights, Porthos, Greensand and other encoded CCS precedents plus canonical engineering references.',
    stages: [
      { value: 'feasibility', label: 'Feasibility — storage-site qualification' },
      { value: 'pre-feed', label: 'Pre-FEED — characterization & baseline design', selectedByDefault: true },
      { value: 'feed', label: 'FEED — monitoring design definition' },
      { value: 'operations', label: 'Operations — injection surveillance' },
      { value: 'monitoring', label: 'Monitoring — assurance & verification' }
    ],
    focuses: [
      { value: 'all', label: 'All matched evidence' },
      { value: 'baseline', label: 'Pre-injection baseline & characterization', tags: ['baseline'] },
      { value: 'containment', label: 'Plume migration & containment', tags: ['containment'] },
      { value: 'induced-seismicity', label: 'Injection-related seismicity', tags: ['induced-seismicity'] }
    ]
  },
  {
    value: 'floating-offshore-wind',
    label: 'Floating offshore wind',
    title: 'Build a traceable floating offshore wind evidence plan',
    scopeSummary: 'Trace floating structure, mooring, cable and marine-operation decisions to encoded Hywind and standards-backed evidence.',
    referenceDescription: 'Hywind Tampen and Hywind Scotland precedents plus IEC and DNV reference metadata.',
    stages: [
      { value: 'construction', label: 'Construction — floater assembly, tow & installation', selectedByDefault: true },
      { value: 'operations', label: 'Operations — integrity & tow-to-shore maintenance' },
      { value: 'pre-feed', label: 'Pre-FEED — station-keeping & dynamic cable layout' },
      { value: 'feed', label: 'FEED — mooring analysis & electrical integration' }
    ],
    focuses: [
      { value: 'all', label: 'All matched evidence' },
      { value: 'floating-wind', label: 'Floater, mooring & marine installation', tags: ['floating-wind', 'spar', 'mooring', 'anchor', 'tow-out', 'cables'] },
      { value: 'dynamic-cable', label: 'Dynamic cable & electrical integration', tags: ['dynamic-cable', 'electrical', 'brownfield', 'commissioning'] },
      { value: 'maintenance', label: 'Tow-to-shore intervention & integrity', tags: ['maintenance', 'tow', 'integrity', 'recommissioning'] }
    ]
  },
  {
    value: 'fixed-offshore-wind',
    label: 'Fixed-bottom offshore wind',
    title: 'Build a traceable fixed-bottom offshore wind evidence plan',
    scopeSummary: 'Trace site investigation, foundation, cable burial and environmental decisions to public project evidence.',
    referenceDescription: 'Vineyard, New England, Revolution Wind and other regulator/project-owner source patterns.',
    stages: [
      { value: 'feasibility', label: 'Feasibility — integrated marine site investigation' },
      { value: 'pre-feed', label: 'Pre-FEED — foundation ground model & cable burial', selectedByDefault: true },
      { value: 'feed', label: 'FEED — consenting & structural design' },
      { value: 'screening', label: 'Screening — metocean & constraint review' }
    ],
    focuses: [
      { value: 'all', label: 'All matched evidence' },
      { value: 'site-investigation', label: 'Geophysical, geotechnical & UXO survey', tags: ['site-investigation', 'geophysics', 'geotechnics', 'uxo'] },
      { value: 'foundation', label: 'Foundation & cable burial risk', tags: ['foundation', 'cable-burial', 'cbra'] },
      { value: 'metocean', label: 'Metocean & environmental evidence', tags: ['metocean', 'sediment', 'benthic', 'fisheries', 'acoustics'] }
    ]
  },
  {
    value: 'subsea-corridor',
    label: 'Subsea infrastructure & corridors',
    title: 'Build a traceable subsea infrastructure evidence plan',
    scopeSummary: 'Trace route, geohazard, free-span, scour and autonomous inspection decisions to source-backed evidence.',
    referenceDescription: 'Ormen Lange, Sea Link, Freedom AUV and standards-led pipeline-integrity patterns.',
    stages: [
      { value: 'feed', label: 'FEED — corridor alignment & geohazard engineering', selectedByDefault: true },
      { value: 'operations', label: 'Operations — autonomous inspection & condition monitoring' },
      { value: 'monitoring', label: 'Monitoring — free-span, scour & stability' },
      { value: 'pre-feed', label: 'Pre-FEED — route investigation & UXO clearance' },
      { value: 'construction', label: 'Construction — installation survey & landing control' }
    ],
    focuses: [
      { value: 'all', label: 'All matched evidence' },
      { value: 'route', label: 'Route selection & geohazard clearance', tags: ['route', 'geohazard', 'bathymetry', 'rov', 'auv', 'positioning', 'cable-route'] },
      { value: 'pipeline-integrity', label: 'Free-span, scour & autonomous inspection', tags: ['free-span', 'scour', 'burial', 'viv', 'integrity', 'auv', 'autonomous-inspection', 'pipeline-integrity'] }
    ]
  }
];

const lookup: Record<string, ReturnType<typeof getEvidencePlan>> = {};
const evidenceCounts = new Map<ProjectArchetype, number>();

for (const option of candidateArchetypes) {
  let count = 0;
  for (const stage of option.stages) {
    for (const focus of option.focuses) {
      const plan = getEvidencePlan({
        projectArchetype: option.value,
        lifecycleStage: stage.value,
        tags: focus.tags ? [...focus.tags] : undefined
      });
      if (!plan.length) continue;
      lookup[`${option.value}:${stage.value}:${focus.value}`] = plan;
      count += 1;
    }
  }
  evidenceCounts.set(option.value, count);
}

const archetypeOptions = candidateArchetypes.filter((option) => (evidenceCounts.get(option.value) ?? 0) >= MIN_EXPOSED_COMBINATIONS);
if (!archetypeOptions.length) throw new Error('Decision Scoper has no archetype with sufficient evidence depth.');
if (Object.keys(lookup).length > MAX_INLINE_COMBINATIONS) throw new Error(`Decision Scoper inline payload exceeded ${MAX_INLINE_COMBINATIONS} evidence-bearing combinations. Split by archetype before expanding the corpus.`);

const defaultArchetype = archetypeOptions.find((option) => option.value === 'offshore-ccs') ?? archetypeOptions[0];
---

<section id="decision-scoper-root" class="my-12 overflow-hidden rounded-3xl border border-white/10 bg-[#060D1E]/65" aria-labelledby="decision-scoper-title">
  <header class="border-b border-white/10 p-6 sm:p-9">
    <p class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-cyan-300">Decision Scoper</p>
    <h2 id="decision-scoper-title" class="mt-3 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">{defaultArchetype.title}</h2>
    <p id="scoper-archetype-summary" class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-400 sm:text-base">{defaultArchetype.scopeSummary}</p>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-12">
    <aside class="border-b border-white/10 p-6 sm:p-8 lg:col-span-4 lg:border-b-0 lg:border-r">
      <div class="space-y-6">
        <div>
          <label for="scoper-archetype" class="mb-2 block text-xs font-bold text-slate-200">1. Project archetype</label>
          <select id="scoper-archetype" class="w-full rounded-xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-cyan-400 focus:outline-none">
            {archetypeOptions.map((option) => <option value={option.value} selected={option.value === defaultArchetype.value}>{option.label}</option>)}
          </select>
          <p class="mt-2 text-xs leading-relaxed text-slate-500">Only archetypes with multiple source-backed evidence combinations are exposed.</p>
        </div>

        <div>
          <label for="scoper-stage" class="mb-2 block text-xs font-bold text-slate-200">2. Lifecycle / decision stage</label>
          <select id="scoper-stage" class="w-full rounded-xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-cyan-400 focus:outline-none">
            {defaultArchetype.stages.map((stage) => <option value={stage.value} selected={stage.selectedByDefault}>{stage.label}</option>)}
          </select>
        </div>

        <div>
          <label for="scoper-focus" class="mb-2 block text-xs font-bold text-slate-200">3. Decision focus</label>
          <select id="scoper-focus" class="w-full rounded-xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-cyan-400 focus:outline-none">
            {defaultArchetype.focuses.map((focus) => <option value={focus.value}>{focus.label}</option>)}
          </select>
        </div>

        <div class="border-l-2 border-cyan-400/30 pl-4">
          <p class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Reference scope</p>
          <p id="scoper-reference-scope-text" class="mt-2 text-xs leading-relaxed text-slate-400">{defaultArchetype.referenceDescription}</p>
        </div>
      </div>
    </aside>

    <div class="p-6 sm:p-8 lg:col-span-8 lg:p-10">
      <ol class="mb-8 grid grid-cols-1 gap-2 sm:grid-cols-5" aria-label="OceanHub evidence trace">
        {['Decision', 'Uncertainty', 'Evidence', 'Capability', 'Provenance'].map((step, index) => (
          <li class="rounded-xl border border-white/10 bg-white/[0.025] px-3 py-3"><span class="font-mono text-[10px] text-cyan-400">0{index + 1}</span><span class="ml-3 text-xs font-bold text-slate-200 sm:ml-0 sm:mt-1 sm:block">{step}</span></li>
        ))}
      </ol>

      <div class="mb-6 border-b border-white/10 pb-5"><p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-cyan-300">Evidence plan</p><p id="scoper-plan-summary" class="mt-2 text-sm text-slate-400" aria-live="polite"></p></div>
      <div id="scoper-plan-list" class="space-y-6" aria-live="polite"></div>

      <div class="mt-8 flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-xl text-xs leading-relaxed text-slate-500">OceanHub structures evidence for project discussion; it does not replace project-specific engineering judgement, consenting review or specialist design.</p>
        <div class="flex flex-wrap gap-3">
          <a href={url('capabilities/')} class="rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-xs font-bold text-white hover:bg-white/10">Capability library</a>
          <a href={url('references/')} class="rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-xs font-bold text-white hover:bg-white/10">Engineering references</a>
          <button type="button" data-open-collaboration="project" class="rounded-xl bg-cyan-400 px-5 py-3 text-xs font-black text-slate-950 hover:bg-cyan-300">Discuss capability needs</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script id="decision-scoper-archetypes" type="application/json" set:html={JSON.stringify(archetypeOptions)}></script>
<script id="decision-scoper-data" type="application/json" set:html={JSON.stringify(lookup)}></script>

<script>
  interface Source { title: string; publisher: string; url: string; publishedYear: number; sourceType: string }
  interface Reference { code: string; title: string; issuer: string; edition: string; officialUrl: string }
  interface Capability { id: string; label: string; summary: string }
  interface Requirement { id: string; discipline: string; uncertainty: string; evidenceNeeded: string; methods: string[]; deliverables: string[]; rationale: string }
  interface PlanItem { caseId: string; caseTitle: string; decision: string; outcome: string; projectContext: string; requirement: Requirement; capabilities: Capability[]; references: Reference[]; sources: Source[] }
  interface ArchetypeOption { value: string; label: string; title: string; scopeSummary: string; referenceDescription: string; stages: Array<{ value: string; label: string; selectedByDefault?: boolean }>; focuses: Array<{ value: string; label: string }> }

  const configs = JSON.parse(document.getElementById('decision-scoper-archetypes')?.textContent ?? '[]') as ArchetypeOption[];
  const configById = new Map(configs.map((config) => [config.value, config]));
  const data = JSON.parse(document.getElementById('decision-scoper-data')?.textContent ?? '{}') as Record<string, PlanItem[]>;
  const archetype = document.getElementById('scoper-archetype') as HTMLSelectElement | null;
  const stage = document.getElementById('scoper-stage') as HTMLSelectElement | null;
  const focus = document.getElementById('scoper-focus') as HTMLSelectElement | null;
  const summary = document.getElementById('scoper-plan-summary');
  const list = document.getElementById('scoper-plan-list');
  const esc = (value: string) => value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;' })[character] ?? character);
  const bullets = (items: string[]) => `<ul class="mt-2 space-y-1.5">${items.map((item) => `<li class="text-sm leading-relaxed text-slate-400">• ${esc(item)}</li>`).join('')}</ul>`;

  function syncControls() {
    if (!archetype || !stage || !focus) return;
    const config = configById.get(archetype.value);
    if (!config) return;
    const title = document.getElementById('decision-scoper-title');
    const scope = document.getElementById('scoper-archetype-summary');
    const reference = document.getElementById('scoper-reference-scope-text');
    if (title) title.textContent = config.title;
    if (scope) scope.textContent = config.scopeSummary;
    if (reference) reference.textContent = config.referenceDescription;
    stage.innerHTML = config.stages.map((item) => `<option value="${esc(item.value)}" ${item.selectedByDefault ? 'selected' : ''}>${esc(item.label)}</option>`).join('');
    focus.innerHTML = config.focuses.map((item) => `<option value="${esc(item.value)}">${esc(item.label)}</option>`).join('');
  }

  function requirementMarkup(item: PlanItem) {
    return `<section class="border-t border-white/10 pt-5 first:border-t-0 first:pt-0" data-scoper-requirement="${esc(item.requirement.id)}">
      <div class="grid gap-5 lg:grid-cols-2">
        <div><p class="font-mono text-[10px] uppercase text-slate-500">Key uncertainty</p><p class="mt-2 text-sm text-slate-300">${esc(item.requirement.uncertainty)}</p></div>
        <div><p class="font-mono text-[10px] uppercase text-slate-500">Evidence required</p><p class="mt-2 text-sm text-slate-300">${esc(item.requirement.evidenceNeeded)}</p></div>
        <div><p class="font-mono text-[10px] uppercase text-slate-500">Methods</p>${bullets(item.requirement.methods)}</div>
        <div><p class="font-mono text-[10px] uppercase text-slate-500">Capabilities</p>${bullets(item.capabilities.map((capability) => capability.label))}</div>
        <div><p class="font-mono text-[10px] uppercase text-slate-500">Deliverables</p>${bullets(item.requirement.deliverables)}</div>
        <div><p class="font-mono text-[10px] uppercase text-slate-500">References</p>${bullets(item.references.map((reference) => `${reference.code} — ${reference.title}`))}</div>
      </div>
      <p class="mt-5 border-l-2 border-cyan-400/30 pl-4 text-sm leading-relaxed text-slate-400">${esc(item.requirement.rationale)}</p>
      <div class="mt-5 flex flex-wrap gap-2">${item.sources.map((source) => `<a class="text-[11px] font-bold text-cyan-300" href="${esc(source.url)}" target="_blank" rel="noopener noreferrer">${esc(source.publisher)} · ${source.publishedYear} ↗</a>`).join('')}</div>
    </section>`;
  }

  function render() {
    if (!archetype || !stage || !focus || !summary || !list) return;
    const plan = data[`${archetype.value}:${stage.value}:${focus.value}`] ?? [];
    if (!plan.length) {
      summary.textContent = 'No direct public reference pattern is encoded for this combination yet.';
      list.innerHTML = '<div class="rounded-2xl border border-amber-400/20 bg-amber-500/5 p-6 text-sm text-slate-400">Evidence gap — choose another stage/focus or add a validated case. OceanHub will not fabricate a recommendation.</div>';
      return;
    }
    const cases = new Map<string, PlanItem[]>();
    plan.forEach((item) => cases.set(item.caseId, [...(cases.get(item.caseId) ?? []), item]));
    summary.textContent = `${plan.length} evidence workstream${plan.length === 1 ? '' : 's'} from ${cases.size} reference pattern${cases.size === 1 ? '' : 's'}.`;
    list.innerHTML = [...cases.values()].map((items) => {
      const first = items[0];
      return `<article class="rounded-2xl border border-white/10 bg-black/15 p-5 sm:p-7" data-scoper-case="${esc(first.caseId)}"><header class="border-b border-white/10 pb-5"><p class="font-mono text-[10px] uppercase text-cyan-300">Reference pattern</p><h3 class="mt-2 text-xl font-black text-white">${esc(first.caseTitle)}</h3><p class="mt-3 text-sm text-slate-500">${esc(first.projectContext)}</p><p class="mt-3 text-sm font-semibold text-slate-200">${esc(first.decision)}</p></header><div class="space-y-7 pt-6">${items.map(requirementMarkup).join('')}</div></article>`;
    }).join('');
  }

  archetype?.addEventListener('change', () => { syncControls(); render(); });
  stage?.addEventListener('change', render);
  focus?.addEventListener('change', render);
  render();
</script>
