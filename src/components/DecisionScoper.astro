---
import { getEvidencePlan } from '../lib/matchEvidencePlan';
import type { LifecycleStage } from '../lib/decisionEvidence';

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;

const stages: Array<{ value: LifecycleStage; label: string }> = [
  { value: 'feasibility', label: 'Feasibility — storage-site qualification' },
  { value: 'pre-feed', label: 'Pre-FEED — characterization & baseline design' },
  { value: 'feed', label: 'FEED — monitoring design definition' },
  { value: 'operations', label: 'Operations — injection surveillance' },
  { value: 'monitoring', label: 'Monitoring — assurance & verification' }
];

const focuses = [
  { value: 'all', label: 'All matched evidence', tags: undefined },
  { value: 'baseline', label: 'Pre-injection baseline & characterization', tags: ['baseline'] },
  { value: 'containment', label: 'Plume migration & containment', tags: ['containment'] },
  { value: 'induced-seismicity', label: 'Injection-related seismicity', tags: ['induced-seismicity'] }
] as const;

const lookup = Object.fromEntries(
  stages.flatMap((stage) =>
    focuses.map((focus) => [
      `${stage.value}:${focus.value}`,
      getEvidencePlan({
        projectArchetype: 'offshore-ccs',
        lifecycleStage: stage.value,
        tags: focus.tags ? [...focus.tags] : undefined
      })
    ])
  )
);
---

<section id="decision-scoper-root" class="my-12 overflow-hidden rounded-3xl border border-white/10 bg-[#060D1E]/65" aria-labelledby="decision-scoper-title">
  <header class="border-b border-white/10 p-6 sm:p-9">
    <p class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-cyan-300">Decision Scoper</p>
    <h2 id="decision-scoper-title" class="mt-3 font-display text-3xl font-black tracking-tight text-white sm:text-4xl">Build a traceable offshore CCS evidence plan</h2>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-400 sm:text-base">Start from the project decision, then trace each recommendation through uncertainty, evidence, delivery capability and engineering precedent.</p>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-12">
    <aside class="border-b border-white/10 p-6 sm:p-8 lg:col-span-4 lg:border-b-0 lg:border-r">
      <div class="space-y-6">
        <div>
          <label for="scoper-archetype" class="mb-2 block text-xs font-bold text-slate-200">1. Project archetype</label>
          <select id="scoper-archetype" class="w-full rounded-xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-cyan-400 focus:outline-none">
            <option value="offshore-ccs">Offshore CO₂ geological storage</option>
          </select>
          <p class="mt-2 text-xs leading-relaxed text-slate-500">The first evidence-backed slice intentionally covers offshore CCS only.</p>
        </div>

        <div>
          <label for="scoper-stage" class="mb-2 block text-xs font-bold text-slate-200">2. Lifecycle / decision stage</label>
          <select id="scoper-stage" class="w-full rounded-xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-cyan-400 focus:outline-none">
            {stages.map((stage) => <option value={stage.value} selected={stage.value === 'pre-feed'}>{stage.label}</option>)}
          </select>
        </div>

        <div>
          <label for="scoper-focus" class="mb-2 block text-xs font-bold text-slate-200">3. Decision focus</label>
          <select id="scoper-focus" class="w-full rounded-xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-cyan-400 focus:outline-none">
            {focuses.map((focus) => <option value={focus.value}>{focus.label}</option>)}
          </select>
          <p class="mt-2 text-xs leading-relaxed text-slate-500">Narrow only when the focus materially changes the evidence question.</p>
        </div>

        <div class="border-l-2 border-cyan-400/30 pl-4">
          <p class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Reference scope</p>
          <p class="mt-2 text-xs leading-relaxed text-slate-400">Sleipner and Northern Lights Aurora, linked to operator/project evidence and ISO 27914:2026.</p>
        </div>
      </div>
    </aside>

    <div class="p-6 sm:p-8 lg:col-span-8 lg:p-10">
      <ol class="mb-8 grid grid-cols-1 gap-2 sm:grid-cols-5" aria-label="OceanHub evidence trace">
        {['Decision', 'Uncertainty', 'Evidence', 'Capability', 'Provenance'].map((step, index) => (
          <li class="rounded-xl border border-white/10 bg-white/[0.025] px-3 py-3">
            <span class="font-mono text-[10px] text-cyan-400">0{index + 1}</span>
            <span class="ml-3 text-xs font-bold text-slate-200 sm:ml-0 sm:mt-1 sm:block">{step}</span>
          </li>
        ))}
      </ol>

      <div class="mb-6 border-b border-white/10 pb-5">
        <p class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-cyan-300">Evidence plan</p>
        <p id="scoper-plan-summary" class="mt-2 text-sm text-slate-400" aria-live="polite"></p>
      </div>

      <div id="scoper-plan-list" class="space-y-6" aria-live="polite"></div>

      <div class="mt-8 flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-xl text-xs leading-relaxed text-slate-500">OceanHub structures evidence for project discussion; it does not replace project-specific engineering judgement, consenting review or specialist design.</p>
        <div class="flex flex-wrap gap-3">
          <a href={url('jips/')} class="rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-xs font-bold text-white hover:bg-white/10">Explore proposed JIPs</a>
          <button type="button" data-open-collaboration="project" class="rounded-xl bg-cyan-400 px-5 py-3 text-xs font-black text-slate-950 hover:bg-cyan-300">Discuss capability needs</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script id="decision-scoper-data" type="application/json" set:html={JSON.stringify(lookup)}></script>

<script>
  interface Source {
    title: string;
    publisher: string;
    url: string;
    publishedYear: number;
    sourceType: string;
  }

  interface Requirement {
    id: string;
    discipline: string;
    uncertainty: string;
    evidenceNeeded: string;
    methods: string[];
    capabilities: string[];
    deliverables: string[];
    standards: string[];
    rationale: string;
  }

  interface PlanItem {
    caseId: string;
    caseTitle: string;
    decision: string;
    outcome: string;
    projectContext: string;
    requirement: Requirement;
    sources: Source[];
  }

  const data = JSON.parse(document.getElementById('decision-scoper-data')?.textContent ?? '{}') as Record<string, PlanItem[]>;
  const stage = document.getElementById('scoper-stage') as HTMLSelectElement | null;
  const focus = document.getElementById('scoper-focus') as HTMLSelectElement | null;
  const summary = document.getElementById('scoper-plan-summary');
  const list = document.getElementById('scoper-plan-list');

  const disciplineLabels: Record<string, string> = {
    geophysics: 'Geophysics',
    geology: 'Geology',
    geomechanics: 'Geomechanics',
    wells: 'Wells & direct evidence',
    environment: 'Environment',
    monitoring: 'Monitoring',
    'data-integration': 'Data integration'
  };

  const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;' })[character] ?? character);
  const bullets = (items: string[]) => `<ul class="mt-2 space-y-1.5">${items.map((item) => `<li class="flex gap-2 text-sm leading-relaxed text-slate-400"><span class="mt-[0.55rem] h-1 w-1 shrink-0 rounded-full bg-cyan-400/70"></span><span>${escapeHtml(item)}</span></li>`).join('')}</ul>`;
  const sourceMarkup = (items: Source[]) => items.map((source) => `<a href="${escapeHtml(source.url)}" target="_blank" rel="noopener noreferrer" class="block rounded-xl border border-white/10 bg-black/20 p-3 hover:border-cyan-400/30"><span class="block text-xs font-bold text-slate-200">${escapeHtml(source.title)}</span><span class="mt-1 block text-[11px] text-slate-500">${escapeHtml(source.publisher)} · ${source.publishedYear} · ${escapeHtml(source.sourceType)}</span></a>`).join('');

  function requirementMarkup(item: PlanItem, index: number) {
    const requirement = item.requirement;
    return `<section class="border-t border-white/10 pt-6 first:border-t-0 first:pt-0" data-scoper-requirement="${escapeHtml(requirement.id)}">
      <h4 class="text-sm font-bold text-white">${String(index + 1).padStart(2, '0')} · ${escapeHtml(disciplineLabels[requirement.discipline] ?? requirement.discipline)}</h4>
      <div class="mt-5 grid grid-cols-1 gap-5 xl:grid-cols-2">
        <div><p class="text-[10px] font-mono uppercase tracking-[0.14em] text-slate-500">Key uncertainty</p><p class="mt-2 text-sm leading-relaxed text-slate-300">${escapeHtml(requirement.uncertainty)}</p></div>
        <div><p class="text-[10px] font-mono uppercase tracking-[0.14em] text-slate-500">Evidence required</p><p class="mt-2 text-sm leading-relaxed text-slate-300">${escapeHtml(requirement.evidenceNeeded)}</p></div>
        <div><p class="text-[10px] font-mono uppercase tracking-[0.14em] text-slate-500">Recommended methods</p>${bullets(requirement.methods)}</div>
        <div><p class="text-[10px] font-mono uppercase tracking-[0.14em] text-slate-500">Capability modules</p>${bullets(requirement.capabilities)}</div>
        <div><p class="text-[10px] font-mono uppercase tracking-[0.14em] text-slate-500">Expected deliverables</p>${bullets(requirement.deliverables)}</div>
        <div><p class="text-[10px] font-mono uppercase tracking-[0.14em] text-slate-500">Applicable standards</p>${bullets(requirement.standards)}</div>
      </div>
      <div class="mt-5 border-l-2 border-cyan-400/30 pl-4"><p class="text-[10px] font-mono uppercase tracking-[0.14em] text-cyan-300">Why this is in the plan</p><p class="mt-2 text-sm leading-relaxed text-slate-400">${escapeHtml(requirement.rationale)}</p></div>
      <div class="mt-5"><p class="mb-2 text-[10px] font-mono uppercase tracking-[0.14em] text-slate-500">Precedent & provenance</p><div class="grid grid-cols-1 gap-2 md:grid-cols-2">${sourceMarkup(item.sources)}</div></div>
    </section>`;
  }

  function render() {
    if (!stage || !focus || !summary || !list) return;
    const plan = data[`${stage.value}:${focus.value}`] ?? [];

    if (!plan.length) {
      summary.textContent = 'No direct public reference pattern is encoded for this combination yet.';
      list.innerHTML = `<div class="rounded-2xl border border-amber-400/20 bg-amber-500/5 p-6"><h3 class="text-base font-bold text-white">Evidence gap, not a fabricated recommendation</h3><p class="mt-2 text-sm leading-relaxed text-slate-400">OceanHub does not currently have a source-backed precedent for this stage and focus. Choose a broader focus or add a validated engineering case to the knowledge layer.</p></div>`;
      return;
    }

    const cases = new Map<string, PlanItem[]>();
    plan.forEach((item) => cases.set(item.caseId, [...(cases.get(item.caseId) ?? []), item]));
    summary.textContent = `${plan.length} evidence workstream${plan.length === 1 ? '' : 's'} from ${cases.size} reference pattern${cases.size === 1 ? '' : 's'}.`;
    list.innerHTML = [...cases.values()].map((items) => {
      const first = items[0];
      return `<article class="rounded-2xl border border-white/10 bg-black/15 p-5 sm:p-7" data-scoper-case="${escapeHtml(first.caseId)}">
        <header class="border-b border-white/10 pb-6"><p class="text-[10px] font-mono uppercase tracking-[0.14em] text-cyan-300">Reference pattern</p><h3 class="mt-2 font-display text-xl font-black text-white">${escapeHtml(first.caseTitle)}</h3><p class="mt-3 text-sm leading-relaxed text-slate-500">${escapeHtml(first.projectContext)}</p></header>
        <div class="grid grid-cols-1 gap-5 border-b border-white/10 py-6 xl:grid-cols-2"><div><p class="text-[10px] font-mono uppercase tracking-[0.14em] text-slate-500">Decision</p><p class="mt-2 text-sm font-semibold leading-relaxed text-slate-100">${escapeHtml(first.decision)}</p></div><div><p class="text-[10px] font-mono uppercase tracking-[0.14em] text-slate-500">Decision outcome</p><p class="mt-2 text-sm leading-relaxed text-slate-400">${escapeHtml(first.outcome)}</p></div></div>
        <div class="space-y-7 pt-6">${items.map(requirementMarkup).join('')}</div>
      </article>`;
    }).join('');
  }

  stage?.addEventListener('change', render);
  focus?.addEventListener('change', render);
  render();
</script>
