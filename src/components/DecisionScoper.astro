---
import { getEvidencePlan } from '../lib/matchEvidencePlan';
import type { LifecycleStage } from '../lib/decisionEvidence';

const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;

const stageOptions: Array<{ value: LifecycleStage; label: string }> = [
  { value: 'feasibility', label: 'Feasibility — storage-site qualification' },
  { value: 'pre-feed', label: 'Pre-FEED — characterization & baseline design' },
  { value: 'feed', label: 'FEED — monitoring design definition' },
  { value: 'operations', label: 'Operations — injection surveillance' },
  { value: 'monitoring', label: 'Monitoring — assurance & verification' }
];

const focusOptions = [
  { value: 'all', label: 'All matched evidence', tags: undefined },
  { value: 'baseline', label: 'Pre-injection baseline & characterization', tags: ['baseline'] },
  { value: 'containment', label: 'Plume migration & containment', tags: ['containment'] },
  { value: 'induced-seismicity', label: 'Injection-related seismicity', tags: ['induced-seismicity'] }
] as const;

const planLookup = Object.fromEntries(
  stageOptions.flatMap((stage) =>
    focusOptions.map((focus) => [
      `${stage.value}:${focus.value}`,
      getEvidencePlan({
        projectArchetype: 'offshore-ccs',
        lifecycleStage: stage.value,
        tags: focus.tags ? [...focus.tags] : undefined
      })
    ])
  )
);
---

<section
  class="glass-panel my-12 overflow-hidden rounded-3xl border border-cyan-500/25 shadow-[0_20px_60px_rgba(0,0,0,0.45)]"
  id="decision-scoper-root"
  aria-labelledby="decision-scoper-title"
>
  <div class="border-b border-white/10 px-6 py-8 sm:px-10 sm:py-10">
    <div class="max-w-4xl">
      <p class="mb-3 font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-cyan-300">Decision Scoper</p>
      <h2 id="decision-scoper-title" class="font-display text-3xl font-black tracking-tight text-white sm:text-4xl">
        Build a traceable offshore CCS evidence plan
      </h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-300 sm:text-base">
        Start from the project decision, then trace each recommendation through uncertainty, required evidence, delivery capability and the engineering precedent behind it.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-0 lg:grid-cols-12">
    <div class="border-b border-white/10 p-6 sm:p-8 lg:col-span-4 lg:border-b-0 lg:border-r">
      <div class="space-y-6">
        <div>
          <label for="scoper-archetype" class="mb-2 block text-xs font-bold text-slate-200">1. Project archetype</label>
          <select
            id="scoper-archetype"
            class="w-full rounded-xl border border-white/15 bg-[#081226] px-4 py-3 text-sm text-white focus:border-cyan-400 focus:outline-none"
          >
            <option value="offshore-ccs">Offshore CO₂ geological storage</option>
          </select>
          <p class="mt-2 text-xs leading-relaxed text-slate-500">This first evidence-backed slice intentionally covers offshore CCS only.</p>
        </div>

        <div>
          <label for="scoper-stage" class="mb-2 block text-xs font-bold text-slate-200">2. Lifecycle / decision stage</label>
          <select
            id="scoper-stage"
            class="w-full rounded-xl border border-white/15 bg-[#081226] px-4 py-3 text-sm text-white focus:border-cyan-400 focus:outline-none"
          >
            {stageOptions.map((stage) => (
              <option value={stage.value} selected={stage.value === 'pre-feed'}>{stage.label}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="scoper-focus" class="mb-2 block text-xs font-bold text-slate-200">3. Decision focus</label>
          <select
            id="scoper-focus"
            class="w-full rounded-xl border border-white/15 bg-[#081226] px-4 py-3 text-sm text-white focus:border-cyan-400 focus:outline-none"
          >
            {focusOptions.map((focus) => <option value={focus.value}>{focus.label}</option>)}
          </select>
          <p class="mt-2 text-xs leading-relaxed text-slate-500">Use a focus only when it materially narrows the evidence question.</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-black/20 p-5">
          <p class="text-[11px] font-mono font-bold uppercase tracking-[0.14em] text-slate-400">Reference scope</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-300">
            Public offshore storage precedents currently include Sleipner and Northern Lights Aurora, linked to operator/project evidence and ISO 27914:2026.
          </p>
        </div>
      </div>
    </div>

    <div class="p-6 sm:p-8 lg:col-span-8 lg:p-10">
      <ol class="mb-8 grid grid-cols-1 gap-2 sm:grid-cols-5" aria-label="OceanHub evidence trace">
        {['Decision', 'Uncertainty', 'Evidence', 'Capability', 'Provenance'].map((step, index) => (
          <li class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.025] px-3 py-3 sm:block">
            <span class="font-mono text-[10px] text-cyan-400">0{index + 1}</span>
            <span class="text-xs font-bold text-slate-200 sm:mt-1 sm:block">{step}</span>
          </li>
        ))}
      </ol>

      <div class="mb-6 flex flex-col gap-2 border-b border-white/10 pb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-[11px] font-mono font-bold uppercase tracking-[0.16em] text-cyan-300">Evidence plan</p>
          <p id="scoper-plan-summary" class="mt-2 text-sm text-slate-400" aria-live="polite"></p>
        </div>
        <p class="text-xs text-slate-500">Recommendations remain traceable to the cited precedent.</p>
      </div>

      <div id="scoper-plan-list" class="space-y-6" aria-live="polite"></div>

      <div class="mt-8 flex flex-col gap-3 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-xl text-xs leading-relaxed text-slate-500">
          OceanHub structures evidence for project discussion; it does not replace project-specific engineering judgement, consenting review or specialist design.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={url('jips/')}
            class="inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-xs font-bold text-white transition-colors hover:bg-white/10"
          >
            Explore proposed JIPs
          </a>
          <button
            type="button"
            data-open-alliance-modal
            class="inline-flex items-center justify-center rounded-xl bg-cyan-400 px-5 py-3 text-xs font-black text-slate-950 transition-colors hover:bg-cyan-300"
          >
            Discuss capability needs
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script id="decision-scoper-data" type="application/json" set:html={JSON.stringify(planLookup)}></script>

<script>
  interface EvidenceSource {
    title: string;
    publisher: string;
    url: string;
    publishedYear: number;
    sourceType: string;
  }

  interface EvidenceRequirement {
    id: string;
    discipline: string;
    uncertainty: string;
    evidenceNeeded: string;
    methods: string[];
    capabilities: string[];
    deliverables: string[];
    standards: string[];
    rationale: string;
  }

  interface EvidencePlanItem {
    caseId: string;
    caseTitle: string;
    decision: string;
    outcome: string;
    projectContext: string;
    requirement: EvidenceRequirement;
    sources: EvidenceSource[];
  }

  const dataNode = document.getElementById('decision-scoper-data');
  const stageSelect = document.getElementById('scoper-stage') as HTMLSelectElement | null;
  const focusSelect = document.getElementById('scoper-focus') as HTMLSelectElement | null;
  const summary = document.getElementById('scoper-plan-summary');
  const planList = document.getElementById('scoper-plan-list');
  const planLookup = JSON.parse(dataNode?.textContent ?? '{}') as Record<string, EvidencePlanItem[]>;

  const disciplineLabels: Record<string, string> = {
    geophysics: 'Geophysics',
    geology: 'Geology',
    geomechanics: 'Geomechanics',
    wells: 'Wells & direct evidence',
    environment: 'Environment',
    monitoring: 'Monitoring',
    'data-integration': 'Data integration'
  };

  function escapeHtml(value: string) {
    return value.replace(/[&<>'"]/g, (character) => {
      const entities: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#039;',
        '"': '&quot;'
      };
      return entities[character] ?? character;
    });
  }

  function renderBulletList(items: string[]) {
    return `<ul class="mt-2 space-y-1.5 text-sm leading-relaxed text-slate-300">${items
      .map((item) => `<li class="flex gap-2"><span class="mt-[0.55rem] h-1 w-1 shrink-0 rounded-full bg-cyan-400/70"></span><span>${escapeHtml(item)}</span></li>`)
      .join('')}</ul>`;
  }

  function renderSources(sources: EvidenceSource[]) {
    return sources
      .map(
        (source) => `
          <a
            href="${escapeHtml(source.url)}"
            target="_blank"
            rel="noopener noreferrer"
            class="block rounded-lg border border-white/10 bg-black/20 px-3 py-2.5 transition-colors hover:border-cyan-400/30 hover:bg-cyan-500/5"
          >
            <span class="block text-xs font-bold text-slate-200">${escapeHtml(source.title)}</span>
            <span class="mt-1 block text-[11px] text-slate-500">${escapeHtml(source.publisher)} · ${source.publishedYear} · ${escapeHtml(source.sourceType)}</span>
          </a>
        `
      )
      .join('');
  }

  function renderRequirement(item: EvidencePlanItem, index: number) {
    const requirement = item.requirement;
    return `
      <section class="border-t border-white/10 pt-6 first:border-t-0 first:pt-0" data-scoper-requirement="${escapeHtml(requirement.id)}">
        <div class="mb-5 flex items-center gap-3">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg border border-cyan-400/20 bg-cyan-500/10 font-mono text-[10px] font-bold text-cyan-300">${String(index + 1).padStart(2, '0')}</span>
          <h4 class="text-sm font-bold text-white">${escapeHtml(disciplineLabels[requirement.discipline] ?? requirement.discipline)}</h4>
        </div>

        <div class="grid grid-cols-1 gap-5 xl:grid-cols-2">
          <div>
            <p class="text-[10px] font-mono font-bold uppercase tracking-[0.14em] text-slate-500">Key uncertainty</p>
            <p class="mt-2 text-sm leading-relaxed text-slate-200">${escapeHtml(requirement.uncertainty)}</p>
          </div>
          <div>
            <p class="text-[10px] font-mono font-bold uppercase tracking-[0.14em] text-slate-500">Evidence required</p>
            <p class="mt-2 text-sm leading-relaxed text-slate-200">${escapeHtml(requirement.evidenceNeeded)}</p>
          </div>
          <div>
            <p class="text-[10px] font-mono font-bold uppercase tracking-[0.14em] text-slate-500">Recommended methods</p>
            ${renderBulletList(requirement.methods)}
          </div>
          <div>
            <p class="text-[10px] font-mono font-bold uppercase tracking-[0.14em] text-slate-500">Capability modules</p>
            ${renderBulletList(requirement.capabilities)}
          </div>
          <div>
            <p class="text-[10px] font-mono font-bold uppercase tracking-[0.14em] text-slate-500">Expected deliverables</p>
            ${renderBulletList(requirement.deliverables)}
          </div>
          <div>
            <p class="text-[10px] font-mono font-bold uppercase tracking-[0.14em] text-slate-500">Applicable standards</p>
            ${renderBulletList(requirement.standards)}
          </div>
        </div>

        <div class="mt-5 rounded-xl border border-white/10 bg-white/[0.025] p-4">
          <p class="text-[10px] font-mono font-bold uppercase tracking-[0.14em] text-cyan-300">Why this is in the plan</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-300">${escapeHtml(requirement.rationale)}</p>
        </div>

        <div class="mt-5">
          <p class="mb-2 text-[10px] font-mono font-bold uppercase tracking-[0.14em] text-slate-500">Precedent & provenance</p>
          <div class="grid grid-cols-1 gap-2 md:grid-cols-2">${renderSources(item.sources)}</div>
        </div>
      </section>
    `;
  }

  function renderPlan() {
    if (!stageSelect || !focusSelect || !summary || !planList) return;

    const key = `${stageSelect.value}:${focusSelect.value}`;
    const plan = planLookup[key] ?? [];

    if (plan.length === 0) {
      summary.textContent = 'No direct public reference pattern is encoded for this combination yet.';
      planList.innerHTML = `
        <div class="rounded-2xl border border-amber-400/20 bg-amber-500/5 p-6">
          <h3 class="text-base font-bold text-white">Evidence gap, not a fabricated recommendation</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">OceanHub does not currently have a source-backed precedent for this stage and focus. Choose a broader focus or add a validated engineering case to the knowledge layer.</p>
        </div>
      `;
      return;
    }

    const cases = new Map<string, EvidencePlanItem[]>();
    for (const item of plan) {
      const entries = cases.get(item.caseId) ?? [];
      entries.push(item);
      cases.set(item.caseId, entries);
    }

    summary.textContent = `${plan.length} evidence workstream${plan.length === 1 ? '' : 's'} from ${cases.size} reference pattern${cases.size === 1 ? '' : 's'}.`;

    planList.innerHTML = [...cases.values()]
      .map((items) => {
        const first = items[0];
        return `
          <article class="rounded-2xl border border-white/10 bg-[#060D1E]/75 p-5 sm:p-7" data-scoper-case="${escapeHtml(first.caseId)}">
            <div class="border-b border-white/10 pb-6">
              <p class="text-[10px] font-mono font-bold uppercase tracking-[0.14em] text-cyan-300">Reference pattern</p>
              <h3 class="mt-2 text-xl font-black text-white font-display">${escapeHtml(first.caseTitle)}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-400">${escapeHtml(first.projectContext)}</p>
            </div>

            <div class="grid grid-cols-1 gap-5 border-b border-white/10 py-6 xl:grid-cols-2">
              <div>
                <p class="text-[10px] font-mono font-bold uppercase tracking-[0.14em] text-slate-500">Decision</p>
                <p class="mt-2 text-sm font-semibold leading-relaxed text-slate-100">${escapeHtml(first.decision)}</p>
              </div>
              <div>
                <p class="text-[10px] font-mono font-bold uppercase tracking-[0.14em] text-slate-500">Decision outcome</p>
                <p class="mt-2 text-sm leading-relaxed text-slate-300">${escapeHtml(first.outcome)}</p>
              </div>
            </div>

            <div class="space-y-7 pt-6">
              ${items.map((item, index) => renderRequirement(item, index)).join('')}
            </div>
          </article>
        `;
      })
      .join('');
  }

  stageSelect?.addEventListener('change', renderPlan);
  focusSelect?.addEventListener('change', renderPlan);
  renderPlan();
</script>
