---
const intakeEmail = 'liuzhihao109@foxmail.com';
---

<script define:vars={{ intakeEmail }}>
  const modal = document.getElementById('collaboration-modal');
  const copyButton = document.getElementById('collaboration-copy');
  const partnerPanel = document.getElementById('partner-intake');
  const actionStatus = document.getElementById('collaboration-action-status');
  const MAX_MAILTO_LENGTH = 1800;

  if (modal && copyButton && partnerPanel) {
    copyButton.textContent = 'Copy draft';
    copyButton.classList.remove('bg-cyan-400', 'text-slate-950', 'hover:bg-cyan-300');
    copyButton.classList.add('border', 'border-white/10', 'bg-white/5', 'text-white', 'hover:bg-white/10');

    const emailLink = document.createElement('a');
    emailLink.id = 'collaboration-email-draft';
    emailLink.className = 'shrink-0 rounded-xl bg-cyan-400 px-5 py-3 text-xs font-black text-slate-950 hover:bg-cyan-300';
    emailLink.dataset.recipient = intakeEmail;
    copyButton.insertAdjacentElement('afterend', emailLink);

    const downloadButton = document.createElement('button');
    downloadButton.type = 'button';
    downloadButton.id = 'collaboration-download-draft';
    downloadButton.className = 'shrink-0 rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-xs font-black text-white hover:bg-white/10';
    downloadButton.textContent = 'Download draft';
    emailLink.insertAdjacentElement('afterend', downloadButton);

    const value = (id) => {
      const field = document.getElementById(id);
      return field && 'value' in field ? String(field.value).trim() : '';
    };

    const selectedJips = () => Array.from(document.querySelectorAll('.jip-interest:checked'))
      .map((checkbox) => `${checkbox.value} — ${checkbox.dataset.jipTitle || checkbox.value}`);

    const selectedAssertions = () => Array.from(document.querySelectorAll('[data-capability-assertion]')).map((section) => {
      const capabilityId = section.dataset.capabilityAssertion || '[unknown capability]';
      const label = section.dataset.capabilityLabel || capabilityId;
      const typeField = section.querySelector('.capability-evidence-type');
      const detailField = section.querySelector('.capability-evidence-detail');
      const evidenceType = typeField && 'selectedOptions' in typeField
        ? typeField.selectedOptions[0]?.textContent?.trim() || typeField.value
        : '[not provided]';
      const evidenceDetail = detailField && 'value' in detailField ? String(detailField.value).trim() : '';
      return { capabilityId, label, evidenceType, evidenceDetail: evidenceDetail || '[not provided]' };
    });

    const isPartnerIntent = () => !partnerPanel.classList.contains('hidden');

    const buildDraft = () => {
      const org = value('collaboration-org') || '[not provided]';
      const contact = value('collaboration-email') || '[not provided]';

      if (isPartnerIntent()) {
        const jips = selectedJips();
        const assertions = selectedAssertions();
        const assertionLines = assertions.length
          ? assertions.flatMap((assertion, index) => [
              `${index + 1}. ${assertion.capabilityId} — ${assertion.label}`,
              `   Evidence type: ${assertion.evidenceType}`,
              `   Primary evidence: ${assertion.evidenceDetail}`
            ])
          : ['[no capability assertions selected]'];

        return [
          'OceanHub — Partner Capability Evidence Packet',
          '',
          `Organization: ${org}`,
          `Contact email: ${contact}`,
          `Capability owner type: ${value('partner-type') || '[not provided]'}`,
          `Operating regions: ${value('partner-regions') || '[not provided]'}`,
          `JIP interest: ${jips.length ? jips.join('; ') : 'General capability network'}`,
          'Review state: evidence-submitted (not yet reviewed)',
          '',
          'Capability assertions:',
          ...assertionLines
        ].join('\n');
      }

      return [
        'OceanHub — Project Inquiry',
        '',
        `Organization: ${org}`,
        `Contact email: ${contact}`,
        `Project type: ${value('project-archetype') || '[not provided]'}`,
        `Lifecycle stage: ${value('project-stage') || '[not provided]'}`,
        `Region / context: ${value('project-location') || '[not provided]'}`,
        '',
        'Decision to resolve:',
        value('project-decision') || '[not provided]',
        '',
        'Existing evidence / constraints / capability gaps:',
        value('project-context') || '[not provided]'
      ].join('\n');
    };

    const updateEmailLink = () => {
      const partner = isPartnerIntent();
      const org = value('collaboration-org');
      const subject = partner
        ? `OceanHub Partner Capability Evidence${org ? ` — ${org}` : ''}`
        : `OceanHub Project Inquiry${org ? ` — ${org}` : ''}`;
      const draft = buildDraft();
      const fullMailto = `mailto:${intakeEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(draft)}`;
      const tooLong = fullMailto.length > MAX_MAILTO_LENGTH;
      emailLink.textContent = tooLong ? 'Email (attach draft)' : (partner ? 'Email evidence packet' : 'Email project inquiry');
      emailLink.href = tooLong
        ? `mailto:${intakeEmail}?subject=${encodeURIComponent(subject)}`
        : fullMailto;
      if (actionStatus) {
        actionStatus.textContent = tooLong
          ? 'This draft is too long for a reliable mail link. Download it, then attach or paste the complete draft before sending.'
          : '';
      }
    };

    downloadButton.addEventListener('click', () => {
      const blob = new Blob([buildDraft()], { type: 'text/plain;charset=utf-8' });
      const href = URL.createObjectURL(blob);
      const anchor = document.createElement('a');
      anchor.href = href;
      anchor.download = isPartnerIntent() ? 'oceanhub-partner-evidence.txt' : 'oceanhub-project-inquiry.txt';
      document.body.appendChild(anchor);
      anchor.click();
      anchor.remove();
      URL.revokeObjectURL(href);
    });

    modal.addEventListener('input', updateEmailLink);
    modal.addEventListener('change', () => window.setTimeout(updateEmailLink, 0));

    document.querySelectorAll('[data-intent-switch], [data-open-collaboration]').forEach((trigger) => {
      trigger.addEventListener('click', () => window.setTimeout(updateEmailLink, 0));
    });

    const intentObserver = new MutationObserver(updateEmailLink);
    intentObserver.observe(partnerPanel, { attributes: true, attributeFilter: ['class'] });
    updateEmailLink();
  }
</script>