---
// Ambient ocean-data mesh & sonar telemetry backdrop.
// Decorative only; automatically reduces work on small screens, hidden tabs, and devices with reduced motion.
---

<div class="fixed inset-0 pointer-events-none -z-20 overflow-hidden" aria-hidden="true">
  <!-- Glowing ambient ocean caustics & nebulae -->
  <div class="absolute -top-48 left-1/4 w-[800px] h-[800px] bg-cyan-500/10 rounded-full blur-[180px] animate-pulse-glow"></div>
  <div class="absolute top-1/3 -right-48 w-[700px] h-[700px] bg-blue-600/10 rounded-full blur-[200px]"></div>
  <div class="absolute -bottom-48 left-1/3 w-[900px] h-[900px] bg-emerald-500/5 rounded-full blur-[220px]"></div>
  <div class="absolute top-2/3 left-10 w-[500px] h-[500px] bg-indigo-600/6 rounded-full blur-[180px]"></div>

  <!-- Cyber grid overlay & depth isobaths -->
  <div class="absolute inset-0 cyber-grid opacity-80"></div>
  <div class="absolute inset-0 ocean-isobaths opacity-60"></div>

  <!-- Interactive Telemetry Canvas -->
  <canvas id="ocean-tech-canvas" class="absolute inset-0 w-full h-full opacity-60"></canvas>
</div>

<script>
  const canvas = document.getElementById('ocean-tech-canvas') as HTMLCanvasElement | null;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !reduceMotion) {
    const surface = canvas;
    const ctx = surface.getContext('2d');
    let animationFrameId = 0;
    let width = 0;
    let height = 0;
    let dpr = 1;
    let running = true;
    let mouse = { x: -2000, y: -2000 };
    let tick = 0;

    interface Node {
      x: number;
      y: number;
      vx: number;
      vy: number;
      baseSize: number;
      alpha: number;
      phase: number;
      pulseSpeed: number;
      depthLayer: number; // 1: Shallow, 2: Mid-water, 3: Seabed
    }

    const nodes: Node[] = [];

    function resizeCanvas() {
      width = window.innerWidth;
      height = window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      surface.width = Math.round(width * dpr);
      surface.height = Math.round(height * dpr);
      surface.style.width = `${width}px`;
      surface.style.height = `${height}px`;
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);

      const targetCount = Math.min(width < 768 ? 26 : 56, Math.max(20, Math.floor((width * height) / 30000)));
      while (nodes.length < targetCount) {
        nodes.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.32,
          vy: (Math.random() - 0.5) * 0.32,
          baseSize: Math.random() * 1.6 + 0.8,
          alpha: Math.random() * 0.35 + 0.15,
          phase: Math.random() * Math.PI * 2,
          pulseSpeed: Math.random() * 0.02 + 0.008,
          depthLayer: Math.floor(Math.random() * 3) + 1
        });
      }
      nodes.splice(targetCount);
    }

    function draw() {
      if (!ctx || !running) return;
      ctx.clearRect(0, 0, width, height);
      tick += 0.015;

      // Draw subtle pulsing sonar range rings from center
      const centerX = width * 0.68;
      const centerY = height * 0.42;
      const maxRingRadius = Math.min(width, height) * 0.65;
      
      for (let r = 0; r < 3; r++) {
        const ringProgress = ((tick * 0.25 + r / 3) % 1);
        const radius = ringProgress * maxRingRadius;
        const ringAlpha = Math.sin(ringProgress * Math.PI) * 0.08;
        
        ctx.beginPath();
        ctx.arc(centerX, centerY, radius, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(0, 240, 255, ${ringAlpha})`;
        ctx.lineWidth = 0.8;
        ctx.setLineDash([4, 8]);
        ctx.stroke();
        ctx.setLineDash([]);
      }

      // Inter-node telemetry connections
      const maxDistance = width < 768 ? 110 : 145;
      for (let i = 0; i < nodes.length; i += 1) {
        for (let j = i + 1; j < nodes.length; j += 1) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const distanceSquared = dx * dx + dy * dy;
          if (distanceSquared < maxDistance * maxDistance) {
            const distance = Math.sqrt(distanceSquared);
            const lineAlpha = (1 - distance / maxDistance) * 0.16;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            
            // Color based on depth
            if (nodes[i].depthLayer === 3 || nodes[j].depthLayer === 3) {
              ctx.strokeStyle = `rgba(16, 185, 129, ${lineAlpha})`; // Emerald for seabed
            } else {
              ctx.strokeStyle = `rgba(0, 240, 255, ${lineAlpha})`; // Cyan for water column
            }
            ctx.lineWidth = 0.75;
            ctx.stroke();
          }
        }
      }

      // Draw and update sensor nodes
      nodes.forEach((node) => {
        node.x += node.vx;
        node.y += node.vy;
        node.phase += node.pulseSpeed;

        if (node.x < -10) node.x = width + 10;
        if (node.x > width + 10) node.x = -10;
        if (node.y < -10) node.y = height + 10;
        if (node.y > height + 10) node.y = -10;

        // Interactive mouse gravity / avoidance
        if (width >= 768) {
          const dx = node.x - mouse.x;
          const dy = node.y - mouse.y;
          const distanceSquared = dx * dx + dy * dy;
          if (distanceSquared > 0 && distanceSquared < 130 * 130) {
            const distance = Math.sqrt(distanceSquared);
            node.x += (dx / distance) * 0.55;
            node.y += (dy / distance) * 0.55;
          }
        }

        const currentAlpha = Math.max(0.1, node.alpha + Math.sin(node.phase) * 0.12);
        const currentSize = node.baseSize + Math.sin(node.phase) * 0.3;

        ctx.beginPath();
        ctx.arc(node.x, node.y, currentSize, 0, Math.PI * 2);
        if (node.depthLayer === 3) {
          ctx.fillStyle = `rgba(16, 185, 129, ${currentAlpha})`;
        } else if (node.depthLayer === 2) {
          ctx.fillStyle = `rgba(56, 189, 248, ${currentAlpha})`;
        } else {
          ctx.fillStyle = `rgba(0, 240, 255, ${currentAlpha})`;
        }
        ctx.fill();

        // Occasional hydrophone pulse halo
        if (Math.sin(node.phase) > 0.85) {
          ctx.beginPath();
          ctx.arc(node.x, node.y, currentSize * 2.8, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(0, 240, 255, ${currentAlpha * 0.35})`;
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      });

      animationFrameId = requestAnimationFrame(draw);
    }

    function start() {
      if (running && !animationFrameId) animationFrameId = requestAnimationFrame(draw);
    }

    function stop() {
      cancelAnimationFrame(animationFrameId);
      animationFrameId = 0;
    }

    resizeCanvas();
    start();

    window.addEventListener('resize', resizeCanvas, { passive: true });
    window.addEventListener('mousemove', (event) => {
      mouse = { x: event.clientX, y: event.clientY };
    }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      running = !document.hidden;
      if (running) start(); else stop();
    });

    document.addEventListener('astro:before-swap', () => {
      running = false;
      stop();
    });
  }
</script>
