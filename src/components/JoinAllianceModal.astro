---
// Join Alliance & Collaborative Research Onboarding Modal Component
---

<div
  id="alliance-modal"
  class="fixed inset-0 z-[150] hidden bg-black/85 backdrop-blur-2xl flex items-center justify-center p-4 sm:p-6 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="alliance-modal-title"
>
  <div class="w-full max-w-3xl bg-[#060D1F] border border-cyan-500/30 rounded-3xl shadow-[0_25px_70px_rgba(0,240,255,0.15)] overflow-hidden my-auto relative">
    <!-- Modal Ambient Glow Top Border -->
    <div class="h-1 w-full bg-gradient-to-r from-cyan-500 via-sky-400 to-blue-600"></div>

    <!-- Modal Header -->
    <div class="p-6 sm:p-8 border-b border-white/10 flex items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
          <span class="text-[11px] font-mono font-bold uppercase tracking-[0.2em] text-cyan-300">
            Green Marine Technology Alliance
          </span>
        </div>
        <h2 id="alliance-modal-title" class="text-2xl sm:text-3xl font-black text-white font-display">
          Join the Collaborative Network
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 font-light mt-1 max-w-xl">
          Partner with OceanHub to co-develop next-generation green offshore engineering technologies and launch high-impact Joint Industry Projects (JIPs).
        </p>
      </div>

      <button
        id="alliance-modal-close"
        type="button"
        class="p-2.5 rounded-2xl bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white transition-all shrink-0"
        aria-label="Close modal"
      >
        <i class="fa-solid fa-xmark text-lg" aria-hidden="true"></i>
      </button>
    </div>

    <!-- Multi-Step Content Area -->
    <div class="p-6 sm:p-8 space-y-7">
      <!-- Step 1: Partner Role / Track -->
      <div>
        <label class="block text-xs font-mono font-bold text-cyan-300 uppercase tracking-wider mb-3">
          1. Select Your Collaboration Track
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="alliance-track-grid">
          <button
            type="button"
            class="alliance-track-btn active text-left p-4 rounded-2xl border border-cyan-400/50 bg-cyan-950/40 hover:bg-cyan-900/40 transition-all group"
            data-track="operator"
          >
            <div class="flex items-center justify-between mb-1.5">
              <span class="font-bold text-white group-hover:text-cyan-300 text-sm">Asset Operator / Developer</span>
              <i class="fa-solid fa-circle-check text-cyan-400 text-sm" aria-hidden="true"></i>
            </div>
            <div class="text-xs text-slate-400 font-light">Offshore wind, CCUS, or subsea asset owners seeking technical risk reduction and green pilot validation.</div>
          </button>

          <button
            type="button"
            class="alliance-track-btn text-left p-4 rounded-2xl border border-white/10 bg-slate-900/50 hover:border-cyan-500/30 hover:bg-cyan-950/30 transition-all group"
            data-track="technology"
          >
            <div class="flex items-center justify-between mb-1.5">
              <span class="font-bold text-white group-hover:text-cyan-300 text-sm">Geophysical & Geotech Fleet</span>
              <i class="fa-regular fa-circle text-slate-500 text-sm" aria-hidden="true"></i>
            </div>
            <div class="text-xs text-slate-400 font-light">Survey vessels, CPTu operators, and sensor manufacturers contributing high-precision marine data.</div>
          </button>

          <button
            type="button"
            class="alliance-track-btn text-left p-4 rounded-2xl border border-white/10 bg-slate-900/50 hover:border-cyan-500/30 hover:bg-cyan-950/30 transition-all group"
            data-track="academic"
          >
            <div class="flex items-center justify-between mb-1.5">
              <span class="font-bold text-white group-hover:text-cyan-300 text-sm">Academic & Research Institute</span>
              <i class="fa-regular fa-circle text-slate-500 text-sm" aria-hidden="true"></i>
            </div>
            <div class="text-xs text-slate-400 font-light">Universities and labs validating acoustic models, geomechanical simulations, and ecological eDNA.</div>
          </button>

          <button
            type="button"
            class="alliance-track-btn text-left p-4 rounded-2xl border border-white/10 bg-slate-900/50 hover:border-cyan-500/30 hover:bg-cyan-950/30 transition-all group"
            data-track="epci"
          >
            <div class="flex items-center justify-between mb-1.5">
              <span class="font-bold text-white group-hover:text-cyan-300 text-sm">EPCI Contractor / Engineering Firm</span>
              <i class="fa-regular fa-circle text-slate-500 text-sm" aria-hidden="true"></i>
            </div>
            <div class="text-xs text-slate-400 font-light">Installation contractors, marine warranty surveyors, and engineering designers executing offshore works.</div>
          </button>
        </div>
      </div>

      <!-- Step 2: Joint Project (JIP) Area of Interest -->
      <div>
        <label class="block text-xs font-mono font-bold text-cyan-300 uppercase tracking-wider mb-3">
          2. Target Joint Industry Projects (JIPs)
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="alliance-jip-checkboxes">
          <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-white/5 border border-white/10 hover:border-cyan-400/40 cursor-pointer transition-all">
            <input type="checkbox" class="jip-checkbox mt-1 accent-cyan-400" value="CCUS-4D-DAS" checked />
            <div>
              <div class="text-xs font-bold text-white">4D Fiber DAS & Storage MRV JIP</div>
              <div class="text-[11px] text-slate-400">Long-term CO₂ plume migration & optical telemetry</div>
            </div>
          </label>

          <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-white/5 border border-white/10 hover:border-cyan-400/40 cursor-pointer transition-all">
            <input type="checkbox" class="jip-checkbox mt-1 accent-cyan-400" value="Floating-Wind-Anchors" checked />
            <div>
              <div class="text-xs font-bold text-white">Floating Wind Foundation JIP</div>
              <div class="text-[11px] text-slate-400">Suction anchors & cyclic soil mechanics in deep water</div>
            </div>
          </label>

          <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-white/5 border border-white/10 hover:border-cyan-400/40 cursor-pointer transition-all">
            <input type="checkbox" class="jip-checkbox mt-1 accent-cyan-400" value="Acoustic-Bubble-Damping" />
            <div>
              <div class="text-xs font-bold text-white">Low-Impact Acoustic JIP</div>
              <div class="text-[11px] text-slate-400">Active noise reduction & real-time PAM monitoring</div>
            </div>
          </label>

          <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-white/5 border border-white/10 hover:border-cyan-400/40 cursor-pointer transition-all">
            <input type="checkbox" class="jip-checkbox mt-1 accent-cyan-400" value="Subsea-Green-Corridor" />
            <div>
              <div class="text-xs font-bold text-white">Subsea Green Energy Corridor JIP</div>
              <div class="text-[11px] text-slate-400">Cable scour stability & autonomous USV inspection</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Step 3: Organization & Contact -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="alliance-org-name" class="block text-xs font-mono text-slate-300 mb-1.5">Organization / Enterprise *</label>
          <input
            id="alliance-org-name"
            type="text"
            placeholder="e.g. Offshore Energy Corp / University Lab"
            class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-white/10 focus:border-cyan-400 text-white text-xs focus:outline-none transition-all"
            required
          />
        </div>
        <div>
          <label for="alliance-email" class="block text-xs font-mono text-slate-300 mb-1.5">Representative Email *</label>
          <input
            id="alliance-email"
            type="email"
            placeholder="e.g. tech-director@organization.com"
            class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-white/10 focus:border-cyan-400 text-white text-xs focus:outline-none transition-all"
            required
          />
        </div>
      </div>

      <!-- Step 4: Proposed Resources & Capabilities -->
      <div>
        <label for="alliance-notes" class="block text-xs font-mono text-slate-300 mb-1.5">
          Key Capabilities or Proposed Contribution (Optional)
        </label>
        <textarea
          id="alliance-notes"
          rows="2"
          placeholder="Describe your vessels, laboratory testing capabilities, target offshore concessions, or specific technical questions..."
          class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-white/10 focus:border-cyan-400 text-white text-xs focus:outline-none transition-all"
        ></textarea>
      </div>
    </div>

    <!-- Modal Footer Actions -->
    <div class="p-6 sm:p-8 bg-black/40 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-[11px] font-mono text-slate-400 flex items-center gap-2">
        <i class="fa-solid fa-shield-halved text-cyan-400" aria-hidden="true"></i>
        <span>Non-binding preliminary expression of interest</span>
      </div>

      <div class="flex items-center gap-3 w-full sm:w-auto">
        <button
          id="alliance-copy-draft-btn"
          type="button"
          class="px-5 py-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white text-xs font-mono font-bold uppercase tracking-wider transition-all"
        >
          <i class="fa-regular fa-copy mr-1.5" aria-hidden="true"></i>
          <span>Copy Draft</span>
        </button>

        <button
          id="alliance-submit-btn"
          type="button"
          class="flex-1 sm:flex-initial px-8 py-3 rounded-xl bg-gradient-to-r from-cyan-400 via-sky-400 to-blue-600 hover:from-cyan-300 hover:to-blue-500 text-slate-950 font-black text-xs font-mono uppercase tracking-[0.14em] transition-all shadow-[0_0_25px_rgba(0,240,255,0.3)]"
        >
          <span>Transmit Proposal →</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Alliance Modal Interactivity & Draft Proposal Generator
  const modal = document.getElementById('alliance-modal');
  const closeBtn = document.getElementById('alliance-modal-close');
  const trackButtons = document.querySelectorAll('.alliance-track-btn');
  const copyDraftBtn = document.getElementById('alliance-copy-draft-btn');
  const submitBtn = document.getElementById('alliance-submit-btn');
  const orgInput = document.getElementById('alliance-org-name') as HTMLInputElement | null;
  const emailInput = document.getElementById('alliance-email') as HTMLInputElement | null;
  const notesInput = document.getElementById('alliance-notes') as HTMLTextAreaElement | null;

  let selectedTrack = 'operator';

  // Toggle Tracks
  trackButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      trackButtons.forEach((b) => {
        b.classList.remove('active', 'border-cyan-400/50', 'bg-cyan-950/40');
        b.classList.add('border-white/10', 'bg-slate-900/50');
        const icon = b.querySelector('i');
        if (icon) {
          icon.className = 'fa-regular fa-circle text-slate-500 text-sm';
        }
      });
      btn.classList.add('active', 'border-cyan-400/50', 'bg-cyan-950/40');
      btn.classList.remove('border-white/10', 'bg-slate-900/50');
      const activeIcon = btn.querySelector('i');
      if (activeIcon) {
        activeIcon.className = 'fa-solid fa-circle-check text-cyan-400 text-sm';
      }
      selectedTrack = btn.getAttribute('data-track') || 'operator';
    });
  });

  function getSelectedJIPs(): string[] {
    const checked = document.querySelectorAll<HTMLInputElement>('.jip-checkbox:checked');
    return Array.from(checked).map((c) => c.value);
  }

  function generateProposalPayload() {
    const org = orgInput?.value.trim() || 'Undisclosed Organization';
    const email = emailInput?.value.trim() || 'contact@partner.org';
    const notes = notesInput?.value.trim() || 'Exploring technical co-development & pilot participation.';
    const jips = getSelectedJIPs().join(', ') || 'General Green Offshore Exploration';

    const subject = encodeURIComponent(`[OceanHub Alliance] Partnership Proposal - ${org}`);
    const body = encodeURIComponent(
`Dear OceanHub Technical Alliance Committee,

We are expressing interest in joining the Green Offshore Technology Alliance.

--- PARTNERSHIP DETAILS ---
• Organization: ${org}
• Contact Email: ${email}
• Collaboration Track: ${selectedTrack.toUpperCase()}
• Target JIPs: ${jips}

--- TECHNICAL CAPABILITIES & NOTES ---
${notes}

We look forward to connecting on joint technical protocols and field trial opportunities.

Kind regards,
${org}`
    );

    return { org, email, notes, jips, subject, body };
  }

  // Open / Close Global Hooks
  function openAllianceModal() {
    modal?.classList.remove('hidden');
    orgInput?.focus();
  }

  function closeAllianceModal() {
    modal?.classList.add('hidden');
  }

  closeBtn?.addEventListener('click', closeAllianceModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeAllianceModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeAllianceModal();
    }
  });

  // Copy Draft Action
  copyDraftBtn?.addEventListener('click', () => {
    const payload = generateProposalPayload();
    const plainText = `OceanHub Alliance Partnership Expression of Interest\n\nOrganization: ${payload.org}\nEmail: ${payload.email}\nTrack: ${selectedTrack}\nTarget JIPs: ${payload.jips}\n\nNotes:\n${payload.notes}`;
    navigator.clipboard.writeText(plainText).then(() => {
      const original = copyDraftBtn.innerHTML;
      copyDraftBtn.innerHTML = '<i class="fa-solid fa-check mr-1.5 text-emerald-400"></i><span>Copied!</span>';
      setTimeout(() => {
        copyDraftBtn.innerHTML = original;
      }, 2500);
    });
  });

  // Submit via Mailto Direct Dispatch
  submitBtn?.addEventListener('click', () => {
    const payload = generateProposalPayload();
    const mailtoUrl = `mailto:info@oceanhub.com?subject=${payload.subject}&body=${payload.body}`;
    window.location.href = mailtoUrl;
    closeAllianceModal();
  });

  // Expose global trigger for any button on the page
  window.addEventListener('oceanhub:open-alliance-modal', openAllianceModal);
  document.querySelectorAll('[data-open-alliance-modal]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openAllianceModal();
    });
  });
</script>
